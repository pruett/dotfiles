.DS_Store
.netrwhist
!home/.config/zsh/plugins/*
Brewfile.lock.json
lazy-lock.json
home/.gitconfig.local
deno/.deno/bin/*
home/.config/zsh/extras/.zshrc.local.zsh

home/.config/cloudflared/token.local

artifacts/

# The fleet's state is a real folder at ~/.local/state/fleet (`fleet init`), never
# linked from here. Keeps any leftover copy (the old cos state) untracked.
home/.local/state/

# Installed at runtime by skill scripts (e.g. pstack watch-pr bootstrap)
home/.agents/skills/*/scripts/node_modules/
