.DS_Store
.netrwhist
!home/.config/zsh/plugins/*
Brewfile.lock.json
lazy-lock.json
home/.gitconfig.local
deno/.deno/bin/*
home/.config/zsh/extras/.zshrc.local.zsh

home/.config/cloudflared/token.local

artifacts/

# Machine state (the fleet's in state/fleet, linked whole to ~/.local/state/fleet by
# dot) lives here but is never committed, except the fleet's two example files.
home/.local/state/*
!home/.local/state/fleet/
home/.local/state/fleet/*
!home/.local/state/fleet/config.env.example
!home/.local/state/fleet/playbook.md.example

# Installed at runtime by skill scripts (e.g. pstack watch-pr bootstrap)
home/.agents/skills/*/scripts/node_modules/
