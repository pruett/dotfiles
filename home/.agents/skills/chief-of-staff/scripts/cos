#!/usr/bin/env node
// cos: the Chief of Staff org's shared state and launcher on Herdr. `cos --help` prints DOC.
"use strict";
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const crypto = require("node:crypto");
const readline = require("node:readline/promises");
const { spawnSync } = require("node:child_process");

const DOC = `cos: the Chief of Staff org's shared state and launcher on Herdr.

You talk only to the Chief of Staff (CoS). The CoS runs one lead per project; each
lead runs short-lived workers. Anything that needs your judgment is a queue item,
answered in the Chief of Staff panel (Queue tab) beside the CoS. This CLI is the one way agents and
the panel touch that shared state, so its file layout stays consistent:

  $COS_HOME (default ~/.local/state/cos)
    config.env                   this machine's settings (\`cos init\` asks for them)
    projects/<p>/project.json    name, repo, lead terminal name, space label
    projects/<p>/plan.md         goal, current plan, what is stuck
    projects/<p>/decisions.md    dated decisions, newest last
    inbox/<id>.json              a message for the CoS: a lead's report, your panel answer,
                                 a lead that stopped; inbox/done/ once the CoS handled it
    queue/<id>.json              one item waiting for (or answered by) you
    queue/<id>/                  its attachments: screenshots, videos, notes

Your standing rules, learned by the CoS from your answers, are the skill's brain.md
(part of the CoS's system prompt), not state.

Terminals (hc names): the CoS is \`cos\`; a project's lead is \`lead-<p>\`.
Nothing types into the CoS's pane, which is yours: leads report with \`cos report\`,
your panel answers go through \`cos answer\`, and both land in the inbox. The CoS keeps
\`cos inbox --wait\` running in the background, which also notices a lead that is
blocked or has stopped. The CoS talks to leads with plain \`hc send\`.

Every agent is one of the roles in the skill's roles.json: its program, model and the
files that become its system prompt (the CoS: its SKILL.md and SKILL.local.md; a lead:
project-lead's; a worker: worker.md). \`cos up\` starts the CoS, \`cos lead start\` a lead,
and a lead starts its workers with \`cos run\`; all three go through \`cos exec <role>\`,
which puts this machine's settings in the agent's environment: $COS_WORK_ROOT, and
CLAUDE_CONFIG_DIR from COS_CLAUDE_CONFIG_DIR.

stdout carries data (ids, paths, JSON with --json); progress goes to stderr.
Exit 0 ok, 1 a step failed, 2 bad usage or a missing precondition.`;

const expand = (p) => {
  const s = p.replace(/^~(?=$|\/)/, os.homedir());
  return s.length > 1 ? path.normalize(s).replace(/\/+$/, "") : s;
};

const HOME = process.env.COS_HOME ? expand(process.env.COS_HOME) : path.join(os.homedir(), ".local/state/cos");
const COS = "cos"; // the CoS terminal's hc name
const HQ_SPACE = "cos-hq"; // herdr.space label for the CoS's space
const PRIORITIES = ["p0", "p1", "p2", "p3"];
const KINDS = ["decision", "review", "approval", "fyi", "idea"];
const REPORT_KINDS = ["done", "stuck", "decision", "fyi"]; // what a lead's `cos report` says
const VERDICTS = ["approve", "changes", "feedback", "choose", "reject"];
const NAME_RE = /^[a-z0-9][a-z0-9-]{0,26}$/; // lead-<name> must fit hc's 32-character names

// This machine's settings, kept in $COS_HOME/config.env: name -> [what it is, suggested value].
const SETTINGS = {
  COS_WORK_ROOT: ["the folder your repos live under (one folder per company or group)", "~/work"],
  COS_CLAUDE_CONFIG_DIR: ["the Claude Code config folder agents start with (CLAUDE_CONFIG_DIR)", "~/.claude"],
};

class Fail extends Error {
  constructor(msg, code = 1) {
    super(msg);
    this.code = code;
  }
}

const log = (msg) => process.stderr.write(msg + "\n");
const out = (msg) => process.stdout.write(msg + "\n");
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const exists = (p) => fs.existsSync(p);
const pad = (s, n) => String(s ?? "").padEnd(n);
const round4 = (x) => Math.round(x * 1e4) / 1e4;
const hex2 = () => crypto.randomBytes(2).toString("hex");

function stamp(fmt) {
  const d = new Date(), z = (n) => String(n).padStart(2, "0");
  return fmt.replace(/%([YmdHMS])/g, (_, c) =>
    ({ Y: d.getFullYear(), m: z(d.getMonth() + 1), d: z(d.getDate()), H: z(d.getHours()), M: z(d.getMinutes()), S: z(d.getSeconds()) })[c]);
}

function now() {
  const off = -new Date().getTimezoneOffset(), z = (n) => String(n).padStart(2, "0");
  return stamp("%Y-%m-%dT%H:%M:%S") + (off >= 0 ? "+" : "-") + z(Math.floor(Math.abs(off) / 60)) + ":" + z(Math.abs(off) % 60);
}

const readJson = (p) => JSON.parse(fs.readFileSync(p, "utf8"));

function writeJson(p, data) {
  const tmp = p + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n");
  fs.renameSync(tmp, p); // atomic, so the panel never reads half a file
}

function run(prog, args, check) {
  const r = spawnSync(prog, args, { encoding: "utf8" });
  if (r.error) r.status = 127, r.stderr = String(r.error.message);
  r.stdout ??= "", r.stderr ??= "";
  if (check && r.status !== 0)
    throw new Fail(`${prog} ${args.slice(0, 2).join(" ")} failed: ${(r.stderr || r.stdout).trim()}`);
  return r;
}
const hc = (args, check = true) => run("hc", args, check);
const app = (args, check = true) => run("herdr-app", args, check);

function hcJson(...args) {
  const r = hc([...args, "--json"], false);
  if (r.status !== 0) return null;
  try { return JSON.parse(r.stdout); } catch { return null; }
}

// A terminal's status as one word: `hc get` gives {app, state}, `hc ls` a plain word.
function word(t) {
  if (!t) return "stopped";
  let st = t.status;
  if (st && typeof st === "object") st = st.state;
  return st || "live";
}

// The terminal record for a live terminal with this hc name, else null.
function live(name) {
  const t = hcJson("get", name);
  return t && t.state === "live" ? t : null;
}

function ensureHome() {
  for (const sub of ["projects", "queue"]) fs.mkdirSync(path.join(HOME, sub), { recursive: true });
}

// This machine's settings from config.env, values with ~ expanded.
function config() {
  const cfg = {}, f = path.join(HOME, "config.env");
  for (const line of exists(f) ? fs.readFileSync(f, "utf8").split("\n") : []) {
    const i = line.indexOf("=");
    if (i >= 0 && line.slice(0, i).trim() in SETTINGS) cfg[line.slice(0, i).trim()] = expand(line.slice(i + 1).trim());
  }
  return cfg;
}

function saveConfig(cfg) {
  const lines = Object.entries(SETTINGS).filter(([k]) => k in cfg).map(([k, [desc]]) => `# ${desc}\n${k}=${cfg[k]}`);
  fs.writeFileSync(path.join(HOME, "config.env"), lines.join("\n") + "\n");
}

// Every setting, asking in a terminal for the missing ones (all of them with askAll).
async function requireConfig(askAll = false) {
  ensureHome();
  const cfg = config();
  const todo = Object.keys(SETTINGS).filter((k) => askAll || !(k in cfg));
  if (!todo.length) return cfg;
  if (!process.stdin.isTTY)
    throw new Fail(`this machine is not set up: ${todo.join(", ")} missing. ` +
      "Run `cos init` in a terminal, or `cos config <NAME> <value>` for each.", 2);
  log(`Setting up the Chief of Staff on this machine (${path.join(HOME, "config.env")}). Press enter to keep the suggestion.`);
  const rl = readline.createInterface({ input: process.stdin, output: process.stderr });
  try {
    for (const k of todo) {
      const [desc, def] = SETTINGS[k], current = cfg[k] ?? def;
      const answer = (await rl.question(`${k}: ${desc} [${current}]: `)).trim();
      cfg[k] = expand(answer || current);
      if (!isDir(cfg[k])) log(`  note: ${cfg[k]} is not a folder yet.`);
    }
  } finally {
    rl.close();
  }
  saveConfig(cfg);
  return cfg;
}

function isDir(p) {
  try { return fs.statSync(p).isDirectory(); } catch { return false; }
}

function projectDir(name) {
  const d = path.join(HOME, "projects", name);
  if (!exists(path.join(d, "project.json")))
    throw new Fail(`no project '${name}'; add it with: cos project add ${name} --repo <path>`, 2);
  return d;
}

function projects() {
  const dir = path.join(HOME, "projects");
  if (!isDir(dir)) return [];
  return fs.readdirSync(dir).sort()
    .map((n) => path.join(dir, n, "project.json")).filter(exists).map(readJson);
}

function items(includeClosed = false) {
  const dir = path.join(HOME, "queue"), list = [];
  for (const f of isDir(dir) ? fs.readdirSync(dir) : []) {
    if (!f.endsWith(".json")) continue;
    let it;
    try { it = readJson(path.join(dir, f)); } catch { continue; }
    if (includeClosed || it.status !== "closed") list.push(it);
  }
  // Open first, then priority, then oldest first.
  const order = { open: 0, answered: 1, closed: 2 };
  const key = (i) => [order[i.status] ?? 3, i.priority ?? "p2", i.created ?? ""];
  return list.sort((a, b) => {
    const [x, y] = [key(a), key(b)];
    for (let n = 0; n < 3; n++) if (x[n] !== y[n]) return x[n] < y[n] ? -1 : 1;
    return 0;
  });
}

function itemPath(id) {
  const p = path.join(HOME, "queue", `${id}.json`);
  if (!exists(p)) throw new Fail(`no queue item '${id}'`, 2);
  return p;
}

// The Herdr space id a terminal labelled herdr.space=<label> landed in, if Herdr kept the label as its id.
function findSpace(label) {
  const r = app(["ls"], false);
  if (r.status !== 0) return null;
  try { return (JSON.parse(r.stdout).spaces || []).find((s) => s.id === label) || null; } catch { return null; }
}

// Start a role as `cos exec <role> <task>` in an hc terminal; the task is the agent's first
// prompt, so nothing is typed into it. parent: "child" (ends with the caller), "outlive"
// (a lead: outlives the CoS's restarts) or "none" (the CoS). hc types no notes about it
// into its parent: `cos inbox --wait` watches leads, and leads wait on their workers.
function launch({ role, name, cwd, task, space, labels = [], parent = "child", keep = false }) {
  const args = ["run", "--bg", "--json", "--no-notify", "--name", name, "--cwd", cwd,
    "--label", `cos.role=${role === "chief-of-staff" ? COS : role}`]; // my-spaces finds HQ by cos.role=cos
  if (keep) args.push("--keep");
  if (space) args.push("--label", `herdr.space=${space}`);
  for (const lab of labels) args.push("--label", lab);
  if (parent === "outlive") args.push("--outlive-parent");
  if (parent === "none") args.push("--no-parent");
  args.push("--", SELF, "exec", role, task);
  hc(args);
  settle(name, cwd);
}

// Wait until the agent reports a status. Claude asks before working in a folder it has
// not seen; accept that once, and it then starts on its task.
function settle(name, cwd) {
  for (let i = 0; i < 40; i++) {
    const st = word(live(name));
    if (!["live", "stopped"].includes(st)) return;
    const screen = hc(["read", name, "--lines", "0"], false).stdout;
    if (screen.includes("trust this folder")) {
      log(`${name}: accepting Claude's trust prompt for ${cwd}.`);
      const chosen = screen.split("\n").find((l) => l.includes("❯")) || "";
      hc(["keys", name, ...(chosen.includes("Yes") ? [] : ["down"]), "enter"]);
    }
    spawnSync("sleep", ["0.5"]);
  }
  log(`${name}: started, but has reported no status after 20 seconds. Look with \`hc read ${name}\`.`);
}

// ---- commands ---------------------------------------------------------------

async function cmdInit(a) {
  await requireConfig(a.reset);
  for (const [role, f] of Object.entries(LOCAL_NOTES)) {
    if (!exists(f)) {
      fs.writeFileSync(f, LOCAL_SEED.replace("{role}", role));
      log(`Wrote ${f}: fill in this machine's notes (or ask the CoS to).`);
    }
  }
  out(HOME);
}

function cmdConfig(a) {
  const cfg = config();
  if (a.name && !(a.name in SETTINGS))
    throw new Fail(`unknown setting ${a.name}; settings: ${Object.keys(SETTINGS).join(", ")}`, 2);
  if (a.value != null) {
    ensureHome();
    cfg[a.name] = expand(a.value);
    saveConfig(cfg);
  }
  for (const k of a.name ? [a.name] : Object.keys(SETTINGS)) out(`${k}=${cfg[k] ?? ""}`);
}

// Where this script really lives (~/.local/bin/cos is a link to it), and the skill around it.
const SELF = fs.realpathSync(__filename);
const SKILL_DIR = path.dirname(path.dirname(SELF));
const SKILLS_DIR = path.dirname(SKILL_DIR);
// Each role's program, model and system prompt files, kept in the skill's roles.json.
const ROLES_FILE = path.join(SKILL_DIR, "roles.json");
// Roles started by their own command rather than `cos run`.
const OWN_COMMAND = { "chief-of-staff": "cos up", lead: "cos lead start <project>" };

// This machine's notes for a role, beside its skill and gitignored (`cos init` seeds them): role -> file.
const LOCAL_NOTES = {
  "chief-of-staff": path.join(SKILLS_DIR, "chief-of-staff/SKILL.local.md"),
  lead: path.join(SKILLS_DIR, "project-lead/SKILL.local.md"),
};
const LOCAL_SEED = `# This machine (SKILL.local.md)

Notes for this computer only, appended to the {role}'s system prompt by \`cos exec\`.
Not committed. Replace each "(not set)" with the answer, or "none".

## Accounts per company
(not set) Which Claude, Devin (\`devin-as <account>\`) and Codex login each company's work uses.

## Companies and repos
(not set) Which companies' repos are cloned here, beyond what $COS_WORK_ROOT/AGENTS.md says.

## Other machines
(not set) Machines leads may run on (\`hc run --on <machine>\`), and what each is for.

## Tools
(not set) Which of wt, gh (logged in), herdr-app and devin are installed, and gaps to work around.

## Reaching the CEO
(not set) Working hours, and what may wait until then.
`;

function roles() {
  try {
    const rs = readJson(ROLES_FILE).roles;
    if (!rs) throw new Error("no roles");
    return rs;
  } catch (e) {
    throw new Fail(`cannot read roles from ${ROLES_FILE}: ${e.message}`);
  }
}

function role(name) {
  const rs = roles();
  if (!(name in rs)) throw new Fail(`unknown role ${name}; roles: ${Object.keys(rs).join(", ")} (${ROLES_FILE})`, 2);
  return rs[name];
}

// A role's system prompt: its name, then its prompt files without their frontmatter.
function rolePrompt(name, r) {
  const parts = [`Your role in the Chief of Staff org: ${name}.`];
  for (const rel of r.prompt || []) {
    const f = path.join(SKILLS_DIR, rel);
    if (exists(f)) parts.push(fs.readFileSync(f, "utf8").replace(/^---\n[\s\S]*?\n---\n/, "").trim());
  }
  return parts.join("\n\n");
}

// The executable's full path, as execvp would find it on $PATH.
function which(prog) {
  if (prog.includes("/")) return prog;
  for (const dir of (process.env.PATH || "").split(":")) {
    const p = path.join(dir || ".", prog);
    try { fs.accessSync(p, fs.constants.X_OK); if (!isDir(p)) return p; } catch {}
  }
  throw new Fail(`${prog} is not on PATH`);
}

// Start a role's program and model, its system prompt and this machine's settings; the
// last argument, when it is not a flag, is its first prompt. Claude takes the role's prompt
// as an appended system prompt; any other program gets it ahead of the first prompt.
async function cmdExec(a) {
  const r = role(a.role);
  const cfg = await requireConfig();
  const env = { ...process.env, COS_WORK_ROOT: cfg.COS_WORK_ROOT, CLAUDE_CONFIG_DIR: cfg.COS_CLAUDE_CONFIG_DIR };
  const argv = [r.run, ...(r.args || [])], extra = [...a.extra], prompt = rolePrompt(a.role, r);
  if (r.run === "claude") argv.push("--append-system-prompt", prompt);
  else if (extra.length && !extra.at(-1).startsWith("-")) extra.push(`${prompt}\n\n---\n\n${extra.pop()}`);
  else extra.push(prompt);
  argv.push(...extra);
  process.execve(which(argv[0]), argv, env);
}

function cmdRoles(a) {
  const rs = roles();
  if (a.json) return out(JSON.stringify(rs, null, 2));
  for (const [name, r] of Object.entries(rs))
    out(`${pad(name, 15)} ${r.run} ${(r.args || []).join(" ")}\n${" ".repeat(16)}prompt: ${(r.prompt || []).join(", ") || "none"}`);
}

// A lead starts a worker: `cos run implementer api-impl-x --cwd <worktree> "<brief>"`.
function cmdRun(a) {
  role(a.role);
  if (OWN_COMMAND[a.role]) throw new Fail(`start the ${a.role} with \`${OWN_COMMAND[a.role]}\``, 2);
  if (a.name.length > 32) throw new Fail("hc names are at most 32 characters", 2);
  const me = process.env.HC_TERMINAL_ID;
  const project = ((me && hcJson("get", me)) || {}).labels?.["cos.project"];
  launch({ role: a.role, name: a.name, cwd: path.resolve(expand(a.cwd || ".")), task: a.task,
    labels: project ? [`cos.project=${project}`] : [] });
  out(a.name);
}

// Open HQ: start the CoS in its own space with the Chief of Staff panel beside it. Safe to rerun.
async function cmdUp() {
  await requireConfig();
  if (live(COS)) log("CoS is already running as `cos`.");
  else {
    launch({ role: "chief-of-staff", name: COS, cwd: fs.realpathSync(HOME), task: "Start your shift.",
      space: HQ_SPACE, parent: "none", keep: true });
    log("Started the CoS as `cos`.");
  }
  if (!findSpace(HQ_SPACE)) {
    log("The Herdr window is not open, so HQ is not shown; the CoS runs anyway. Rerun `cos up` with Herdr open.");
    return out(COS);
  }
  app(["do", "space.rename", "--id", HQ_SPACE, "--name", "HQ"], false);
  app(["do", "space.select", "--id", HQ_SPACE], false);
  // The Chief of Staff panel (Queue + Fleet) is a side-panel child (layouts/cos.json), next to Files and Changes.
  app(["do", "layout.switch", JSON.stringify({ name: "cos" })], false);
  app(["do", "layout.select", JSON.stringify({ stack: "panel-body", child: "cos" })], false);
  app(["do", "layout.show", JSON.stringify({ id: "panel" })], false);
  out(COS);
}

function cmdProjectAdd(a) {
  ensureHome();
  if (!NAME_RE.test(a.name)) throw new Fail("project names are 1-27 of a-z 0-9 -, starting with a letter or digit", 2);
  let repo = path.resolve(expand(a.repo));
  try { repo = fs.realpathSync(repo); } catch {}
  if (!isDir(repo)) throw new Fail(`${repo} is not a folder`, 2);
  const d = path.join(HOME, "projects", a.name);
  fs.mkdirSync(d, { recursive: true });
  let meta = { name: a.name, repo, lead: `lead-${a.name}`, space: `cos-${a.name}`, created: now() };
  const pj = path.join(d, "project.json");
  if (exists(pj)) meta = { ...meta, ...readJson(pj), repo };
  writeJson(pj, meta);
  const plan = path.join(d, "plan.md");
  if (!exists(plan))
    fs.writeFileSync(plan, `# ${a.name}\n\n## Goal\n${a.goal || "(not set yet)"}\n\n## Plan\n\n## Stuck\n\n## Done\n`);
  const dec = path.join(d, "decisions.md");
  if (!exists(dec)) fs.writeFileSync(dec, `# ${a.name} decisions\n\nOne line each: date, decision, who decided, why.\n\n`);
  out(d);
}

function cmdProjectLs(a) {
  const ps = projects();
  for (const p of ps) {
    const t = live(p.lead);
    p.lead_status = word(t);
    p.lead_address = t ? t.address ?? null : null;
  }
  if (a.json) return out(JSON.stringify(ps, null, 2));
  for (const p of ps) out(`${pad(p.name, 16)} ${pad(p.lead_status, 8)} ${p.repo}`);
}

function cmdLeadStart(a) {
  const d = projectDir(a.name);
  const p = readJson(path.join(d, "project.json"));
  if (live(p.lead)) {
    log(`${p.lead} is already running.`);
    return out(p.lead);
  }
  const task = `You lead project \`${p.name}\`. Repo: ${p.repo}. Your notes: ${d}/plan.md and ${d}/decisions.md. ` +
    (a.goal ? `First goal from the CoS: ${a.goal}` : "Read your notes, then report to the CoS that you are up and what you will do first.");
  launch({ role: "lead", name: p.lead, cwd: p.repo, task, space: p.space, labels: [`cos.project=${p.name}`],
    parent: "outlive", keep: true });
  app(["do", "space.rename", "--id", p.space, "--name", p.name], false);
  log(`Started ${p.lead} in space ${p.name}.`);
  out(p.lead);
}

function cmdLeadStop(a) {
  const p = readJson(path.join(projectDir(a.name), "project.json"));
  if (!live(p.lead)) return log(`${p.lead} is not running.`);
  forgetLead(p.lead);
  hc(["kill", p.lead]);
  hc(["rm", p.lead], false);
  log(`Stopped ${p.lead} and its workers.`);
}

function cmdAsk(a) {
  ensureHome();
  if (a.project !== "hq") projectDir(a.project);
  const id = stamp("%m%d-%H%M") + "-" + hex2();
  const attDir = path.join(HOME, "queue", id);
  const atts = [];
  for (const src of a.attach) {
    if (/^https?:\/\//.test(src)) {
      atts.push({ kind: "link", url: src });
      continue;
    }
    const s = expand(src);
    if (!exists(s) || !fs.statSync(s).isFile()) throw new Fail(`attachment ${src} is not a file`, 2);
    fs.mkdirSync(attDir, { recursive: true });
    const dest = path.join(attDir, path.basename(s));
    fs.copyFileSync(s, dest);
    const st = fs.statSync(s);
    fs.utimesSync(dest, st.atime, st.mtime);
    const ext = path.extname(s).toLowerCase();
    const kind = [".png", ".jpg", ".jpeg", ".gif", ".webp"].includes(ext) ? "image"
      : [".mp4", ".mov", ".webm"].includes(ext) ? "video" : "file";
    atts.push({ kind, path: dest });
  }
  const item = {
    id, project: a.project, from: a.sender || process.env.HC_TERMINAL_ID || "cos",
    kind: a.kind, priority: a.priority, title: a.title, body: a.body || "",
    recommendation: a.recommend || "", options: a.option, attachments: atts,
    status: "open", answer: null, history: [], created: now(), updated: now(),
  };
  writeJson(path.join(HOME, "queue", `${id}.json`), item);
  out(id);
}

function cmdQueue(a) {
  let its = items(a.all);
  if (a.project) its = its.filter((i) => i.project === a.project);
  if (a.json) return out(JSON.stringify(its, null, 2));
  for (const i of its) out(`${i.id}  ${pad(i.status, 8)} ${i.priority} ${pad(i.kind, 8)} ${pad(i.project, 12)} ${i.title}`);
}

function cmdShow(a) {
  process.stdout.write(fs.readFileSync(itemPath(a.id), "utf8"));
}

// You answered an item in the panel. Record it and hand it to the CoS (only the CoS).
function cmdAnswer(a) {
  const p = itemPath(a.id), it = readJson(p);
  const answer = { verdict: a.verdict, text: a.text || "", choice: a.choice ?? null, at: now() };
  if (it.answer) (it.history ||= []).push(it.answer);
  Object.assign(it, { answer, status: "answered", updated: now() });
  writeJson(p, it);
  const msg = `[queue answer] ${it.id} (${it.project}, ${it.kind}): "${it.title}" -> ${a.verdict}` +
    (a.choice ? ` [${a.choice}]` : "") + (a.text ? `: ${a.text}` : "") +
    `. Asked by ${it.from}. Pass it on, append any rule that holds across projects to brain.md (once approved), ` +
    `and \`cos close ${it.id}\` once it is addressed.`;
  if (!a.no_send) {
    deliver("answer", "ceo", it.project, msg, { item: it.id });
    if (!live(COS)) log("The CoS is not running; the answer is in its inbox for its next shift.");
  }
  out(it.id);
}

// ---- inbox: messages for the CoS that never type into its pane ---------------

// Put one message in the CoS's inbox; returns its id.
function deliver(kind, sender, project, text, extra = {}) {
  const d = path.join(HOME, "inbox");
  fs.mkdirSync(d, { recursive: true });
  const id = stamp("%Y%m%d-%H%M%S") + "-" + hex2();
  writeJson(path.join(d, `${id}.json`), { id, kind, from: sender, project, text, at: now(), ...extra });
  return id;
}

function unread() {
  const d = path.join(HOME, "inbox");
  if (!isDir(d)) return [];
  return fs.readdirSync(d).filter((f) => f.endsWith(".json")).sort().map((f) => readJson(path.join(d, f)));
}

const SEEN_FILE = path.join(HOME, "inbox", "leads.state");
const readSeen = () => (exists(SEEN_FILE) ? readJson(SEEN_FILE) : {});

// Inbox messages for leads that turned blocked or stopped since the last look.
function watchLeads() {
  const seen = readSeen(), nowSeen = {};
  for (const p of projects()) {
    const st = word(live(p.lead));
    nowSeen[p.lead] = st;
    const before = seen[p.lead]; // undefined on the first look: nothing to compare with
    if (before === undefined || before === st) continue;
    if (st === "blocked")
      deliver("blocked", p.lead, p.name, `${p.lead} is blocked: it needs a person. Read it with \`hc read ${p.lead} --lines 60\`.`);
    else if (st === "stopped")
      deliver("stopped", p.lead, p.name, `${p.lead} has stopped. Restart it with \`cos lead start ${p.name}\` if its plan has open work.`);
  }
  fs.mkdirSync(path.join(HOME, "inbox"), { recursive: true });
  fs.writeFileSync(SEEN_FILE, JSON.stringify({ ...seen, ...nowSeen }));
}

// A lead the CoS stopped on purpose: no `stopped` message for it.
function forgetLead(lead) {
  const seen = readSeen();
  if (lead in seen) {
    seen[lead] = "stopped";
    fs.writeFileSync(SEEN_FILE, JSON.stringify(seen));
  }
}

// A lead (or anyone) reports to the CoS without typing into its pane.
function cmdReport(a) {
  const me = process.env.HC_TERMINAL_ID;
  const t = me ? hcJson("get", me) : null;
  const labels = (t && t.labels) || {};
  const sender = a.sender || (t && t.name) || me || "unknown";
  const project = a.project || labels["cos.project"] || "hq";
  const text = a.file ? fs.readFileSync(a.file, "utf8") : a.text;
  if (!text) throw new Fail("give the report as text or with --file", 2);
  const id = deliver(a.kind, sender, project, text, a.file ? { file: path.resolve(a.file) } : {});
  if (!live(COS)) log("The CoS is not running; your report waits in its inbox for its next shift.");
  out(id);
}

function showMessages(msgs, asJson) {
  if (asJson) return out(JSON.stringify(msgs, null, 2));
  for (const m of msgs) {
    out(`--- ${m.id}  ${m.kind}  from ${m.from}  (${m.project}, ${m.at})`);
    out(m.text.trimEnd());
  }
}

// For the panel's Inbox tab: unread messages, then the last n handled ones, newest first.
function inboxHistory(n) {
  const d = path.join(HOME, "inbox", "done");
  const done = isDir(d) ? fs.readdirSync(d).filter((f) => f.endsWith(".json")).sort().reverse().slice(0, n) : [];
  return [...unread().map((m) => ({ ...m, status: "unread" })),
    ...done.map((f) => ({ ...readJson(path.join(d, f)), status: "handled" }))];
}

async function cmdInbox(a) {
  if (a.done.length) {
    const dest = path.join(HOME, "inbox", "done");
    fs.mkdirSync(dest, { recursive: true });
    for (const id of a.done) {
      const f = path.join(HOME, "inbox", `${id}.json`);
      if (!exists(f)) throw new Fail(`no unread message ${id}`, 2);
      writeJson(path.join(dest, path.basename(f)), { ...readJson(f), handled: now() });
      fs.unlinkSync(f);
    }
    return;
  }
  if (a.history != null) return out(JSON.stringify(inboxHistory(Number(a.history) || 0), null, 2));
  let msgs;
  if (a.wait) {
    for (;;) {
      watchLeads();
      msgs = unread();
      if (msgs.length) break;
      await sleep(3000);
    }
  } else {
    msgs = unread();
    if (!msgs.length && !a.json) log("Inbox is empty.");
  }
  showMessages(msgs, a.json);
}

function cmdClose(a) {
  const p = itemPath(a.id), it = readJson(p);
  Object.assign(it, { status: "closed", closed_note: a.note || "", updated: now() });
  writeJson(p, it);
  out(it.id);
}

function cmdReopen(a) {
  const p = itemPath(a.id), it = readJson(p);
  Object.assign(it, { status: "open", updated: now() });
  if (a.note) it.body = ((it.body || "") + `\n\nUpdate ${now()}: ${a.note}`).trim();
  writeJson(p, it);
  out(it.id);
}

// Claude API list prices per model ($/MTok), kept in the skill's prices.json so they
// can be updated as Anthropic changes them. Seats aren't billed per token, so
// `cos stats` reports what the same tokens would cost on the API.
const PRICES_FILE = path.join(SKILL_DIR, "prices.json");

function prices() {
  try { return readJson(PRICES_FILE).models || {}; } catch { return {}; }
}

// Model, context in use and API-rate cost of one Claude Code transcript.
// Each assistant message is logged once per content block with the same usage, so
// messages are counted once by id. Context is the last message's whole prompt.
function transcriptUsage(file, table) {
  let text;
  try { text = fs.readFileSync(file, "utf8"); } catch { return null; }
  const seen = new Set();
  let cost = 0, last = null, model = null;
  for (const line of text.split("\n")) {
    if (!line.includes('"usage"')) continue;
    let m;
    try { m = JSON.parse(line).message || {}; } catch { continue; }
    const u = m.usage, mid = m.id;
    if (!u || seen.has(mid)) continue;
    seen.add(mid);
    model = m.model || model;
    const p = table[model];
    if (p == null) cost = null; // one unpriced message makes the total unknown
    else if (cost !== null) {
      const w1h = (u.cache_creation || {}).ephemeral_1h_input_tokens || 0;
      const w5m = (u.cache_creation_input_tokens || 0) - w1h;
      cost += ((u.input_tokens || 0) * p.input + w5m * p.cache_write_5m + w1h * p.cache_write_1h
        + (u.cache_read_input_tokens || 0) * p.cache_read + (u.output_tokens || 0) * p.output) / 1e6;
    }
    last = u;
  }
  const window = (table[model] || {}).context ?? null;
  if (last === null) return { model, context: 0, window, cost: 0, messages: 0 };
  const context = (last.input_tokens || 0) + (last.cache_creation_input_tokens || 0) + (last.cache_read_input_tokens || 0);
  return { model, context, window, cost: cost === null ? null : round4(cost), messages: seen.size };
}

// One terminal for `cos stats`: hc's status plus, for Claude, its transcript's usage.
function agentRow(t, role, depth, table) {
  const full = hcJson("get", t.address) || {};
  const labels = full.labels || {};
  const row = { address: t.address, name: t.name || t.address, agent: t.agent ?? null,
    role, depth, status: word(t), where: t.where ?? null };
  const file = labels["claude.transcript"];
  if (file) Object.assign(row, transcriptUsage(file, table) || {});
  return row;
}

// The fleet for the panel's Fleet tab: the CoS, then each project's lead and its workers.
function cmdStats() {
  const ls = (hcJson("ls") || {}).terminals || [];
  const table = prices();
  const byParent = {};
  for (const t of ls) (byParent[t.parent ?? null] ||= []).push(t);
  const tree = (t, role, depth) =>
    [agentRow(t, role, depth, table), ...(byParent[t.address] || []).flatMap((k) => tree(k, "worker", depth + 1))];

  const byName = Object.fromEntries(ls.filter((t) => t.name).map((t) => [t.name, t]));
  const cosT = byName[COS];
  const res = { cos: cosT ? agentRow(cosT, "cos", 0, table) : { name: COS, status: "stopped", role: "cos" },
    projects: [], queue: { open: 0, answered: 0 } };
  const its = items();
  for (const i of its) if (i.status in res.queue) res.queue[i.status]++;
  for (const p of projects()) {
    const plan = path.join(HOME, "projects", p.name, "plan.md");
    const m = exists(plan) ? fs.readFileSync(plan, "utf8").match(/## Goal\n(.+)/) : null;
    const lead = byName[p.lead];
    const agents = lead ? tree(lead, "lead", 0) : [];
    res.projects.push({ name: p.name, goal: m ? m[1].trim() : "", lead_status: word(lead), agents,
      queue_open: its.filter((i) => i.project === p.name && i.status === "open").length,
      cost: round4(agents.reduce((s, r) => s + (r.cost || 0), 0)) });
  }
  res.cost = round4((res.cos.cost || 0) + res.projects.reduce((s, p) => s + p.cost, 0));
  res.prices_file = PRICES_FILE;
  out(JSON.stringify(res, null, 2));
}

function cmdStatus(a) {
  ensureHome();
  const its = items(true);
  const rows = projects().map((p) => {
    const t = live(p.lead);
    let workers = [];
    if (t) {
      const all = (hcJson("ls") || {}).terminals || [];
      workers = all.filter((x) => x.parent === t.address && x.state === "live");
    }
    return { project: p.name, lead: p.lead, lead_status: word(t),
      workers: workers.map((w) => ({ name: w.name || w.address, status: word(w) })),
      open_items: its.filter((i) => i.project === p.name && i.status === "open").length, repo: p.repo };
  });
  const res = { cos: word(live(COS)), home: HOME, projects: rows,
    queue: { open: its.filter((i) => i.status === "open").length, answered: its.filter((i) => i.status === "answered").length } };
  if (a.json) return out(JSON.stringify(res, null, 2));
  out(`CoS: ${res.cos}   queue: ${res.queue.open} open, ${res.queue.answered} answered   state: ${HOME}`);
  for (const r of rows) {
    const ws = r.workers.map((w) => `${w.name} ${w.status}`).join(", ") || "no workers";
    out(`  ${pad(r.project, 14)} lead ${pad(r.lead_status, 8)} ${r.open_items} open  [${ws}]`);
  }
}

// ---- arguments ----------------------------------------------------------------

// Each command: its positionals ("name", "name?" optional, "name..." the rest verbatim) and
// options (flag -> {key, help, bool, many: repeatable, list: one or more values, choices, required, def}).
const json = { "--json": { bool: true } };
const COMMANDS = {
  init: { fn: cmdInit, help: "set up this machine: the state folder and settings (asks for missing ones); prints its path",
    opts: { "--reset": { bool: true, help: "ask for every setting again" } } },
  config: { fn: cmdConfig, help: "print this machine's settings, or set one: cos config COS_WORK_ROOT ~/work", pos: ["name?", "value?"] },
  exec: { fn: cmdExec, help: "run a role in this terminal: its program, model and system prompt from roles.json, then the rest of the arguments (the last one is its first prompt)",
    pos: ["role", "extra..."] },
  roles: { fn: cmdRoles, help: "each role's program, model and system prompt files (roles.json)", opts: json },
  run: { fn: cmdRun, help: "a lead starts a worker in its own terminal: cos run <role> <name> --cwd <dir> \"<brief>\"; prints its name",
    pos: ["role", "name", "task"], opts: { "--cwd": { help: "the folder it works in (default: here)" } } },
  up: { fn: cmdUp, help: "open HQ: start the CoS and the Chief of Staff panel (safe to rerun)" },
  status: { fn: cmdStatus, help: "CoS, leads, their workers and queue counts", opts: json },
  "project add": { fn: cmdProjectAdd, help: "add a project (or change its repo)", pos: ["name"],
    opts: { "--repo": { required: true }, "--goal": {} } },
  "project ls": { fn: cmdProjectLs, help: "list projects with their lead's status", opts: json },
  "lead start": { fn: cmdLeadStart, help: "start lead-<project> in its own space", pos: ["name"],
    opts: { "--goal": { help: "the first goal to hand it" } } },
  "lead stop": { fn: cmdLeadStop, help: "kill lead-<project> and its workers", pos: ["name"] },
  ask: { fn: cmdAsk, help: "put an item in the CEO's queue; prints its id", opts: {
    "--project": { required: true, help: "project name, or hq for org-wide items" },
    "--title": { required: true, help: "one line the CEO can decide from" },
    "--kind": { choices: KINDS, def: "decision" },
    "--priority": { choices: PRIORITIES, def: "p2", help: "p0 blocks work now ... p3 whenever" },
    "--body": { help: "context: what, why now, what happens on each answer (markdown)" },
    "--recommend": { help: "the answer you recommend and why, in one or two lines" },
    "--option": { many: true, help: "a choice the CEO can pick (repeatable)" },
    "--attach": { many: true, help: "screenshot/video/file path or URL (repeatable)" },
    "--from": { key: "sender", help: "who raised it (default: $HC_TERMINAL_ID)" } } },
  report: { fn: cmdReport, help: "a lead's report to the CoS, into its inbox (never `hc send cos`); prints its id", pos: ["text?"], opts: {
    "--kind": { choices: REPORT_KINDS, def: "fyi" },
    "--file": { help: "a file holding the report (for anything longer than ten lines)" },
    "--project": { help: "default: your terminal's cos.project label" },
    "--from": { key: "sender", help: "default: your hc name" } } },
  inbox: { fn: cmdInbox, help: "the CoS's unread messages: leads' reports, panel answers, stopped leads", opts: {
    "--wait": { bool: true, help: "block until there is one (run it in the background), then print them" },
    "--done": { list: true, help: "mark messages handled (one or more ids)" },
    "--history": { help: "JSON of the unread messages and the last N handled ones, each with a status (the panel's Inbox tab)" }, ...json } },
  queue: { fn: cmdQueue, help: "list queue items, open first by priority",
    opts: { "--all": { bool: true, help: "include closed items" }, "--project": {}, ...json } },
  show: { fn: cmdShow, help: "print one item's JSON", pos: ["id"] },
  answer: { fn: cmdAnswer, help: "record the CEO's answer and put it in the CoS's inbox (the panel runs this)", pos: ["id"], opts: {
    "--verdict": { choices: VERDICTS, required: true }, "--text": {}, "--choice": {},
    "--no-send": { bool: true, help: "record only, no inbox message" } } },
  stats: { fn: cmdStats, help: "JSON for the Fleet tab: agents' status, context and API-rate cost (prices.json)" },
  close: { fn: cmdClose, help: "close an item once its answer is acted on", pos: ["id"], opts: { "--note": {} } },
  reopen: { fn: cmdReopen, help: "put an answered or closed item back in front of the CEO", pos: ["id"], opts: { "--note": {} } },
};

const keyOf = (flag, o) => o.key || flag.slice(2).replace(/-/g, "_");

function usage(name, c) {
  const pos = (c.pos || []).map((p) => (p.endsWith("?") ? `[${p.slice(0, -1)}]` : p.endsWith("...") ? `[${p}]` : p));
  const opts = Object.entries(c.opts || {}).map(([f, o]) => {
    const v = o.bool ? f : `${f} ${o.choices ? `{${o.choices.join(",")}}` : keyOf(f, o).toUpperCase()}${o.list ? " ..." : ""}`;
    return o.required ? v : `[${v}]`;
  });
  return ["usage: cos", name, ...opts, ...pos].join(" ");
}

function help(name, c) {
  const lines = [usage(name, c), "", c.help];
  const opts = Object.entries(c.opts || {});
  if (opts.length) {
    lines.push("", "options:");
    for (const [f, o] of opts) {
      const extra = [o.help, o.choices && `one of ${o.choices.join(", ")}`, o.def && `default ${o.def}`, o.required && "required"];
      lines.push(`  ${pad(f, 14)} ${extra.filter(Boolean).join("; ")}`);
    }
  }
  return lines.join("\n");
}

function topHelp() {
  const lines = ["usage: cos <command> [options]   (cos <command> --help for one)", "", DOC, "", "commands:"];
  for (const [name, c] of Object.entries(COMMANDS)) lines.push(`  ${pad(name, 13)} ${c.help}`);
  return lines.join("\n");
}

function parse(argv) {
  const bad = (msg, name, c) => {
    log(c ? usage(name, c) : "usage: cos <command> [options]   (cos --help lists them)");
    throw new Fail(msg, 2);
  };
  if (!argv.length) bad("a command is required");
  if (argv[0] === "-h" || argv[0] === "--help") return out(topHelp()), null;
  let name = argv[0], rest = argv.slice(1);
  const group = Object.keys(COMMANDS).filter((k) => k.startsWith(name + " "));
  if (group.length) {
    if (!rest.length || rest[0] === "-h" || rest[0] === "--help") {
      out(`usage: cos ${name} {${group.map((k) => k.split(" ")[1]).join(",")}} ...\n`);
      for (const k of group) out(`  ${pad(k, 13)} ${COMMANDS[k].help}`);
      return rest.length ? null : bad(`${name}: a subcommand is required`);
    }
    name += " " + rest[0];
    rest = rest.slice(1);
  }
  const c = COMMANDS[name];
  if (!c) bad(`unknown command '${name}'`);
  const a = { cmd: name };
  const opts = c.opts || {};
  for (const [f, o] of Object.entries(opts)) a[keyOf(f, o)] = o.bool ? false : o.many || o.list ? [] : o.def ?? null;
  const pos = [];
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    if ((c.pos || []).at(-1)?.endsWith("...") && pos.length === c.pos.length - 1) {
      a.extra = rest.slice(i); // the rest goes to the program untouched, flags included
      break;
    }
    if (arg === "-h" || arg === "--help") return out(help(name, c)), null;
    if (!arg.startsWith("--") || arg === "--") {
      pos.push(arg);
      continue;
    }
    let [flag, val] = arg.includes("=") ? [arg.slice(0, arg.indexOf("=")), arg.slice(arg.indexOf("=") + 1)] : [arg, undefined];
    const o = opts[flag];
    if (!o) bad(`unrecognized argument ${flag}`, name, c);
    const k = keyOf(flag, o);
    if (o.bool) {
      a[k] = true;
      continue;
    }
    if (o.list) {
      if (val !== undefined) a[k].push(val);
      while (i + 1 < rest.length && !rest[i + 1].startsWith("--")) a[k].push(rest[++i]);
      if (!a[k].length) bad(`${flag} expects at least one value`, name, c);
      continue;
    }
    if (val === undefined) {
      if (i + 1 >= rest.length) bad(`${flag} expects a value`, name, c);
      val = rest[++i];
    }
    if (o.choices && !o.choices.includes(val)) bad(`${flag}: '${val}' is not one of ${o.choices.join(", ")}`, name, c);
    if (o.many) a[k].push(val);
    else a[k] = val;
  }
  const spec = c.pos || [];
  for (const [n, p] of spec.entries()) {
    const key = p.replace(/[?.]+$/, "");
    if (p.endsWith("...")) a[key] ??= [];
    else if (n < pos.length) a[key] = pos[n];
    else if (p.endsWith("?")) a[key] = null;
    else bad(`missing ${key}`, name, c);
  }
  if (pos.length > spec.filter((p) => !p.endsWith("...")).length) bad(`unexpected argument ${pos.at(-1)}`, name, c);
  for (const [f, o] of Object.entries(opts)) if (o.required && a[keyOf(f, o)] == null) bad(`${f} is required`, name, c);
  return a;
}

async function main() {
  try {
    const a = parse(process.argv.slice(2));
    if (a) await COMMANDS[a.cmd].fn(a);
  } catch (e) {
    if (!(e instanceof Fail)) throw e;
    log(`cos: ${e.message}`);
    process.exit(e.code);
  }
}

main();
