#!/usr/bin/env node
// fleet-slack: a Slack bridge to the fleet's Chief of Staff, as an add-on. `fleet-slack --help` prints DOC.
"use strict";
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const DOC = `fleet-slack: talk to the Chief of Staff (CoS) from Slack. An add-on: it touches the CoS
only through the \`cos\` CLI (report, queue, answer), so deleting this skill removes it.

  Slack DM to the bot, or an @-mention in a thread ──▶ fleet-slack run (Socket Mode)
      only from SLACK_CEO_USER ──▶ fleet report --from slack ──▶ the CoS's inbox
  the CoS answers with: fleet-slack reply <inbox id> "<text>" ──▶ same DM or thread
  open p0/p1 queue items ──▶ a DM with buttons ──▶ fleet answer
      a reply in that item's thread ──▶ fleet answer --verdict feedback

Socket Mode means the bridge opens a websocket out to Slack: no public URL, no server.

Each Slack workspace (for example suppco, functionhealth) has its own app, made from the
same manifest, and its own bridge: a launchd agent local.fleet-slack.<workspace>.

  $FLEET_SLACK_HOME (default <work root>/.fleet/slack: the fleet \`fleet home\` names; each
  workspace's launchd agent keeps that fleet's FLEET_HOME, so it talks to that fleet only)
    <workspace>/config.env    its settings (mode 600)
    <workspace>/state.json    inbox id -> Slack message; queue item -> its Slack post
    <workspace>/bridge.log    its launchd agent's output

Settings, per workspace:
  SLACK_APP_TOKEN   xapp-...: Basic Information > App-Level Tokens, scope connections:write
  SLACK_BOT_TOKEN   xoxb-...: Install App, once the app is installed
  SLACK_CEO_USER    U...: your member ID there (Slack profile > ⋮ > Copy member ID)
  SLACK_PROJECTS    optional: fleet projects whose p0/p1 items it posts, comma-separated (empty: all)

Set up one workspace: create the Slack app in it from the skill's slack-manifest.json, then
  fleet-slack config -w suppco SLACK_APP_TOKEN xapp-...   (and the other settings)
  fleet-slack install -w suppco

commands (-w/--workspace may be left out when only one workspace is set up):
  run -w W                  the bridge, in the foreground
  install -w W | uninstall -w W   start or remove that workspace's launchd agent
  status [-w W]             settings, agent and Slack connection of each workspace
  config [-w W] [NAME [VALUE]]    print the settings (tokens masked), or set one
  reply <inbox id> [text]   post the CoS's answer where that message came from, in whichever
                            workspace it was (--file F for long text)

Exit 0 ok, 1 a step failed, 2 bad usage or a missing setting.`;

// The fleet this bridge serves (`fleet home`), and its Slack workspaces' folder inside it.
let fleetHome = null;
const home = () => (fleetHome ??= fleet(["home"]));
const root = () => process.env.FLEET_SLACK_HOME || path.join(home(), "slack");
const SETTINGS = ["SLACK_APP_TOKEN", "SLACK_BOT_TOKEN", "SLACK_CEO_USER", "SLACK_PROJECTS"];
const REQUIRED = SETTINGS.slice(0, 3);
const NAME_RE = /^[a-z0-9][a-z0-9-]{0,31}$/;
const PUSH_PRIORITIES = ["p0", "p1"]; // queue items worth a Slack DM
const QUEUE_POLL_MS = 15000;

class Fail extends Error {
  constructor(msg, code = 1) {
    super(msg);
    this.code = code;
  }
}

const log = (msg) => process.stderr.write(`${new Date().toISOString()} ${msg}\n`);
const out = (msg) => process.stdout.write(msg + "\n");
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function writeAtomic(p, text, mode) {
  fs.mkdirSync(path.dirname(p), { recursive: true });
  fs.writeFileSync(p + ".tmp", text, mode ? { mode } : {});
  fs.renameSync(p + ".tmp", p);
}

const isDir = (p) => { try { return fs.statSync(p).isDirectory(); } catch { return false; } };

// One Slack workspace: its folder (settings, state, log) and its launchd agent.
function workspace(name) {
  if (!NAME_RE.test(name)) throw new Fail(`workspace names are a-z 0-9 -, like suppco; got '${name}'`, 2);
  const dir = path.join(root(), name), label = `local.fleet-slack.${name}`;
  return { name, dir, label, config: path.join(dir, "config.env"), state: path.join(dir, "state.json"),
    log: path.join(dir, "bridge.log"), plist: path.join(os.homedir(), "Library/LaunchAgents", `${label}.plist`) };
}

const workspaces = () => {
  const r = root();
  return isDir(r) ? fs.readdirSync(r).filter((n) => NAME_RE.test(n) && isDir(path.join(r, n))).sort().map(workspace) : [];
};

// The workspace a command means: the one named, else the only one set up.
function pick(name) {
  if (name) return workspace(name);
  const all = workspaces();
  if (all.length === 1) return all[0];
  throw new Fail(all.length ? `name the workspace with -w: ${all.map((w) => w.name).join(", ")}`
    : "no workspace set up yet; start with: fleet-slack config -w <name> SLACK_APP_TOKEN xapp-...", 2);
}

function config(w) {
  const cfg = {};
  if (!fs.existsSync(w.config)) return cfg;
  for (const line of fs.readFileSync(w.config, "utf8").split("\n")) {
    const i = line.indexOf("=");
    if (i > 0 && SETTINGS.includes(line.slice(0, i))) cfg[line.slice(0, i)] = line.slice(i + 1).trim();
  }
  return cfg;
}

function requireConfig(w) {
  const cfg = config(w), missing = REQUIRED.filter((k) => !cfg[k]);
  if (missing.length) throw new Fail(`${w.name} is not set up: ${missing.join(", ")} missing. Set each with \`fleet-slack config -w ${w.name} <NAME> <value>\`.`, 2);
  return cfg;
}

const readState = (w) => {
  try { return { inbox: {}, items: {}, ...JSON.parse(fs.readFileSync(w.state, "utf8")) }; } catch { return { inbox: {}, items: {} }; }
};
const saveState = (w, st) => writeAtomic(w.state, JSON.stringify(st, null, 2) + "\n");

// The fleet CLI is the only way into the CoS's state.
function fleet(args) {
  const r = spawnSync("fleet", args, { encoding: "utf8" });
  if (r.error) throw new Fail(`fleet is not on PATH: ${r.error.message}`);
  if (r.status !== 0) throw new Fail(`fleet ${args[0]} failed: ${(r.stderr || r.stdout).trim()}`);
  return r.stdout.trim();
}

// ---- Slack Web API ------------------------------------------------------------

async function slack(token, method, body = {}) {
  const res = await fetch(`https://slack.com/api/${method}`, {
    method: "POST",
    headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json; charset=utf-8" },
    body: JSON.stringify(body),
  });
  const data = await res.json();
  if (!data.ok) throw new Fail(`Slack ${method}: ${data.error}${data.needed ? ` (needs scope ${data.needed})` : ""}`);
  return data;
}

// conversations.replies and users.info take form arguments, not JSON.
async function slackGet(token, method, params) {
  const res = await fetch(`https://slack.com/api/${method}?${new URLSearchParams(params)}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  const data = await res.json();
  if (!data.ok) throw new Fail(`Slack ${method}: ${data.error}${data.needed ? ` (needs scope ${data.needed})` : ""}`);
  return data;
}

// Slack's markdown block renders standard markdown; text is the notification fallback.
const markdown = (text) => ({ text: text.slice(0, 3000), blocks: [{ type: "markdown", text: text.slice(0, 12000) }] });

// ---- the bridge -----------------------------------------------------------------

class Bridge {
  constructor(w, cfg) {
    this.w = w;
    this.cfg = cfg;
    this.projects = cfg.SLACK_PROJECTS ? cfg.SLACK_PROJECTS.split(",").map((p) => p.trim()).filter(Boolean) : null;
    this.bot = cfg.SLACK_BOT_TOKEN;
    this.ceo = cfg.SLACK_CEO_USER;
    this.names = {};
    this.seen = new Set(); // event ids, since Slack retries an event it thinks was missed
  }

  async start() {
    this.me = (await slack(this.bot, "auth.test")).user_id;
    this.dm = (await slack(this.bot, "conversations.open", { users: this.ceo })).channel.id;
    log(`${this.w.name}: connected as ${this.me}; DM channel with the CEO is ${this.dm}`);
    this.pollQueue();
    for (let wait = 1000; ; wait = Math.min(wait * 2, 60000)) {
      try {
        await this.socket();
        wait = 1000; // a clean disconnect: Slack asked us to reconnect
      } catch (e) {
        log(`socket: ${e.message}; reconnecting in ${wait / 1000}s`);
        await sleep(wait);
      }
    }
  }

  // One Socket Mode connection; resolves when Slack closes it.
  async socket() {
    const { url } = await slack(this.cfg.SLACK_APP_TOKEN, "apps.connections.open");
    const ws = new WebSocket(url);
    return new Promise((resolve, reject) => {
      ws.onmessage = (m) => {
        let env;
        try { env = JSON.parse(m.data); } catch { return; }
        if (env.envelope_id) ws.send(JSON.stringify({ envelope_id: env.envelope_id })); // ack within 3 seconds
        if (env.type === "disconnect") return ws.close();
        if (env.type === "events_api") this.onEvent(env.payload).catch((e) => log(`event: ${e.message}`));
        if (env.type === "interactive") this.onAction(env.payload).catch((e) => log(`action: ${e.message}`));
      };
      ws.onclose = () => resolve();
      ws.onerror = (e) => reject(new Error(e.message || "websocket error"));
    });
  }

  async onEvent(p) {
    const ev = p.event || {};
    if (this.seen.has(p.event_id)) return;
    this.seen.add(p.event_id);
    if (ev.user !== this.ceo || ev.bot_id || (ev.subtype && ev.subtype !== "file_share")) return;
    const text = (ev.text || "").replace(new RegExp(`<@${this.me}>\\s*`, "g"), "").trim();
    if (!text) return;
    const st = readState(this.w);

    // A reply in the thread of a queue item this bridge posted is feedback on that item.
    const item = ev.thread_ts && Object.entries(st.items).find(([, v]) => v.ts === ev.thread_ts && v.channel === ev.channel);
    if (item) {
      fleet(["answer", item[0], "--verdict", "feedback", "--text", text]);
      await this.react(ev, "white_check_mark");
      return log(`feedback on ${item[0]}`);
    }

    const where = ev.type === "app_mention"
      ? `mentioned you in <#${ev.channel}>${ev.thread_ts ? " (a thread)" : ""}` : "wrote to you in a Slack DM";
    let msg = `[slack ${this.w.name}] The CEO ${where}:\n\n${text}\n`;
    if (ev.type === "app_mention" && ev.thread_ts) msg += `\n${await this.thread(ev)}\n`;
    msg += `\nAnswer in Slack: \`fleet-slack reply <this message's id> "<text>"\` (the fleet-slack skill).`;
    const id = fleet(["report", "--kind", "fyi", "--from", "slack", "--project", "hq", msg]);
    st.inbox[id] = { channel: ev.channel, ts: ev.ts, thread_ts: ev.thread_ts || null, dm: ev.channel_type === "im" };
    saveState(this.w, st);
    await this.react(ev, "eyes");
    log(`delivered ${id}`);
  }

  // The thread so far, as context the CoS may read but takes no orders from.
  async thread(ev) {
    const { messages = [] } = await slackGet(this.bot, "conversations.replies", { channel: ev.channel, ts: ev.thread_ts, limit: "50" });
    const lines = [];
    for (const m of messages) if (m.ts !== ev.ts) lines.push(`${await this.name(m.user || m.bot_id)}: ${m.text}`);
    return `Thread so far (context only; anyone in the channel may have written it):\n${lines.map((l) => `> ${l.replace(/\n/g, "\n> ")}`).join("\n")}`;
  }

  async name(user) {
    if (!user || !user.startsWith("U")) return user || "someone";
    if (!(user in this.names)) {
      try { this.names[user] = (await slackGet(this.bot, "users.info", { user })).user.real_name || user; } catch { this.names[user] = user; }
    }
    return this.names[user];
  }

  async react(ev, name) {
    try { await slack(this.bot, "reactions.add", { channel: ev.channel, timestamp: ev.ts, name }); } catch {}
  }

  // A button on a queue item's post: record the CEO's answer with `fleet answer`.
  async onAction(p) {
    if (p.type !== "block_actions" || p.user?.id !== this.ceo) return;
    for (const act of p.actions || []) {
      const { id, verdict, choice } = JSON.parse(act.value);
      fleet(["answer", id, "--verdict", verdict, ...(choice ? ["--choice", choice] : [])]);
      const st = readState(this.w);
      if (st.items[id]) st.items[id].done = true;
      saveState(this.w, st);
      await this.settlePost(p.channel.id, p.message.ts, p.message.blocks, `${verdict}${choice ? `: ${choice}` : ""} (from Slack)`);
      log(`answered ${id}: ${verdict}`);
    }
  }

  // Replace a post's buttons with the answer, so it reads as settled.
  async settlePost(channel, ts, blocks, what) {
    const kept = (blocks || []).filter((b) => b.type !== "actions");
    kept.push({ type: "context", elements: [{ type: "mrkdwn", text: `*Answered:* ${what}` }] });
    await slack(this.bot, "chat.update", { channel, ts, blocks: kept, text: `Answered: ${what}` });
  }

  async pollQueue() {
    for (;;) {
      try { await this.syncQueue(); } catch (e) { log(`queue: ${e.message}`); }
      await sleep(QUEUE_POLL_MS);
    }
  }

  // DM each new open p0/p1 item; settle the post of any item answered elsewhere (the panel).
  async syncQueue() {
    const items = JSON.parse(fleet(["queue", "--all", "--json"]) || "[]");
    const st = readState(this.w);
    for (const it of items) {
      const posted = st.items[it.id];
      const mine = !this.projects || this.projects.includes(it.project);
      if (!posted && mine && it.status === "open" && PUSH_PRIORITIES.includes(it.priority)) {
        const r = await slack(this.bot, "chat.postMessage", { channel: this.dm, ...this.itemPost(it) });
        st.items[it.id] = { channel: r.channel, ts: r.ts };
        saveState(this.w, st);
        log(`posted queue item ${it.id}`);
      } else if (posted && !posted.done && it.status !== "open") {
        posted.done = true; // once, even if the update below fails
        saveState(this.w, st);
        const a = it.answer || {};
        const what = it.status === "closed" ? "closed" : `${a.verdict}${a.choice ? `: ${a.choice}` : ""}`;
        const { messages = [] } = await slackGet(this.bot, "conversations.history",
          { channel: posted.channel, latest: posted.ts, inclusive: "true", limit: "1" });
        await this.settlePost(posted.channel, posted.ts, messages[0]?.blocks, what);
      }
    }
  }

  itemPost(it) {
    const head = `*${it.priority} · ${it.kind} · ${it.project}*\n${it.title}`;
    let body = it.body || "";
    if (it.recommendation) body += `\n\n**Recommended:** ${it.recommendation}`;
    const btn = (label, verdict, choice, style) => ({
      type: "button", text: { type: "plain_text", text: label.slice(0, 75) }, ...(style ? { style } : {}),
      value: JSON.stringify({ id: it.id, verdict, ...(choice ? { choice } : {}) }).slice(0, 2000),
      action_id: `${verdict}-${choice || ""}`.slice(0, 255),
    });
    const buttons = (it.options || []).slice(0, 5).map((o) => btn(o, "choose", o));
    if (!buttons.length) buttons.push(btn("Approve", "approve", null, "primary"));
    buttons.push(btn("Reject", "reject", null, "danger"));
    const links = (it.attachments || []).map((a) => a.url).filter(Boolean);
    const note = `Reply in this thread to send feedback.${(it.attachments || []).some((a) => a.path) ? " Screenshots are in the Queue tab." : ""}`;
    return {
      text: `${it.priority} ${it.kind}: ${it.title}`,
      blocks: [
        { type: "section", text: { type: "mrkdwn", text: head.slice(0, 3000) } },
        ...(body.trim() ? [{ type: "markdown", text: body.slice(0, 12000) }] : []),
        ...(links.length ? [{ type: "section", text: { type: "mrkdwn", text: links.join("\n").slice(0, 3000) } }] : []),
        { type: "actions", elements: buttons },
        { type: "context", elements: [{ type: "mrkdwn", text: `${it.id} · ${note}` }] },
      ],
    };
  }
}

// ---- commands -------------------------------------------------------------------

async function cmdRun(args, ws) {
  const w = pick(ws);
  await new Bridge(w, requireConfig(w)).start();
}

async function cmdReply(args) {
  let file = null;
  const i = args.indexOf("--file");
  if (i >= 0) [file] = args.splice(i, 2).slice(1);
  const [id, ...rest] = args;
  if (!id) throw new Fail("usage: fleet-slack reply <inbox id> [text] [--file F]", 2);
  const text = file ? fs.readFileSync(file, "utf8") : rest.join(" ");
  if (!text.trim()) throw new Fail("give the reply as text or with --file", 2);
  const w = workspaces().find((x) => readState(x).inbox[id]);
  if (!w) throw new Fail(`inbox message ${id} did not come from Slack`, 2);
  const where = readState(w).inbox[id], cfg = requireConfig(w);
  const thread_ts = where.dm ? where.thread_ts : where.thread_ts || where.ts; // a DM answers in place, a channel in the thread
  await slack(cfg.SLACK_BOT_TOKEN, "chat.postMessage", { channel: where.channel, ...(thread_ts ? { thread_ts } : {}), ...markdown(text) });
  try { await slack(cfg.SLACK_BOT_TOKEN, "reactions.remove", { channel: where.channel, timestamp: where.ts, name: "eyes" }); } catch {}
  out(id);
}

function cmdConfig([name, value], ws) {
  if (name && !SETTINGS.includes(name)) throw new Fail(`unknown setting ${name}; settings: ${SETTINGS.join(", ")}`, 2);
  if (value == null && !ws && workspaces().length > 1) {
    for (const w of workspaces()) out(`[${w.name}]`), printConfig(w, name);
    return;
  }
  const w = pick(ws), cfg = config(w);
  if (value != null) {
    cfg[name] = value.trim();
    writeAtomic(w.config, SETTINGS.filter((k) => cfg[k]).map((k) => `${k}=${cfg[k]}`).join("\n") + "\n", 0o600);
    fs.chmodSync(w.config, 0o600);
  }
  printConfig(w, name);
}

function printConfig(w, name) {
  const cfg = config(w);
  for (const k of name ? [name] : SETTINGS)
    out(`${k}=${cfg[k] && k.endsWith("TOKEN") ? cfg[k].slice(0, 5) + "…(set)" : cfg[k] ?? ""}`);
}

const SELF = fs.realpathSync(__filename);
const uid = () => process.getuid();
const launchctl = (...args) => spawnSync("launchctl", args, { encoding: "utf8" });

function cmdInstall(args, ws) {
  const w = pick(ws);
  requireConfig(w);
  const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
  const env = { PATH: process.env.PATH, FLEET_HOME: home(),
    ...(process.env.FLEET_SLACK_HOME ? { FLEET_SLACK_HOME: process.env.FLEET_SLACK_HOME } : {}) };
  writeAtomic(w.plist, `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${w.label}</string>
  <key>ProgramArguments</key><array><string>${esc(process.execPath)}</string><string>${esc(SELF)}</string><string>run</string><string>-w</string><string>${w.name}</string></array>
  <key>EnvironmentVariables</key><dict>${Object.entries(env).map(([k, v]) => `<key>${k}</key><string>${esc(v)}</string>`).join("")}</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>${esc(w.log)}</string>
  <key>StandardErrorPath</key><string>${esc(w.log)}</string>
</dict></plist>
`);
  launchctl("bootout", `gui/${uid()}/${w.label}`); // a rerun picks up a new node or PATH
  const r = launchctl("bootstrap", `gui/${uid()}`, w.plist);
  if (r.status !== 0) throw new Fail(`launchctl bootstrap failed: ${r.stderr.trim()}`);
  log(`Installed ${w.plist}; the bridge logs to ${w.log}.`);
}

function cmdUninstall(args, ws) {
  const w = pick(ws);
  launchctl("bootout", `gui/${uid()}/${w.label}`);
  if (fs.existsSync(w.plist)) fs.unlinkSync(w.plist);
  log(`Removed ${w.label}. Settings and state stay in ${w.dir}.`);
}

async function cmdStatus(args, ws) {
  const all = ws ? [workspace(ws)] : workspaces();
  if (!all.length) return out("No workspace set up yet (fleet-slack --help).");
  for (const w of all) {
    out(`[${w.name}]`);
    printConfig(w);
    const r = launchctl("print", `gui/${uid()}/${w.label}`);
    out(`launchd agent: ${r.status === 0 ? (r.stdout.match(/state = (\w+)/)?.[1] ?? "loaded") : "not installed"}`);
    const cfg = config(w);
    if (cfg.SLACK_BOT_TOKEN) {
      try {
        const a = await slack(cfg.SLACK_BOT_TOKEN, "auth.test");
        out(`Slack: bot ${a.user} in ${a.team}`);
      } catch (e) { out(`Slack: ${e.message}`); }
    }
  }
}

const COMMANDS = { run: cmdRun, reply: cmdReply, config: cmdConfig, install: cmdInstall, uninstall: cmdUninstall, status: cmdStatus };

async function main() {
  const [name, ...args] = process.argv.slice(2);
  if (!name || name === "-h" || name === "--help") return out(DOC);
  try {
    if (!COMMANDS[name]) throw new Fail(`unknown command '${name}' (fleet-slack --help lists them)`, 2);
    let ws = null; // -w/--workspace may come anywhere after the command
    for (let i = 0; i < args.length; i++) {
      const m = args[i].match(/^--workspace=(.*)$/);
      if (m) ws = m[1], args.splice(i--, 1);
      else if (args[i] === "-w" || args[i] === "--workspace") {
        if (i + 1 >= args.length) throw new Fail(`${args[i]} expects a workspace name`, 2);
        ws = args.splice(i--, 2)[1];
      }
    }
    await COMMANDS[name](args, ws);
  } catch (e) {
    if (!(e instanceof Fail)) throw e;
    log(`fleet-slack: ${e.message}`);
    process.exit(e.code);
  }
}

main();
