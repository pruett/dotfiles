{
  "_metadata": { "major_version": 1, "minor_version": 1 },
  "display_information": {
    "name": "k2",
    "description": "A private line to my local Chief of Staff agent. Socket Mode: no public URL.",
    "background_color": "#1f2933"
  },
  "features": {
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "k2", "always_online": true }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "channels:history", "groups:history", "im:history", "im:write", "chat:write", "reactions:write", "users:read"]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["app_mention", "message.im"] },
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
