#!/usr/bin/env bash
# verify-suppco — shim. The CLI itself lives in the verify-suppco repo (github.com/pruett/verify-suppco, packages/cli),
# next to its browser GUI; this dotfiles skill keeps only SKILL.md and this forwarder so a fresh machine has the command
# on PATH (~/.local/bin/verify-suppco -> here) and is told what to clone. $VERIFY_SUPPCO_HOME points at another checkout.
set -euo pipefail
HOME_DIR="${VERIFY_SUPPCO_HOME:-$HOME/personal/verify-suppco}"
CLI="$HOME_DIR/packages/cli/bin/verify-suppco"
if [[ ! -x "$CLI" ]]; then
  printf '\033[31m✖\033[0m no verify-suppco checkout at %s (set $VERIFY_SUPPCO_HOME to use another path); clone it:\n' "$HOME_DIR" >&2
  printf 'git clone git@github.com:pruett/verify-suppco.git %s\n' "$HOME_DIR"
  exit 1
fi
exec "$CLI" "$@"
