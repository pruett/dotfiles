#!/usr/bin/env bash
# wt — git worktrees beside their repos, for the repos its config allows.
#
# A workspace is a folder (not a git repo) that holds main checkouts. Worktrees
# live beside the repos, not inside them:
#
#   ~/work/suppco/                 workspace
#     web/  backend/               main checkouts
#     worktrees/web/<slug>/        linked worktrees of web
#     worktrees/backend/<slug>/    linked worktrees of backend
#
# `new` makes a worktree ready to run by applying the repo's rules from the
# config, in order: copy the gitignored files its include files list, trust
# mise, write env, run setup, print notes. `rm` and `prune` run teardown first. The core is plain git; agent harnesses plug in like herdr's do:
# `wt integration install claude` writes a managed hook script into the
# harness's config folder and registers it in the harness's settings, so the
# harness's own worktrees route through `wt hook <harness>`.
#
# stdout carries data only (a path, or `ls` rows); progress goes to stderr.
# Exit 0 ok · 1 a step failed · 2 bad usage or a precondition. Every non-zero
# exit prints a `fix:` line. Written for macOS /bin/bash 3.2.
#
# The zsh function of the same name (~/.config/zsh/functions/wt) wraps this
# script so `wt new` and `wt cd` can change the shell's directory.
set -uo pipefail

# Config: $WT_CONFIG, else ~/.config/wt/config when it exists (a per-machine
# override), else the config beside this script's skill folder.
script_dir() { # follows symlinks; macOS bash 3.2 has no readlink -f
  local f=${BASH_SOURCE[0]} l
  while [ -L "$f" ]; do
    l=$(readlink "$f"); case $l in /*) f=$l ;; *) f=$(dirname "$f")/$l ;; esac
  done
  cd "$(dirname "$f")" && pwd -P
}
if [ -z "${WT_CONFIG:-}" ]; then
  WT_CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/wt/config
  [ -f "$WT_CONFIG" ] || WT_CONFIG=$(dirname "$(script_dir)")/config
fi
WT_DIR=worktrees
TAB=$(printf '\t')

log() { printf '%s\n' "$*" >&2; }
step() { printf '%-7s %s\n' "$1" "$2" >&2; }
die() { # die <code> <message> [fix]
  printf 'wt: %s\n' "$2" >&2
  [ -n "${3:-}" ] && printf 'fix: %s\n' "$3" >&2
  exit "$1"
}
need() { command -v "$1" >/dev/null 2>&1 || die 2 "$1 is not on PATH" "brew install $1"; }
tilde() { printf '%s\n' "${1/#$HOME/~}"; }

# ── config ───────────────────────────────────────────────────────────────────

CFG_KEYS="include env setup teardown note"

# MAINS: the allowed main checkouts, one per line, in file order.
# CFG:   one line per entry, in file order: <main checkout> TAB <key> TAB <value>
load_config() {
  [ -f "$WT_CONFIG" ] || die 2 "no config at $(tilde "$WT_CONFIG")" "wt help config"
  local parsed bad
  parsed=$(awk -v home="$HOME" '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    /^[ \t]*(#|$)/ { next }
    /^[ \t]*\[.*\][ \t]*$/ {
      sec = trim($0); sec = substr(sec, 2, length(sec) - 2); sub(/^~/, home, sec); sub(/\/$/, "", sec)
      print sec "\t@repo\t"; next
    }
    {
      i = index($0, "=")
      if (!i) { print "@error\t" NR "\t" trim($0); next }
      print (sec == "" ? "@global" : sec) "\t" trim(substr($0, 1, i - 1)) "\t" trim(substr($0, i + 1))
    }' "$WT_CONFIG")
  bad=$(awk -F'\t' -v keys=" $CFG_KEYS " '
    $1 == "@error"  { print "line " $2 " has no \"=\": " $3; next }
    $1 == "@global" { if ($2 != "branch_prefix") print "unknown global key \"" $2 "\""; next }
    $2 != "@repo" && index(keys, " " $2 " ") == 0 { print "unknown key \"" $2 "\" under [" $1 "]" }' <<<"$parsed")
  [ -z "$bad" ] || die 2 "$(tilde "$WT_CONFIG"): $(head -1 <<<"$bad")" "wt help config"
  BRANCH_PREFIX=$(awk -F'\t' '$1 == "@global" && $2 == "branch_prefix" { p = $3 } END { print p }' <<<"$parsed")
  BRANCH_PREFIX="${WT_BRANCH_PREFIX-${BRANCH_PREFIX:-$USER/}}"
  MAINS=$(awk -F'\t' '$2 == "@repo" { print $1 }' <<<"$parsed")
  CFG=$(awk -F'\t' '$1 !~ /^@/ && $2 != "@repo"' <<<"$parsed")
  [ -n "$MAINS" ] || die 2 "$(tilde "$WT_CONFIG") allows no repos" "wt help config"
}

cfg_values() { # cfg_values <main> <key>: the values, one per line, in file order
  awk -F'\t' -v m="$1" -v k="$2" '$1 == m && $2 == k { print $3 }' <<<"$CFG"
}

entry_for_main() { # prints <main> when the config allows it, else fails
  grep -qxF "$1" <<<"$MAINS" && printf '%s\n' "$1"
}

main_of_path() { # main checkout of any repo that holds <path>
  local common
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  dirname "$common"
}

entry_for_path() { # the allowed main checkout for a path inside it or one of its worktrees
  local main; main=$(main_of_path "$1") || return 1
  entry_for_main "$main"
}

entry_for_name() { # entry_for_name <repo>; prefers the workspace holding $PWD when names collide
  local hits n here
  hits=$(awk -v r="$1" '{ n = split($0, p, "/"); if (p[n] == r) print }' <<<"$MAINS")
  n=$(printf '%s' "$hits" | grep -c '' || true)
  [ "$n" = 0 ] && return 1
  [ "$n" = 1 ] && { printf '%s\n' "$hits"; return 0; }
  here=$(awk -v pwd="$PWD/" '{ ws = $0; sub(/\/[^\/]*$/, "", ws); if (index(pwd, ws "/") == 1) { print; exit } }' <<<"$hits")
  [ -n "$here" ] || die 2 "repo '$1' is in more than one workspace" "cd into the workspace you mean, then run wt again"
  printf '%s\n' "$here"
}

set_entry() { # set_entry <main> → E_MAIN E_REPO E_ROOT
  E_MAIN="$1"; E_REPO=$(basename "$1"); E_ROOT=$(dirname "$1")
  [ -e "$E_MAIN/.git" ] || die 2 "$(tilde "$E_MAIN") is not a git checkout" "git clone <url> $E_MAIN"
}

resolve() { # resolve <repo>/<slug> | <slug> | "" → E_* plus T_SLUG; a bare slug uses the repo at $PWD
  local main
  case "$1" in
    */*)
      main=$(entry_for_name "${1%%/*}") || die 2 "repo '${1%%/*}' is not in $(tilde "$WT_CONFIG")" "wt help config"
      T_SLUG="${1#*/}" ;;
    *)
      main=$(entry_for_path "$PWD") || die 2 "$(tilde "$PWD") is not inside an allowed repo, so name one: <repo>/<slug>" "wt ls --all"
      T_SLUG="$1" ;;
  esac
  set_entry "$main"
}

wt_path() { printf '%s\n' "$E_ROOT/$WT_DIR/$E_REPO/$1"; }

expand() { # expand <value> <slug>: fill {slug} {slug_id} {repo} {main} {path}
  local v="$1" slug="$2" id
  id=$(printf '%s' "$slug" | tr -c 'A-Za-z0-9_' '_')
  v=${v//\{slug_id\}/$id}; v=${v//\{slug\}/$slug}; v=${v//\{repo\}/$E_REPO}
  v=${v//\{main\}/$E_MAIN}; v=${v//\{path\}/$(wt_path "$slug")}
  printf '%s\n' "$v"
}

export_env() { # export each `env` entry of the current repo, expanded for <slug>
  local kv
  while IFS= read -r kv; do
    [ -n "$kv" ] || continue
    kv=$(expand "$kv" "$1")
    export "${kv%%=*}=${kv#*=}"
  done < <(cfg_values "$E_MAIN" env)
}

# ── helpers ──────────────────────────────────────────────────────────────────

slugify() { # branch or free text → directory-safe slug
  local s="${1#"$BRANCH_PREFIX"}"
  printf '%s\n' "$s" | tr '/' '-' | tr -c 'A-Za-z0-9._\n-' '-' | sed -E 's/-+/-/g; s/^-//; s/-$//'
}

default_ref() { # origin/<default branch>
  git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main
}

with_lock() { # serialize fetches when parallel subagents create worktrees at once
  local lock="$1/.git/wt.lock" i=0; shift
  until mkdir "$lock" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -ge 120 ] && { log "stale lock $lock; continuing"; break; }
    sleep 0.5
  done
  "$@"; local rc=$?
  rmdir "$lock" 2>/dev/null
  return $rc
}

is_worktree_of() { # is_worktree_of <main> <path>
  git -C "$1" worktree list --porcelain | grep -qxF "worktree $2"
}

ahead_of_default() { # commits on <rev> not in origin's default branch
  git -C "$1" rev-list --count "$(default_ref "$1")..$2" 2>/dev/null || echo "?"
}

# ── new ──────────────────────────────────────────────────────────────────────

copy_includes() { # copy_includes <main> <dest>; prints the number of files copied
  local main="$1" dest="$2" list n=0 f args=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -f "$main/$f" ]; then args="$args --exclude-from=$f"; else log "include file missing: $(tilde "$main/$f")"; fi
  done < <(cfg_values "$main" include)
  [ -n "$args" ] || { echo 0; return; }
  list=$(mktemp "${TMPDIR:-/tmp}/wt-include.XXXXXX")
  # Files that are untracked, match an include file, AND are gitignored.
  # shellcheck disable=SC2086 # $args is a list of --exclude-from flags
  (cd "$main" && git ls-files --others --ignored $args -z | git check-ignore -z --stdin) >"$list" 2>/dev/null || true
  n=$(tr -cd '\0' <"$list" | wc -c | tr -d ' ')
  [ "$n" -gt 0 ] && rsync -a --ignore-existing --from0 --files-from="$list" "$main/" "$dest/"
  rm -f "$list"
  printf '%s\n' "$n"
}

in_dir() { # in_dir <dir> <shell command>: run it there, under mise when mise is installed
  if command -v mise >/dev/null 2>&1; then
    (cd "$1" && mise exec -- sh -c "$2")
  else
    (cd "$1" && sh -c "$2")
  fi
}

run_steps() { # run_steps <key> <dir> <slug>: run each entry in order; stop at the first failure
  local key="$1" dir="$2" slug="$3" cmd logf t0
  logf="${TMPDIR:-/tmp}/wt-$E_REPO-$slug-$key.log"; : >"$logf"
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    cmd=$(expand "$cmd" "$slug"); t0=$SECONDS
    if in_dir "$dir" "$cmd" >>"$logf" 2>&1 </dev/null; then
      step "$key" "$cmd ✓ $((SECONDS - t0))s"
    else
      log "$key failed: $cmd (log: $logf)"
      log "fix: cd $dir && $cmd   # then: wt setup $E_REPO/$slug"; return 1
    fi
  done < <(cfg_values "$E_MAIN" "$key")
}

prepare() { # prepare <dest> <slug>: mise trust, env, setup steps, notes
  local dest="$1" slug="$2" kv rc=0
  if command -v mise >/dev/null 2>&1; then
    mise trust --quiet "$dest" >/dev/null 2>&1
    [ -f "$dest/mise.local.toml" ] && mise trust --quiet "$dest/mise.local.toml" >/dev/null 2>&1
  fi
  export_env "$slug"
  while IFS= read -r kv; do
    [ -n "$kv" ] || continue
    kv=$(expand "$kv" "$slug")
    if command -v mise >/dev/null 2>&1 && (cd "$dest" && mise set --file mise.local.toml "$kv" >/dev/null 2>&1); then
      step env "$kv (mise.local.toml)"
    else
      log "env not saved: $kv (needs mise)"; rc=1
    fi
  done < <(cfg_values "$E_MAIN" env)
  run_steps setup "$dest" "$slug" || rc=1
  while IFS= read -r kv; do [ -n "$kv" ] && step note "$(expand "$kv" "$slug")"; done < <(cfg_values "$E_MAIN" note)
  return $rc
}

cmd_new() {
  local target="" base="" branch="" do_setup=1 do_fetch=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) base="${2:?--base needs a ref}"; shift 2 ;;
      --branch) branch="${2:?--branch needs a branch name}"; shift 2 ;;
      --no-setup) do_setup=0; shift ;;
      --no-fetch) do_fetch=0; shift ;;
      -h|--help) help_new; exit 0 ;;
      -*) die 2 "unknown option $1" "wt new --help" ;;
      *) [ -z "$target" ] || die 2 "one target only" "wt new --help"; target="$1"; shift ;;
    esac
  done
  [ -n "$base" ] && [ -n "$branch" ] && die 2 "--base and --branch do not combine" "wt new --help"
  case "$target" in */) target="${target%/}" ;; esac
  [ -n "$target" ] || [ -n "$branch" ] || die 2 "missing <repo>/<slug>" "wt new web/my-change"
  resolve "$target"
  local slug="$T_SLUG" dest
  [ -n "$slug" ] || { [ -n "$branch" ] && slug=$(slugify "$branch"); }
  [ -n "$slug" ] || die 2 "missing slug in '$target'" "wt new $E_REPO/my-change"
  [ "$slug" = "$(slugify "$slug")" ] || die 2 "slug '$slug' has characters outside A-Z a-z 0-9 . _ -" "wt new $E_REPO/$(slugify "$slug")"
  dest=$(wt_path "$slug")
  [ -e "$dest" ] && die 2 "$(tilde "$dest") already exists" "wt path $E_REPO/$slug"
  mkdir -p "$(dirname "$dest")"

  if [ "$do_fetch" = 1 ]; then
    step fetch "origin ($E_REPO)"
    with_lock "$E_MAIN" git -C "$E_MAIN" fetch --quiet --prune origin || log "fetch failed; continuing with local refs"
  fi

  if [ -n "$branch" ]; then
    if git -C "$E_MAIN" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$E_MAIN" worktree add --quiet "$dest" "$branch" >&2 || die 1 "git worktree add failed" "git -C $E_MAIN worktree list"
    elif git -C "$E_MAIN" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$E_MAIN" worktree add --quiet --track -b "$branch" "$dest" "origin/$branch" >&2 || die 1 "git worktree add failed" "git -C $E_MAIN worktree list"
    else
      die 2 "no branch '$branch' locally or on origin" "git -C $E_MAIN branch -a | grep -F '$branch'"
    fi
  else
    branch="$BRANCH_PREFIX$slug"
    git -C "$E_MAIN" show-ref --verify --quiet "refs/heads/$branch" &&
      die 2 "branch $branch already exists" "wt new $E_REPO/$slug --branch $branch"
    base="${base:-$(default_ref "$E_MAIN")}"
    git -C "$E_MAIN" worktree add --quiet --no-track -b "$branch" "$dest" "$base" >&2 ||
      die 1 "git worktree add failed" "git -C $E_MAIN worktree list"
  fi
  step add "$(tilde "$dest")"
  step branch "$branch${base:+ from $base}"

  step copy "$(copy_includes "$E_MAIN" "$dest") files from .worktreeinclude"
  local rc=0
  if [ "$do_setup" = 1 ]; then prepare "$dest" "$slug" || rc=1; fi
  printf '%s\n' "$dest"
  return $rc
}

# ── rm / path ────────────────────────────────────────────────────────────────

remove_worktree() { # remove_worktree <main> <path> <force 0|1> <delete-branch auto|yes|no>
  local main="$1" wt="$2" force="$3" del="$4" branch n
  branch=$(git -C "$wt" branch --show-current 2>/dev/null)
  # An allowed repo's teardown runs first; a failure warns and removal goes on.
  if entry_for_main "$main" >/dev/null && [ -n "$(cfg_values "$main" teardown)" ]; then
    ( set_entry "$main"; export_env "$(basename "$wt")"; run_steps teardown "$wt" "$(basename "$wt")" ) ||
      log "teardown incomplete for $(tilde "$wt"); removing it anyway"
  fi
  if [ "$force" = 1 ]; then
    git -C "$main" worktree remove --force "$wt" >&2 || return 1
  else
    git -C "$main" worktree remove "$wt" >&2 || return 1
  fi
  step removed "$(tilde "$wt")"
  [ -n "$branch" ] || return 0
  n=$(ahead_of_default "$main" "$branch")
  if [ "$del" = yes ] || { [ "$del" = auto ] && [ "$n" = 0 ]; }; then
    git -C "$main" branch -D --quiet "$branch" >&2 && step branch "deleted $branch"
  else
    step branch "kept $branch ($n commits past $(default_ref "$main"))"
  fi
}

cmd_rm() {
  local target="" force=0 del=auto
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift ;;
      --delete-branch) del=yes; shift ;;
      --keep-branch) del=no; shift ;;
      -h|--help) help_rm; exit 0 ;;
      -*) die 2 "unknown option $1" "wt rm --help" ;;
      *) target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || die 2 "missing <repo>/<slug>" "wt ls"
  resolve "$target"
  local wt; wt=$(wt_path "$T_SLUG")
  [ -n "$T_SLUG" ] && is_worktree_of "$E_MAIN" "$wt" || die 2 "$(tilde "$wt") is not a worktree of $E_REPO" "wt ls"
  if [ "$force" = 0 ] && [ -n "$(git -C "$wt" status --porcelain)" ]; then
    die 2 "$E_REPO/$T_SLUG has uncommitted changes" "git -C $wt status   # then: wt rm $E_REPO/$T_SLUG --force"
  fi
  remove_worktree "$E_MAIN" "$wt" "$force" "$del" || die 1 "git worktree remove failed" "git -C $E_MAIN worktree list"
}

cmd_path() {
  case "${1:-}" in
    -h|--help) help_path; exit 0 ;;
    "") die 2 "missing <repo>/<slug>" "wt ls" ;;
  esac
  resolve "$1"
  local wt; wt=$(wt_path "$T_SLUG")
  [ -n "$T_SLUG" ] && [ -d "$wt" ] || die 2 "no worktree $E_REPO/$T_SLUG" "wt ls"
  printf '%s\n' "$wt"
}

# ── ls / prune ───────────────────────────────────────────────────────────────

scope_mains() { # allowed mains in scope: the workspace holding $PWD, or all with --all / outside any
  local here
  if [ "${ALL:-0}" = 0 ]; then
    here=$(awk -v pwd="$PWD/" '{ ws = $0; sub(/\/[^\/]*$/, "", ws); if (index(pwd, ws "/") == 1) print }' <<<"$MAINS")
    [ -n "$here" ] && { printf '%s\n' "$here"; return; }
  fi
  printf '%s\n' "$MAINS"
}

records() { # one JSON object per linked worktree of each repo in scope
  local root repo main prs wt branch dirty ahead age gitdir now
  now=$(date +%s)
  scope_mains | while IFS= read -r main; do
    root=$(dirname "$main"); repo=$(basename "$main")
    [ -e "$main/.git" ] || continue
    prs='[]'
    if [ "${NO_PR:-0}" = 0 ] && command -v gh >/dev/null 2>&1; then
      prs=$(cd "$main" && gh pr list --state all --limit 300 --json number,state,headRefName 2>/dev/null </dev/null) || prs='[]'
    fi
    git -C "$main" worktree list --porcelain | awk '/^worktree /{print substr($0, 10)}' | while IFS= read -r wt; do
      [ "$wt" = "$main" ] && continue
      [ -d "$wt" ] || continue
      branch=$(git -C "$wt" branch --show-current 2>/dev/null)
      dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      ahead=$(git -C "$wt" rev-list --count "$(default_ref "$main")..HEAD" 2>/dev/null || echo -1)
      gitdir=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null)
      age=$(( (now - $(stat -f %B "$gitdir" 2>/dev/null || echo "$now")) / 3600 ))
      jq -cn --arg ws "$root" --arg repo "$repo" --arg path "$wt" --arg wtroot "$root/$WT_DIR/$repo/" --arg branch "$branch" \
        --argjson dirty "$dirty" --argjson ahead "$ahead" --argjson age "$age" --argjson prs "$prs" '
        ($prs | map(select(.headRefName == $branch and $branch != "")) | first) as $pr
        | { workspace: $ws, repo: $repo,
            slug: (if ($path | startswith($wtroot)) then ($path | ltrimstr($wtroot)) else null end),
            path: $path, inside: ($path | startswith($wtroot)),
            branch: (if $branch == "" then null else $branch end),
            dirty: $dirty, ahead: $ahead, age_hours: $age,
            pr: (if $pr then {number: $pr.number, state: $pr.state} else null end) }'
    done
  done
}

cmd_ls() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --no-pr) NO_PR=1; shift ;;
      --all) ALL=1; shift ;;
      -h|--help) help_ls; exit 0 ;;
      *) die 2 "unknown argument $1" "wt ls --help" ;;
    esac
  done
  local rows; rows=$(records | jq -s '.')
  if [ "$json" = 1 ]; then printf '%s\n' "$rows"; return; fi
  if [ "$(jq length <<<"$rows")" = 0 ]; then log "no worktrees"; return; fi
  jq -r --arg home "$HOME" '
    (map(.workspace) | unique | length > 1) as $many
    | (["TARGET","BRANCH","PR","AHEAD","DIRTY"] | @tsv),
    (.[] | [ ((if $many then "\(.workspace | split("/") | last):" else "" end)
              + (if .inside then "\(.repo)/\(.slug)" else "\(.repo): \(.path | sub("^" + $home; "~")) (outside)" end)),
             (.branch // "(detached)"),
             (if .pr then "#\(.pr.number) \(.pr.state | ascii_downcase)" else "-" end),
             (.ahead | tostring), (.dirty | tostring) ] | @tsv)' <<<"$rows" | column -t -s "$TAB"
}

cmd_prune() {
  local yes=0 force=0 min_age=24
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --force) force=1; shift ;;
      --all) ALL=1; shift ;;
      --min-age) min_age="${2:?--min-age needs hours}"; shift 2 ;;
      -h|--help) help_prune; exit 0 ;;
      *) die 2 "unknown argument $1" "wt prune --help" ;;
    esac
  done
  need gh
  local plan main
  plan=$(records | jq -c --argjson force "$force" --argjson min "$min_age" '
    select(.inside)
    | (if .pr and (.pr.state == "MERGED" or .pr.state == "CLOSED") then "#\(.pr.number) \(.pr.state | ascii_downcase)"
       elif .pr == null and .ahead == 0 and .dirty == 0 and .age_hours >= $min then "empty, \(.age_hours)h old"
       else null end) as $why
    | select($why)
    | . + {why: $why, skip: (if .dirty > 0 and ($force | not) then "\(.dirty) uncommitted changes" else null end)}')
  scope_mains | while IFS= read -r main; do git -C "$main" worktree prune 2>/dev/null; done
  [ -n "$plan" ] || { log "nothing to prune"; return 0; }

  if [ "$yes" = 0 ]; then
    log "would remove (dry run):"
    jq -r '"  \(.repo)/\(.slug)\t\(.why)\(if .skip then "\tSKIP: \(.skip)" else "" end)"' <<<"$plan" | column -t -s "$TAB" >&2
    log "fix: wt prune --yes   # also deletes each local branch, and the origin branch when its PR merged or closed"
    return 0
  fi

  local rc=0 main path branch skip state
  while IFS="$TAB" read -r main path branch skip state; do
    [ -n "$skip" ] && { log "skip    $(tilde "$path"): $skip (use --force)"; continue; }
    remove_worktree "$main" "$path" 1 yes </dev/null || { log "failed  $path"; rc=1; continue; }
    if [ -n "$branch" ] && { [ "$state" = MERGED ] || [ "$state" = CLOSED ]; } &&
      git -C "$main" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 </dev/null; then
      git -C "$main" push --quiet origin --delete "$branch" </dev/null >&2 && step remote "deleted origin/$branch"
    fi
  done < <(jq -r '["\(.workspace)/\(.repo)", .path, (.branch // ""), (.skip // ""), (.pr.state // "")] | @tsv' <<<"$plan")
  return $rc
}

# ── setup ────────────────────────────────────────────────────────────────────

cmd_setup() { # re-apply the repo's rules to an existing worktree
  case "${1:-}" in -h|--help) help_setup; exit 0 ;; esac
  local wt slug="" main
  if [ -n "${1:-}" ]; then
    resolve "$1"; slug="$T_SLUG"
  else
    main=$(entry_for_path "$PWD") || die 2 "$(tilde "$PWD") is not inside an allowed repo" "wt setup <repo>/<slug>"
    set_entry "$main"
    case "$PWD/" in "$E_ROOT/$WT_DIR/$E_REPO/"*) slug="${PWD#"$E_ROOT/$WT_DIR/$E_REPO/"}"; slug="${slug%%/*}" ;; esac
    [ -n "$slug" ] || die 2 "$(tilde "$PWD") is not inside a worktree of $E_REPO" "wt setup $E_REPO/<slug>"
  fi
  wt=$(wt_path "$slug")
  [ -n "$slug" ] && is_worktree_of "$E_MAIN" "$wt" || die 2 "no worktree $E_REPO/$slug" "wt ls"
  step copy "$(copy_includes "$E_MAIN" "$wt") files from include entries (existing files kept)"
  prepare "$wt" "$slug" || exit 1
}

# ── info ─────────────────────────────────────────────────────────────────────

cmd_info() { # the rules wt applies to one repo's worktrees, expanded for the current one
  case "${1:-}" in -h|--help) help_info; exit 0 ;; esac
  local main slug="<slug>" k v
  if [ -n "${1:-}" ]; then
    main=$(entry_for_name "${1%%/*}") || die 2 "repo '${1%%/*}' is not in $(tilde "$WT_CONFIG")" "wt ls --all"
    case "$1" in */*) slug="${1#*/}" ;; esac
  else
    main=$(entry_for_path "$PWD") || die 2 "$(tilde "$PWD") is not inside an allowed repo" "wt info <repo>"
    case "$PWD/" in "$(dirname "$main")/$WT_DIR/$(basename "$main")/"*)
      slug="${PWD#"$(dirname "$main")/$WT_DIR/$(basename "$main")/"}"; slug="${slug%%/*}" ;;
    esac
  fi
  set_entry "$main"
  printf 'repo       %s\n' "$(tilde "$E_MAIN")"
  printf 'worktrees  %s\n' "$(tilde "$E_ROOT/$WT_DIR/$E_REPO")/"
  for k in include env setup teardown note; do
    while IFS= read -r v; do [ -n "$v" ] && printf '%-10s %s\n' "$k" "$(expand "$v" "$slug")"; done < <(cfg_values "$E_MAIN" "$k")
  done
}

# ── harness hooks ────────────────────────────────────────────────────────────

claude_default_create() { # <main> <slug> <cwd> <base_mode>: Claude Code's own layout, for repos wt does not manage
  local main="$1" slug="$2" cwd="$3" mode="$4" dest base
  dest="$main/.claude/worktrees/$slug"
  is_worktree_of "$main" "$dest" && { printf '%s\n' "$dest"; return 0; }
  if [ "$mode" = head ]; then
    base=$(git -C "$cwd" rev-parse HEAD)
  elif git -C "$main" remote get-url origin >/dev/null 2>&1; then
    with_lock "$main" git -C "$main" fetch --quiet origin >&2 || log "fetch failed; continuing with local refs"
    base=$(default_ref "$main")
  else
    base=$(git -C "$main" rev-parse HEAD)
  fi
  git -C "$main" worktree add --quiet -b "worktree-$slug" "$dest" "$base" >&2 || return 1
  step copy "$(copy_includes "$main" "$dest") files from .worktreeinclude"
  printf '%s\n' "$dest"
}

claude_create() { # stdin: {"name", "cwd", ...}; stdout: the worktree path, nothing else
  local input name cwd main mode slug dest rc
  input=$(cat)
  name=$(jq -r '.name // empty' <<<"$input"); cwd=$(jq -r '.cwd // empty' <<<"$input")
  cwd="${cwd:-$PWD}"
  [ -n "$name" ] || die 1 "WorktreeCreate input has no name"
  main=$(main_of_path "$cwd") || die 1 "$(tilde "$cwd") is not in a git repo"
  slug=$(slugify "$name")
  # Honor the repo's committed worktree.baseRef: "head" branches from the
  # session's current commit (so a subagent sees its parent's work); anything
  # else branches from a fresh origin default branch, as Claude does.
  mode=$(jq -r '.worktree.baseRef // "fresh"' "$main/.claude/settings.json" 2>/dev/null || echo fresh)

  if ! entry_for_main "$main" >/dev/null; then
    claude_default_create "$main" "$slug" "$cwd" "$mode" || exit 1
    return 0
  fi
  set_entry "$main"
  dest=$(wt_path "$slug")
  # `claude --worktree <name>` run twice re-enters the same worktree.
  if is_worktree_of "$E_MAIN" "$dest"; then printf '%s\n' "$dest"; return 0; fi
  cd "$cwd" || exit 1
  if [ "$mode" = head ]; then
    cmd_new "$E_REPO/$slug" --base "$(git rev-parse HEAD)" --no-fetch >&2
  else
    cmd_new "$E_REPO/$slug" >&2
  fi
  rc=$?
  # A failed setup still leaves a usable checkout; Claude gets the path either way.
  [ -d "$dest" ] || exit 1
  [ $rc = 0 ] || log "wt: setup incomplete in $dest (see the fix line above)"
  printf '%s\n' "$dest"
}

claude_remove() { # stdin: {"worktree_path", ...}
  local input wt main
  input=$(cat)
  wt=$(jq -r '.worktree_path // empty' <<<"$input")
  [ -n "$wt" ] && [ -d "$wt" ] || exit 0
  main=$(main_of_path "$wt") || die 1 "$(tilde "$wt") is not a git worktree"
  # Claude already asked the user about uncommitted changes before this fires.
  remove_worktree "$main" "$wt" 1 auto || exit 1
}

cmd_hook() { # hook <harness> <event>
  case "${1:-}" in -h|--help) help_hook; exit 0 ;; esac
  case "${1:-}:${2:-}" in
    claude:create) claude_create ;;
    claude:remove) claude_remove ;;
    *) die 2 "unknown hook '${1:-} ${2:-}'" "wt hook --help" ;;
  esac
}

# ── integrations ─────────────────────────────────────────────────────────────

INTEGRATION_VERSION=1
INTEGRATIONS="claude"
SHIM_NAME="wt-worktree.sh"

claude_dir() { printf '%s\n' "${CONFIG_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"; }

shim_text() { cat <<EOF
#!/bin/sh
# installed by wt
# managed by wt; reinstalling or updating the integration overwrites this file.
# add custom hooks beside this file instead of editing it.
# WT_INTEGRATION_ID=$1
# WT_INTEGRATION_VERSION=$INTEGRATION_VERSION

# Routes the harness's WorktreeCreate/WorktreeRemove events through wt, so its
# worktrees land beside the repos wt's config allows and other repos keep
# the harness's default layout.
wt="\${WT_BIN:-\$HOME/.local/bin/wt}"
if [ ! -x "\$wt" ]; then
  echo "$SHIM_NAME: \$wt is missing; reinstall it or run: wt integration uninstall $1" >&2
  exit 1
fi
exec "\$wt" hook $1 "\${1:-}"
EOF
}

write_through() { # write stdin to <file>, following a symlink so dotfiles links stay links
  local f="$1" tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/wt-write.XXXXXX")
  cat >"$tmp" && cat "$tmp" >"$f"; local rc=$?
  rm -f "$tmp"; return $rc
}

claude_cmd() { # the hook command, with $HOME kept symbolic when it applies
  local p="$1/hooks/$SHIM_NAME"
  case "$p" in "$HOME"/*) p="\$HOME/${p#"$HOME"/}" ;; esac
  printf 'sh "%s" %s\n' "$p" "$2"
}

integration_claude() { # install | uninstall | status
  local dir f shim registered v
  dir=$(claude_dir); f="$dir/settings.json"; shim="$dir/hooks/$SHIM_NAME"
  case "$1" in
    install)
      [ -d "$dir" ] || die 2 "$(tilde "$dir") does not exist" "wt integration install claude --config-dir <dir>"
      mkdir -p "$dir/hooks"
      shim_text claude | write_through "$shim" && chmod +x "$shim" || die 1 "could not write $shim"
      [ -s "$f" ] || echo '{}' >"$f"
      jq --arg c "$(claude_cmd "$dir" create)" --arg r "$(claude_cmd "$dir" remove)" --arg shim "$SHIM_NAME" '
        def strip: map(.hooks |= map(select(.command | contains($shim) | not))) | map(select(.hooks | length > 0));
        .hooks = (.hooks // {})
        | .hooks.WorktreeCreate = ((.hooks.WorktreeCreate // []) | strip) + [{hooks: [{type: "command", command: $c, timeout: 600}]}]
        | .hooks.WorktreeRemove = ((.hooks.WorktreeRemove // []) | strip) + [{hooks: [{type: "command", command: $r, timeout: 120}]}]
      ' "$f" | write_through "$f" || die 1 "could not update $f" "jq . $f"
      step install "claude · $(tilde "$shim") · $(tilde "$f")"
      log "claude --worktree, EnterWorktree and isolated subagents now go through wt" ;;
    uninstall)
      rm -f "$shim"
      if [ -f "$f" ]; then
        jq --arg shim "$SHIM_NAME" '
          def strip: map(.hooks |= map(select(.command | contains($shim) | not))) | map(select(.hooks | length > 0));
          if .hooks then
            .hooks |= (with_entries(if .key == "WorktreeCreate" or .key == "WorktreeRemove" then .value |= strip else . end)
                       | with_entries(select(.value != [])))
            | if .hooks == {} then del(.hooks) else . end
          else . end' "$f" | write_through "$f" || die 1 "could not update $f" "jq . $f"
      fi
      step uninstall "claude · $(tilde "$dir")" ;;
    status)
      v=$(sed -n 's/^# WT_INTEGRATION_VERSION=//p' "$shim" 2>/dev/null)
      registered=$(jq -r --arg shim "$SHIM_NAME" '[.hooks.WorktreeCreate, .hooks.WorktreeRemove] | map((. // []) | map(.hooks[]?.command) | any(contains($shim))) | if all then "yes" elif any then "partial" else "no" end' "$f" 2>/dev/null || echo no)
      if [ -z "$v" ] && [ "$registered" = no ]; then printf 'claude\t%s\tnot installed\n' "$(tilde "$dir")"
      elif [ "$v" = "$INTEGRATION_VERSION" ] && [ "$registered" = yes ]; then printf 'claude\t%s\tinstalled (v%s)\n' "$(tilde "$dir")" "$v"
      else printf 'claude\t%s\tbroken: script %s, settings %s\tfix: wt integration install claude --config-dir %s\n' "$(tilde "$dir")" "${v:+v$v}${v:-missing}" "$registered" "$(tilde "$dir")"
      fi ;;
  esac
}

cmd_integration() { # integration install|uninstall|status [<harness>] [--config-dir <dir>]
  local action="${1:-}" target="" ; [ $# -gt 0 ] && shift
  case "$action" in -h|--help|"") help_integration; exit 0 ;; install|uninstall|status) ;; *) die 2 "unknown action '$action'" "wt integration --help" ;; esac
  while [ $# -gt 0 ]; do
    case "$1" in
      --config-dir) CONFIG_DIR="${2:?--config-dir needs a folder}"; CONFIG_DIR="${CONFIG_DIR/#\~/$HOME}"; shift 2 ;;
      -h|--help) help_integration; exit 0 ;;
      -*) die 2 "unknown option $1" "wt integration --help" ;;
      *) target="$1"; shift ;;
    esac
  done
  if [ "$action" = status ] && [ -z "$target" ]; then
    for target in $INTEGRATIONS; do "integration_$target" status; done | column -t -s "$TAB"; return
  fi
  case " $INTEGRATIONS " in *" $target "*) ;; *) die 2 "unknown harness '${target}' (supported: $INTEGRATIONS)" "wt integration --help" ;; esac
  "integration_$target" "$action"
}

# ── help ─────────────────────────────────────────────────────────────────────

help_main() { cat <<EOF
usage: wt <verb> [args]      (wt <verb> --help for each)

git worktrees beside their repos, for the repos $(tilde "$WT_CONFIG") allows:
  <workspace>/$WT_DIR/<repo>/<slug>

verbs
  new <target>      make a worktree ready to run; prints its path
  path <target>     print the path of an existing worktree
  setup [<target>]  re-apply the repo's rules to an existing worktree
  info [<repo>]     the rules wt applies to that repo's worktrees (default: here)
  ls                linked worktrees of each allowed repo, with PR state
  rm <target>       remove one worktree
  prune             remove worktrees whose PR merged or closed (dry run first)
  integration install|uninstall|status [<harness>]
                    route a harness's own worktrees through wt (harnesses: claude)
  hook <harness> create|remove   what an installed integration calls
  help config       the config format

<target> is <repo>/<slug>, or just <slug> inside an allowed repo or its worktree.
stdout is data; progress and errors go to stderr.
exit 0 ok · 1 a step failed · 2 bad usage or a precondition; non-zero prints fix:
env  WT_CONFIG=$(tilde "$WT_CONFIG")  WT_BRANCH_PREFIX overrides branch_prefix
EOF
}

help_config() { cat <<EOF
$(tilde "$WT_CONFIG")

Only the repos listed here get worktrees beside them, ls, prune and info.
A [section] is the path of a main checkout; its worktrees go to
<parent>/$WT_DIR/<repo>/<slug>. Each key may repeat; entries apply in file order.

  branch_prefix = kevinpruett/        global keys go above the first section

  [~/work/suppco/web]
  include  = .worktreeinclude         gitignored files to copy (a pattern file in the repo)
  env      = WEB_PORT=3101            written to the worktree's mise.local.toml
  setup    = pnpm install --frozen-lockfile
  teardown = echo bye                 runs in the worktree before wt removes it
  note     = Run the dev server on 3001 only.

setup and teardown run with sh -c in the worktree, under mise when it is
installed, with the env entries exported. setup stops at the first failure.
Values expand {slug}, {slug_id} (slug with _ for -), {repo}, {main}, {path}.
A note prints after wt new and in wt info.
EOF
}

help_new() { cat <<EOF
usage: wt new <target> [--base <ref>] [--no-fetch] [--no-setup]
       wt new [<target>] --branch <existing-branch>

makes <workspace>/$WT_DIR/<repo>/<slug> and gets it ready to run:
  1. fetch origin (skip with --no-fetch)
  2. git worktree add: a new branch $BRANCH_PREFIX<slug> from --base
     (default: origin's default branch), or check out --branch, tracking
     origin/<branch> when it exists only there. With --branch the slug
     defaults to the branch name without "$BRANCH_PREFIX", / turned into -.
  3. copy the gitignored files that the repo's include entries list
  4. mise trust, write the env entries, run the setup entries in order,
     then print the notes (wt help config)

--base resolves in the main checkout: to branch from the worktree you are
in, pass a commit: --base "\$(git rev-parse HEAD)".

prints: the worktree path as the only stdout line
exit 1: setup failed; the worktree exists and the path is still printed
exit 2: the path or branch already exists · unknown branch · bad slug
EOF
}

help_setup() { cat <<EOF
usage: wt setup [<target>]

re-applies the repo's config rules to an existing worktree (default: the one
holding the current directory): copies include files that are missing (keeps
existing ones), mise trust, env, every setup entry in order, notes. Use it
after fixing whatever made a setup step fail during wt new.
exit 1: a setup entry failed (fix: line names it) · exit 2: no such worktree
EOF
}

help_info() { cat <<EOF
usage: wt info [<repo>[/<slug>]]

prints the config entries for that repo (default: the one holding the current
directory), with {slug} and the other placeholders filled in when you are in a
worktree or name one: include · env · setup · teardown · note.
EOF
}

help_path() { cat <<EOF
usage: wt path <target>

prints: the absolute path of that worktree. exit 2 when it does not exist.
EOF
}

help_ls() { cat <<EOF
usage: wt ls [--all] [--json] [--no-pr]

lists linked worktrees of the allowed repos in the workspace that holds the
current directory, or of every workspace with --all or outside any of them.
Worktrees outside <workspace>/$WT_DIR show as "(outside)": made by hand or
by an older layout.
columns: TARGET · BRANCH · PR (latest for the branch, via gh)
         · AHEAD (commits past origin's default branch) · DIRTY (changed files)
--json   an array of {workspace, repo, slug (null when outside), path, inside,
         branch, dirty, ahead, age_hours, pr: {number, state} | null}
--no-pr  skip the gh lookups (faster, offline)
EOF
}

help_rm() { cat <<EOF
usage: wt rm <target> [--force] [--delete-branch | --keep-branch]

removes the worktree. The local branch is deleted when it has no commits past
origin's default branch, else kept; --delete-branch / --keep-branch override.
exit 2: uncommitted changes (pass --force to discard them) · no such worktree
EOF
}

help_prune() { cat <<EOF
usage: wt prune [--yes] [--force] [--all] [--min-age <hours>]

picks worktrees under <workspace>/$WT_DIR (scope as in wt ls) that are done:
  · the branch's latest PR is merged or closed, or
  · it has no PR, no commits past origin's default branch, no changes,
    and is at least --min-age hours old (default 24)
without --yes: prints the plan and changes nothing.
with --yes: removes each worktree and its local branch, and deletes
  origin/<branch> when its PR merged or closed. A worktree with uncommitted
  changes is skipped unless --force. "(outside)" worktrees are never touched.
EOF
}

help_hook() { cat <<EOF
usage: wt hook claude create|remove      (stdin: Claude Code hook JSON)

The managed script that \`wt integration install claude\` writes calls this.
create  reads {name, cwd}. In an allowed repo: runs "new <repo>/<name>" and
        prints its path. In any other repo: Claude Code's default layout,
        <repo>/.claude/worktrees/<name> on branch worktree-<name>, with the
        .worktreeinclude copy and no setup. Base: the session's HEAD when the
        repo's .claude/settings.json sets worktree.baseRef "head", else
        origin's default branch. An existing worktree of that name is
        re-entered. The path is the last stdout line.
remove  reads {worktree_path}; removes it with --force; keeps the branch when
        it has commits.
Claude Code never fires remove when a subagent finishes: run wt prune.
EOF
}

help_integration() { cat <<EOF
usage: wt integration install|uninstall <harness> [--config-dir <dir>]
       wt integration status [<harness>] [--config-dir <dir>]

harnesses: $INTEGRATIONS
claude  writes <dir>/hooks/$SHIM_NAME (managed by wt; reinstall overwrites it)
        and registers it for WorktreeCreate and WorktreeRemove in
        <dir>/settings.json. <dir> is --config-dir, else \$CLAUDE_CONFIG_DIR,
        else ~/.claude. Run once per Claude profile. Writes follow symlinks,
        so a settings.json linked from dotfiles stays a link.
The hooks apply in every repo: allowed repos get wt worktrees; other repos get
Claude Code's default layout.
EOF
}

# ── dispatch ─────────────────────────────────────────────────────────────────

verb="${1:-help}"; [ $# -gt 0 ] && shift
case "$verb" in
  help|-h|--help)
    case "${1:-}" in
      config) help_config; exit 0 ;;
      new|path|ls|rm|prune|hook|integration|info|setup) BRANCH_PREFIX="<prefix>/"; [ -f "$WT_CONFIG" ] && load_config; "help_$1"; exit 0 ;;
      *) help_main; exit 0 ;;
    esac ;;
esac
need git; need jq
load_config
case "$verb" in
  new) need rsync; cmd_new "$@" ;;
  path) cmd_path "$@" ;;
  info) cmd_info "$@" ;;
  setup) cmd_setup "$@" ;;
  ls) cmd_ls "$@" ;;
  rm) cmd_rm "$@" ;;
  prune) cmd_prune "$@" ;;
  hook) cmd_hook "$@" ;;
  integration) cmd_integration "$@" ;;
  *) die 2 "unknown verb '$verb'" "wt help" ;;
esac
