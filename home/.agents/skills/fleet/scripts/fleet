    "--verdict": { choices: VERDICTS, required: true }, "--text": {}, "--choice": {},
    "--no-send": { bool: true, help: "record only, no inbox message" } } },
  stats: { fn: cmdStats, help: "JSON for the Fleet tab: agents' status, context and API-rate cost (prices.json)" },
