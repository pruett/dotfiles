#!/usr/bin/env node
// fleet: the CEO's agent fleet on Herdr — its shared state and launcher. `fleet --help` prints DOC.
"use strict";
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const crypto = require("node:crypto");
const { spawnSync } = require("node:child_process");

const DOC = `fleet: the CEO's agent fleet on Herdr — its shared state and launcher.

Roles (roles.json beside this script): the Chief of Staff (\`cos\`) passes messages
between you and the leads; a \`lead\` runs one project; workers (implementer, researcher,
tester, reviewer, cloud-agent) each do one chunk for a lead. You talk only to the CoS. Anything
that needs your judgment is a queue item, answered in the Fleet panel's Queue tab in HQ.

A project's life:
  fleet project new <p> --brief "<your words>"   status aligning: its lead writes the PRD
  fleet report --kind prd                        the lead asks the CoS to sign the PRD
  fleet project approve <p>                      status active: the lead may start workers
  fleet project goal <p> "<more>"                new work: back to aligning
  fleet project park <p> --reason "..."          status parked: waits on people; \`project start\` resumes
  fleet project close <p>                        status closed: lead and workers stop

A fleet lives in a work root, the folder your repos sit under (one folder per company or
group): \`fleet init\` there makes <work root>/.fleet. Commands find it from $FLEET_HOME, else the
nearest .fleet at or above the current folder, else the fleet whose HQ \`fleet up\` last opened
(~/.local/state/fleet-hq, for the Fleet panel and bridges). Make as many as you like; one runs
HQ at a time, since the CoS is always \`cos\`.

  <work root>/.fleet ($FLEET_HOME)
    config.env                   optional settings (\`fleet config\`)
    playbook.md                  your rules; in every CoS and lead prompt
    projects/<p>/brief.md        your words, dated; only added to
    projects/<p>/prd.md      the lead's spec: PRD, Standing orders, Now, Plan, Stuck, Done
    projects/<p>/decisions.md    dated decisions, newest last
    projects/<p>/project.json    name, lead, status (aligning|active|parked|closed), the approved PRD's hash
    inbox/<id>.json              a message for the CoS; inbox/done/ once handled
    queue/<id>.json, queue/<id>/ one item for you, and its attachments

Terminals (hc names): the CoS is \`cos\`; a lead is \`lead-<p>\`; a worker \`<key>-<role>-<slug>\`, where <key> is <p>, or its initials when <p> is over 12 characters.
Nothing types into the CoS's pane, which is yours: leads report with \`fleet report\` and your
answers go through \`fleet answer\`; both land in the inbox. The CoS talks to leads with \`fleet send\`.

Every agent starts through \`fleet exec <role>\`, which sets FLEET_HOME, FLEET_WORK_ROOT (the work root),
FLEET_ROLE, FLEET_PROJECT_DIR (leads and workers) and CLAUDE_CONFIG_DIR. Commands check
FLEET_ROLE: only a lead starts workers, only the CoS forwards drafts.

stdout carries data (ids, paths, JSON with --json); progress goes to stderr.
Exit 0 ok, 1 a step failed, 2 bad usage or a missing precondition.`;

const expand = (p) => {
  const s = p.replace(/^~(?=$|\/)/, os.homedir());
  return s.length > 1 ? path.normalize(s).replace(/\/+$/, "") : s;
};

const STATE_DIR = ".fleet"; // a fleet's state folder, inside its work root
const HQ_FILE = path.join(os.homedir(), ".local/state/fleet-hq"); // the state folder of the fleet whose HQ runs

// This fleet's state folder: $FLEET_HOME, else the nearest .fleet at or above here, else
// the one running HQ (the panel and bridges start outside any work root). null when none.
function findHome() {
  if (process.env.FLEET_HOME) return expand(process.env.FLEET_HOME);
  for (let d = process.cwd(); ; d = path.dirname(d)) {
    if (isDir(path.join(d, STATE_DIR))) return path.join(d, STATE_DIR);
    if (d === path.dirname(d)) break;
  }
  try {
    const h = fs.readFileSync(HQ_FILE, "utf8").trim();
    if (isDir(h)) return h;
  } catch {}
  return null;
}

let HOME = findHome(); // set by `fleet init`; every other command except `roles` needs one
const workRoot = () => path.dirname(HOME);
const COS = "cos"; // the CoS terminal's hc name
const HQ_SPACE = "fleet-hq"; // herdr.space label for the CoS's space
const PRIORITIES = ["p0", "p1", "p2", "p3"];
const KINDS = ["decision", "review", "approval", "fyi", "idea"];
const REPORT_KINDS = ["prd", "done", "stuck", "decision", "fyi"]; // what a lead's `fleet report` says
const VERDICTS = ["approve", "changes", "feedback", "choose", "reject"];
const NAME_RE = /^[a-z0-9][a-z0-9-]{0,26}$/; // lead-<name> must fit hc's 32-character names
const PRD_FIELDS = ["Goal", "Done when", "Repos", "Worktrees", "Scope", "Verification"];
const ROLE = process.env.FLEET_ROLE || "you"; // who is running this command
const LEADERS = ["cos", "lead"]; // roles started by `fleet up` and `fleet project`, never `fleet run`

// This fleet's optional settings, kept in $FLEET_HOME/config.env: name -> [what it is, default].
const SETTINGS = {
  FLEET_CLAUDE_CONFIG_DIR: ["the Claude Code config folder agents start with (CLAUDE_CONFIG_DIR); " +
    "\"default\" leaves it unset, so Claude uses ~/.claude and ~/.claude.json. Name a folder only for " +
    "a second profile", "default"],
  FLEET_EMOJI: ["the emoji that starts this fleet's HQ space title, to tell fleets apart; `fleet init` picks one at random", ""],
};
const EMOJIS = ["⛵", "🚤", "🛥️", "🚢", "⚓", "🛶", "🐙", "🐋", "🦈", "🧭", "🌊", "🏝️"];

// This fleet's emoji, picked at random and saved the first time it is asked for.
function emoji() {
  const cfg = config();
  if (!cfg.FLEET_EMOJI) {
    cfg.FLEET_EMOJI = EMOJIS[crypto.randomInt(EMOJIS.length)];
    saveConfig(cfg);
  }
  return cfg.FLEET_EMOJI;
}

class Fail extends Error {
  constructor(msg, code = 1) {
    super(msg);
    this.code = code;
  }
}

const log = (msg) => process.stderr.write(msg + "\n");
const out = (msg) => process.stdout.write(msg + "\n");
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const exists = (p) => fs.existsSync(p);
const pad = (s, n) => String(s ?? "").padEnd(n);
const round4 = (x) => Math.round(x * 1e4) / 1e4;
const hex2 = () => crypto.randomBytes(2).toString("hex");
const sha = (s) => crypto.createHash("sha256").update(s).digest("hex").slice(0, 16);

function stamp(fmt) {
  const d = new Date(), z = (n) => String(n).padStart(2, "0");
  return fmt.replace(/%([YmdHMS])/g, (_, c) =>
    ({ Y: d.getFullYear(), m: z(d.getMonth() + 1), d: z(d.getDate()), H: z(d.getHours()), M: z(d.getMinutes()), S: z(d.getSeconds()) })[c]);
}

function now() {
  const off = -new Date().getTimezoneOffset(), z = (n) => String(n).padStart(2, "0");
  return stamp("%Y-%m-%dT%H:%M:%S") + (off >= 0 ? "+" : "-") + z(Math.floor(Math.abs(off) / 60)) + ":" + z(Math.abs(off) % 60);
}

const readJson = (p) => JSON.parse(fs.readFileSync(p, "utf8"));

function writeJson(p, data) {
  const tmp = p + ".tmp";
  fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n");
  fs.renameSync(tmp, p); // atomic, so the panel never reads half a file
}

function run(prog, args, check) {
  const r = spawnSync(prog, args, { encoding: "utf8" });
  if (r.error) r.status = 127, r.stderr = String(r.error.message);
  r.stdout ??= "", r.stderr ??= "";
  if (check && r.status !== 0)
    throw new Fail(`${prog} ${args.slice(0, 2).join(" ")} failed: ${(r.stderr || r.stdout).trim()}`);
  return r;
}
const hc = (args, check = true) => run("hc", args, check);
const app = (args, check = true) => run("herdr-app", args, check);

function hcJson(...args) {
  const r = hc([...args, "--json"], false);
  if (r.status !== 0) return null;
  try { return JSON.parse(r.stdout); } catch { return null; }
}

// A terminal's status as one word: `hc get` gives {app, state}, `hc ls` a plain word.
function word(t) {
  if (!t) return "stopped";
  let st = t.status;
  if (st && typeof st === "object") st = st.state;
  return st || "live";
}

// The terminal record for a live terminal with this hc name, else null.
function live(name) {
  const t = hcJson("get", name);
  return t && t.state === "live" ? t : null;
}

// Refuse a command outside the roles allowed to run it ("you" is a person, the panel or a bridge).
function need(...roles) {
  if (!roles.includes(ROLE))
    throw new Fail(`only ${roles.map((r) => (r === "you" ? "you (no FLEET_ROLE)" : `the ${r}`)).join(" or ")} may run this; you are ${ROLE === "you" ? "not in a fleet role" : `the ${ROLE}`}`, 2);
}

function ensureHome() {
  for (const sub of ["projects", "queue", "inbox"]) fs.mkdirSync(path.join(HOME, sub), { recursive: true });
}

// This fleet's settings: config.env over the defaults, values with ~ expanded.
function config() {
  const cfg = Object.fromEntries(Object.entries(SETTINGS).map(([k, [, def]]) => [k, def]));
  const f = path.join(HOME, "config.env");
  for (const line of exists(f) ? fs.readFileSync(f, "utf8").split("\n") : []) {
    const i = line.indexOf("=");
    if (i >= 0 && line.slice(0, i).trim() in SETTINGS) cfg[line.slice(0, i).trim()] = expand(line.slice(i + 1).trim());
  }
  return cfg;
}

function saveConfig(cfg) {
  const lines = Object.entries(SETTINGS).map(([k, [desc]]) => `# ${desc}\n${k}=${cfg[k]}`);
  fs.writeFileSync(path.join(HOME, "config.env"), lines.join("\n") + "\n");
}

function isDir(p) {
  try { return fs.statSync(p).isDirectory(); } catch { return false; }
}

// ---- projects -------------------------------------------------------------------

const projDir = (name) => path.join(HOME, "projects", name);

function project(name) {
  const pj = path.join(projDir(name), "project.json");
  if (!exists(pj)) throw new Fail(`no project '${name}'; start one with: fleet project new ${name} --brief "..."`, 2);
  return readJson(pj);
}

const saveProject = (p) => writeJson(path.join(projDir(p.name), "project.json"), p);

function projects() {
  const dir = path.join(HOME, "projects");
  if (!isDir(dir)) return [];
  return fs.readdirSync(dir).sort()
    .map((n) => path.join(dir, n, "project.json")).filter(exists).map(readJson);
}

// The project this lead or worker belongs to, from FLEET_PROJECT_DIR.
function myProject() {
  const d = process.env.FLEET_PROJECT_DIR;
  if (!d) throw new Fail("FLEET_PROJECT_DIR is not set; run this as a lead started by `fleet project`", 2);
  return project(path.basename(d));
}

// The PRD section of prd.md: its text, and each field's body (or null when missing).
function readPrd(name) {
  const f = path.join(projDir(name), "prd.md");
  const md = exists(f) ? fs.readFileSync(f, "utf8") : "";
  const m = md.match(/^## PRD[^\n]*\n([\s\S]*?)(?=^## |(?![\s\S]))/m);
  const text = m ? m[1].trim() : "";
  const fields = {};
  for (const name of PRD_FIELDS) {
    const fm = text.match(new RegExp(`^### ${name}[^\\n]*\\n([\\s\\S]*?)(?=^### |(?![\\s\\S]))`, "m"));
    fields[name] = fm ? fm[1].trim() : null;
  }
  return { text, fields };
}

function appendDecision(name, line) {
  fs.appendFileSync(path.join(projDir(name), "decisions.md"), `- ${stamp("%Y-%m-%d")}: ${line}\n`);
}

const PRD_MD = (name) => `# ${name}

## PRD
The lead fills each field (~/.agents/skills/fleet/references/prd.md), noting where each answer came from;
an open question stays as "TBD: <question> — rec: <your answer>". The CoS signs it with
\`fleet project approve\`; after that it stays fixed until \`fleet project goal\`.

${PRD_FIELDS.map((f) => `### ${f}\nTBD`).join("\n\n")}

## Standing orders
Project rules beyond playbook.md, as they stand now. Change a line in place and log the change in decisions.md.

## Now
The resume point: workers in flight, what you are waiting on, your next step.

## Plan

## Stuck

## Done
`;

// Start (or restart) a project's lead in its own space; its first prompt depends on the status.
function startLead(p) {
  if (live(p.lead)) return log(`${p.lead} is already running.`);
  const d = projDir(p.name);
  const task = `You lead project \`${p.name}\`. Folder: ${d}. Status: ${p.status}. ` + (p.status === "aligning"
    ? "Read brief.md, fill the PRD in prd.md per ~/.agents/skills/fleet/references/prd.md, then send `fleet report --kind prd`."
    : "Read brief.md, prd.md (Now first) and decisions.md, then carry on. `fleet ls` lists workers still running.");
  launch({ role: "lead", name: p.lead, cwd: d, task, space: p.space, labels: [`fleet.project=${p.name}`],
    parent: "outlive", keep: true });
  app(["do", "space.rename", "--id", p.space, "--name", p.name], false);
  log(`Started ${p.lead} in space ${p.name}.`);
}

function stopTerminal(name) {
  hc(["kill", name], false);
  hc(["rm", name], false);
}

// The prefix of a project's worker names: the name itself when short, else its initials
// (automate-product-listings: apl), so <key>-<role>-<slug> fits hc's 32 characters.
function workerKey(name) {
  if (name.length <= 12) return name;
  const initials = name.split("-").map((w) => w[0]).join("");
  return initials.length > 1 ? initials : name.slice(0, 6);
}

// A project's workers: live terminals named <key>-<role>-<slug>.
function workers(p) {
  const rs = Object.keys(roles()).filter((r) => !LEADERS.includes(r));
  return ((hcJson("ls") || {}).terminals || [])
    .filter((t) => t.name && rs.some((r) => t.name.startsWith(`${workerKey(p.name)}-${r}-`)));
}

// ---- queue --------------------------------------------------------------------

function items({ closed = false, drafts = false } = {}) {
  const dir = path.join(HOME, "queue"), list = [];
  for (const f of isDir(dir) ? fs.readdirSync(dir) : []) {
    if (!f.endsWith(".json")) continue;
    let it;
    try { it = readJson(path.join(dir, f)); } catch { continue; }
    if ((closed || it.status !== "closed") && (drafts || it.status !== "draft")) list.push(it);
  }
  // Open first, then priority, then oldest first.
  const order = { open: 0, answered: 1, draft: 2, closed: 3 };
  const key = (i) => [order[i.status] ?? 4, i.priority ?? "p2", i.created ?? ""];
  return list.sort((a, b) => {
    const [x, y] = [key(a), key(b)];
    for (let n = 0; n < 3; n++) if (x[n] !== y[n]) return x[n] < y[n] ? -1 : 1;
    return 0;
  });
}

function itemPath(id) {
  const p = path.join(HOME, "queue", `${id}.json`);
  if (!exists(p)) throw new Fail(`no queue item '${id}'`, 2);
  return p;
}

// ---- launching ----------------------------------------------------------------

// The Herdr space id a terminal labelled herdr.space=<label> landed in, if Herdr kept the label as its id.
function findSpace(label) {
  const r = app(["ls"], false);
  if (r.status !== 0) return null;
  try { return (JSON.parse(r.stdout).spaces || []).find((s) => s.id === label) || null; } catch { return null; }
}

// Start a role as `fleet exec <role> <task>` in an hc terminal; the task is the agent's first
// prompt, so nothing is typed into it. parent: "child" (ends with the caller), "outlive"
// (leads and workers: they survive their parent's restarts) or "none" (the CoS). hc types no
// notes about it into its parent: `fleet inbox --wait` watches leads, and leads read their workers.
function launch({ role, name, cwd, task, space, labels = [], parent = "child", keep = false }) {
  const args = ["run", "--bg", "--json", "--no-notify", "--name", name, "--cwd", cwd, "--label", `fleet.role=${role}`];
  if (keep) args.push("--keep");
  if (space) args.push("--label", `herdr.space=${space}`);
  for (const lab of labels) args.push("--label", lab);
  if (parent === "outlive") args.push("--outlive-parent");
  if (parent === "none") args.push("--no-parent");
  args.push("--", "env", `FLEET_HOME=${HOME}`, SELF, "exec", role, task); // hc run passes no environment
  hc(args);
  settle(name, cwd);
}

// Wait until the agent reports a status. Claude asks before working in a folder it has
// not seen; accept that once, and it then starts on its task.
function settle(name, cwd) {
  for (let i = 0; i < 40; i++) {
    const st = word(live(name));
    if (!["live", "stopped"].includes(st)) return;
    const screen = hc(["read", name, "--lines", "0"], false).stdout;
    if (screen.includes("trust this folder")) {
      log(`${name}: accepting Claude's trust prompt for ${cwd}.`);
      const chosen = screen.split("\n").find((l) => l.includes("❯")) || "";
      hc(["keys", name, ...(chosen.includes("Yes") ? [] : ["down"]), "enter"]);
    }
    spawnSync("sleep", ["0.5"]);
  }
  log(`${name}: started, but has reported no status after 20 seconds. Look with \`hc read ${name}\`.`);
}

// ---- commands ---------------------------------------------------------------

// Make <dir>/.fleet (dir: here by default), or fill in what an existing one lacks.
function cmdInit(a) {
  const home = path.join(path.resolve(expand(a.dir || ".")), STATE_DIR);
  if (!a.dir && !process.env.FLEET_HOME && HOME && HOME !== home && path.resolve(".").startsWith(workRoot() + path.sep))
    throw new Fail(`this folder is already in the fleet at ${HOME}; to make a separate one here, run \`fleet init .\``, 2);
  if (!exists(home)) log(`Made a fleet in ${path.dirname(home)}.`);
  HOME = home;
  ensureHome();
  const pb = path.join(HOME, "playbook.md");
  if (!exists(pb)) {
    fs.writeFileSync(pb, PLAYBOOK_SEED);
    log(`Wrote ${pb}: your rules for the CoS and leads.`);
  }
  log(`This fleet's emoji: ${emoji()} (\`fleet config FLEET_EMOJI <emoji>\` changes it).`);
  checkHerdrFiles();
  out(HOME);
}

function cmdHome() {
  out(HOME);
}

// Herdr's config folder, where `dot link` puts the fleet layout and its mods.
const HERDR_APP = path.join(os.homedir(), ".config/herdr-app");
const LAYOUT = path.join(HERDR_APP, "layouts/fleet.json");

// Says which of the layout and the mods it names are missing; true when none are.
// Herdr's built-in mods sit in the same mods/ folder, so every name is checked alike.
function checkHerdrFiles() {
  const missing = [];
  let layout = null;
  try { layout = readJson(LAYOUT); } catch { missing.push(LAYOUT); }
  const mods = new Set();
  (function walk(n) {
    if (Array.isArray(n)) return n.forEach(walk);
    if (!n || typeof n !== "object") return;
    if (typeof n.mod === "string") mods.add(n.mod);
    if (typeof n.terminal_menu === "string") mods.add(n.terminal_menu);
    Object.values(n).forEach(walk);
  })(layout);
  for (const m of mods) {
    const f = path.join(HERDR_APP, "mods", m, "mod.json");
    if (!exists(f)) missing.push(f);
  }
  if (missing.length)
    log(`The Fleet panel cannot load; missing (or links to nothing):\n  ${missing.join("\n  ")}\n` +
      "Run `dot link` in your dotfiles repo, then `fleet up`.");
  return !missing.length;
}

function cmdConfig(a) {
  const cfg = config();
  if (a.name && !(a.name in SETTINGS))
    throw new Fail(`unknown setting ${a.name}; settings: ${Object.keys(SETTINGS).join(", ")}`, 2);
  if (a.value != null) {
    cfg[a.name] = expand(a.value);
    saveConfig(cfg);
  }
  for (const k of a.name ? [a.name] : Object.keys(SETTINGS)) out(`${k}=${cfg[k] ?? ""}`);
}

// Where this script really lives (~/.local/bin/fleet is a link to it), and the skill around it.
const SELF = fs.realpathSync(__filename);
const SKILL_DIR = path.dirname(path.dirname(SELF));
// Each role's program, model and system prompt files, kept in the skill's roles.json.
const ROLES_FILE = path.join(SKILL_DIR, "roles.json");

// Your rules, seeded once into $FLEET_HOME/playbook.md.
const PLAYBOOK_SEED = `# Playbook

Your rules for the CoS and leads; part of their system prompts (roles.json). Local to this
fleet; never committed. One rule per line, newest last; the CoS appends one only after
you approve it. Which program and login each role uses is in roles.json, not here.

## Always ask me
- Merging to a production branch, deploying, deleting anything remote, spending money.

## Learned

## Worktrees
- Every agent that changes code works in its own worktree from \`wt new <repo>/<project>-<slug>\`, never in a repo's main checkout. \`wt info <repo>\` (or \`--all\`) says where it lives and how to boot it (the \`worktrees\` skill).
`;

function roles() {
  try {
    const rs = readJson(ROLES_FILE).roles;
    if (!rs) throw new Error("no roles");
    return rs;
  } catch (e) {
    throw new Fail(`cannot read roles from ${ROLES_FILE}: ${e.message}`);
  }
}

function role(name) {
  const rs = roles();
  if (!(name in rs)) throw new Fail(`unknown role ${name}; roles: ${Object.keys(rs).join(", ")} (${ROLES_FILE})`, 2);
  return rs[name];
}

// A role's system prompt: its name, then its prompt files without their frontmatter.
// A file starting "$FLEET_HOME/" is in the state folder; any other is under this skill.
function rolePrompt(name, r) {
  const parts = [`Your role in the fleet: ${name}.`];
  for (const rel of r.prompt || []) {
    const f = rel.startsWith("$FLEET_HOME/") ? path.join(HOME, rel.slice(12)) : path.join(SKILL_DIR, rel);
    if (exists(f)) parts.push(fs.readFileSync(f, "utf8").replace(/^---\n[\s\S]*?\n---\n/, "").trim());
  }
  return parts.join("\n\n");
}

// The executable's full path, as execvp would find it on $PATH.
function which(prog) {
  if (prog.includes("/")) return prog;
  for (const dir of (process.env.PATH || "").split(":")) {
    const p = path.join(dir || ".", prog);
    try { fs.accessSync(p, fs.constants.X_OK); if (!isDir(p)) return p; } catch {}
  }
  throw new Fail(`${prog} is not on PATH`);
}

// Start a role's program and model, its system prompt and this fleet's settings; the
// last argument, when it is not a flag, is its first prompt. Claude takes the role's prompt
// as an appended system prompt; any other program gets it ahead of the first prompt.
function cmdExec(a) {
  const r = role(a.role);
  const cfg = config(), root = workRoot();
  const env = { ...process.env, FLEET_HOME: HOME, FLEET_WORK_ROOT: root, FLEET_ROLE: a.role };
  delete env.FLEET_PROJECT_DIR;
  const me = process.env.HC_TERMINAL_ID;
  const proj = ((me && hcJson("get", me)) || {}).labels?.["fleet.project"];
  if (proj) env.FLEET_PROJECT_DIR = projDir(proj);
  // "default" keeps Claude's own default (~/.claude + ~/.claude.json). Setting
  // CLAUDE_CONFIG_DIR=~/.claude explicitly makes Claude read ~/.claude/.claude.json
  // instead, which looks like a fresh, logged-out install.
  // ~/.claude itself counts as "default" for the same reason.
  const dir = cfg.FLEET_CLAUDE_CONFIG_DIR;
  if (dir && dir !== "default" && dir !== path.join(os.homedir(), ".claude")) env.CLAUDE_CONFIG_DIR = dir;
  // {company}: the folder under the work root this agent works in (devin-as takes it as the account).
  const company = () => {
    const rel = path.relative(fs.realpathSync(root), fs.realpathSync(process.cwd()));
    if (!rel || rel.startsWith("..")) throw new Fail(`${a.role} must run under ${root}/<company>/`, 2);
    return rel.split(path.sep)[0];
  };
  const args = (r.args || []).map((x) => (x === "{company}" ? company() : x));
  const argv = [r.run, ...args], extra = [...a.extra], prompt = rolePrompt(a.role, r);
  if (r.run === "claude") argv.push("--append-system-prompt", prompt);
  else if (extra.length && !extra.at(-1).startsWith("-")) extra.push(`${prompt}\n\n---\n\n${extra.pop()}`);
  else extra.push(prompt);
  argv.push(...extra);
  process.execve(which(argv[0]), argv, env);
}

function cmdRoles(a) {
  const rs = roles();
  if (a.json) return out(JSON.stringify(rs, null, 2));
  for (const [name, r] of Object.entries(rs))
    out(`${pad(name, 12)} ${r.run} ${(r.args || []).join(" ")}\n${" ".repeat(13)}prompt: ${(r.prompt || []).join(", ") || "none"}`);
}

// Open HQ: start the CoS in its own space with the Fleet panel beside it. Safe to rerun.
function cmdUp() {
  need("you");
  ensureHome();
  let hq = null;
  try { hq = fs.readFileSync(HQ_FILE, "utf8").trim(); } catch {}
  if (live(COS) && hq && hq !== HOME)
    throw new Fail(`the CoS of the fleet at ${hq} is running; one fleet runs HQ at a time (stop it with \`hc kill cos\`)`, 2);
  fs.mkdirSync(path.dirname(HQ_FILE), { recursive: true });
  fs.writeFileSync(HQ_FILE, HOME + "\n");
  if (live(COS)) log("The CoS is already running as `cos`.");
  else {
    launch({ role: "cos", name: COS, cwd: fs.realpathSync(HOME), task: "Start your shift.",
      space: HQ_SPACE, parent: "none", keep: true });
    log("Started the CoS as `cos`.");
  }
  if (!findSpace(HQ_SPACE)) {
    log("The Herdr window is not open, so HQ is not shown; the CoS runs anyway. Rerun `fleet up` with Herdr open.");
    return out(COS);
  }
  app(["do", "space.rename", "--id", HQ_SPACE, "--name", `${emoji()} fleet - ${path.basename(workRoot())}`], false); // which work root this HQ serves
  app(["do", "space.select", "--id", HQ_SPACE], false);
  // The Fleet panel (Queue, Fleet, Inbox) is a side-panel child (layouts/fleet.json), next to Files and Changes.
  if (!checkHerdrFiles()) return out(COS);
  const sw = app(["do", "layout.switch", JSON.stringify({ name: "fleet" })], false);
  if (sw.status !== 0) {
    log(`Herdr would not switch to the fleet layout: ${(sw.stderr || sw.stdout).trim()}\n` +
      "A setting Herdr does not know rejects every layout switch (for example a \"theme\" in " +
      "~/.config/herdr-app/settings.json that this Herdr lacks); fix it or update Herdr, then rerun `fleet up`.");
    return out(COS);
  }
  app(["do", "layout.select", JSON.stringify({ stack: "panel-body", child: "fleet" })], false);
  app(["do", "layout.show", JSON.stringify({ id: "panel" })], false);
  out(COS);
}

function cmdProjectNew(a) {
  need("you", "cos");
  ensureHome();
  if (!NAME_RE.test(a.name)) throw new Fail("project names are 1-27 of a-z 0-9 -, starting with a letter or digit", 2);
  if (!live(COS)) throw new Fail("the CoS is not running, so nobody would read the lead's PRD; run `fleet up` first", 2);
  const d = projDir(a.name);
  if (exists(path.join(d, "project.json"))) throw new Fail(`project '${a.name}' exists; add work with \`fleet project goal\``, 2);
  const twin = projects().find((o) => o.status !== "closed" && workerKey(o.name) === workerKey(a.name));
  if (twin) throw new Fail(`'${a.name}' would share worker names with ${twin.name} (both '${workerKey(a.name)}-…'); pick another name`, 2);
  for (const sub of ["briefs", "reports", "evidence", "drafts"]) fs.mkdirSync(path.join(d, sub), { recursive: true });
  fs.writeFileSync(path.join(d, "brief.md"), `# ${a.name} brief\n\nYour words, word for word. Only added to.\n\n## ${stamp("%Y-%m-%d")}\n${a.brief.trim()}\n`);
  fs.writeFileSync(path.join(d, "prd.md"), PRD_MD(a.name));
  fs.writeFileSync(path.join(d, "decisions.md"), `# ${a.name} decisions\n\nOne line each: date, decision, who decided, why. Newest last.\n\n`);
  const p = { name: a.name, lead: `lead-${a.name}`, space: `fleet-${a.name}`, status: "aligning", prd_hash: null, created: now() };
  saveProject(p);
  startLead(p);
  out(d);
}

function cmdProjectApprove(a) {
  need("you", "cos");
  const p = project(a.name);
  if (p.status === "closed") throw new Fail(`${a.name} is closed`, 2);
  const { text, fields } = readPrd(a.name);
  const bad = PRD_FIELDS.filter((f) => !fields[f] || /\bTBD\b/.test(fields[f]));
  if (bad.length) throw new Fail(`the PRD is not ready; fill in or settle: ${bad.join(", ")}`, 2);
  Object.assign(p, { status: "active", prd_hash: sha(text), approved: now() });
  saveProject(p);
  appendDecision(a.name, `PRD approved. Decided by: ${ROLE === "you" ? "CEO" : "CoS"}.`);
  if (live(p.lead)) hc(["send", p.lead, "PRD approved. Status: active. Start work."], false);
  else log(`${p.lead} is not running; start it with \`fleet project start ${a.name}\`.`);
  out(p.status);
}

function cmdProjectGoal(a) {
  need("you", "cos");
  const p = project(a.name);
  if (p.status === "closed") throw new Fail(`${a.name} is closed; start a new project`, 2);
  fs.appendFileSync(path.join(projDir(a.name), "brief.md"), `\n## ${stamp("%Y-%m-%d")}\n${a.text.trim()}\n`);
  Object.assign(p, { status: "aligning", prd_hash: null });
  saveProject(p);
  const msg = "New work was added to brief.md. Status: aligning. Update the PRD in prd.md, then `fleet report --kind prd`. " +
    "Workers already running may finish; start no new ones until the PRD is approved.";
  if (live(p.lead)) hc(["send", p.lead, msg], false);
  else startLead(p);
  out(p.status);
}

function cmdProjectStart(a) {
  need("you", "cos");
  const p = project(a.name);
  if (p.status === "closed") throw new Fail(`${a.name} is closed`, 2);
  if (p.status === "parked") {
    Object.assign(p, { status: p.parked_from || "active", parked_from: undefined, parked_reason: undefined });
    saveProject(p);
    appendDecision(a.name, `Unparked. Decided by: ${ROLE === "you" ? "CEO" : "CoS"}.`);
  }
  startLead(p);
  out(p.lead);
}

// A project waiting on people, not work: its lead and workers stop until `fleet project start`.
function cmdProjectPark(a) {
  need("you", "cos");
  const p = project(a.name);
  if (p.status === "closed" || p.status === "parked") throw new Fail(`${a.name} is ${p.status}`, 2);
  for (const w of workers(p)) stopTerminal(w.name);
  forgetLead(p.lead);
  stopTerminal(p.lead);
  Object.assign(p, { parked_from: p.status, status: "parked", parked_reason: a.reason });
  saveProject(p);
  appendDecision(a.name, `Parked: ${a.reason}. Decided by: ${ROLE === "you" ? "CEO" : "CoS"}.`);
  log(`Parked ${a.name}; \`fleet project start ${a.name}\` resumes it.`);
  out(p.status);
}

function cmdProjectClose(a) {
  need("you", "cos");
  const p = project(a.name);
  for (const w of workers(p)) stopTerminal(w.name);
  forgetLead(p.lead);
  stopTerminal(p.lead);
  Object.assign(p, { status: "closed", closed: now() });
  saveProject(p);
  appendDecision(a.name, `Project closed. Decided by: ${ROLE === "you" ? "CEO" : "CoS"}.`);
  log(`Closed ${a.name}: stopped ${p.lead} and its workers; its files stay in ${projDir(a.name)}.`);
  out(p.status);
}

function cmdProjectLs(a) {
  const ps = projects();
  for (const p of ps) p.lead_status = word(live(p.lead));
  if (a.json) return out(JSON.stringify(ps, null, 2));
  for (const p of ps) out(`${pad(p.name, 26)} ${pad(p.status, 9)} lead ${p.lead_status}`);
}

// A lead starts a worker: `fleet run implementer ui --cwd <worktree> "<brief>"`.
function cmdRun(a) {
  need("lead");
  const p = myProject();
  if (LEADERS.includes(a.role)) throw new Fail(`${a.role} is not a worker role`, 2);
  role(a.role);
  if (p.status !== "active") throw new Fail(`${p.name} is ${p.status}; get the PRD approved first`, 2);
  if (sha(readPrd(p.name).text) !== p.prd_hash)
    throw new Fail("the PRD changed since it was approved; ask the CoS to approve it again (`fleet report --kind prd`)", 2);
  const name = `${workerKey(p.name)}-${a.role}-${a.slug}`;
  if (name.length > 32) throw new Fail(`${name} is over hc's 32 characters; use a slug of ${32 - name.length + a.slug.length} or fewer`, 2);
  if (live(name)) throw new Fail(`${name} is already running`, 2);
  const brief = path.join(projDir(p.name), "briefs", `${name}.md`);
  fs.mkdirSync(path.dirname(brief), { recursive: true });
  fs.writeFileSync(brief, a.task + "\n");
  launch({ role: a.role, name, cwd: path.resolve(expand(a.cwd || ".")), task: a.task,
    labels: [`fleet.project=${p.name}`], parent: "outlive" });
  out(name);
}

function cmdLs(a) {
  need("lead");
  const ws = workers(myProject()).map((t) => ({ name: t.name, status: word(t), where: t.where ?? null }));
  if (a.json) return out(JSON.stringify(ws, null, 2));
  if (!ws.length) log("No workers running.");
  for (const w of ws) out(`${pad(w.name, 33)} ${w.status}`);
}

function cmdStop(a) {
  need("lead");
  const p = myProject();
  if (!workers(p).some((w) => w.name === a.name)) throw new Fail(`${a.name} is not one of ${p.name}'s running workers`, 2);
  stopTerminal(a.name);
  log(`Stopped ${a.name}.`);
}

// A message from the CoS to a lead, or from a lead to one of its workers. hc tags it
// <hc from="…">, which would turn a leading /command into plain text, so a message that
// starts with "/" goes untagged, as if typed, and its /command runs.
function cmdSend(a) {
  need("you", "cos", "lead");
  if (ROLE === "lead") {
    const p = myProject();
    if (!workers(p).some((w) => w.name === a.name)) throw new Fail(`${a.name} is not one of ${p.name}'s running workers`, 2);
    if (!live(a.name)) throw new Fail(`${a.name} is not running; \`fleet ls\` lists your workers`, 2);
  } else {
    if (!/^lead-/.test(a.name)) throw new Fail(`${a.name} is not a lead (lead-<p>)`, 2);
    if (!live(a.name)) throw new Fail(`${a.name} is not running; start it with \`fleet project start ${a.name.slice(5)}\``, 2);
  }
  const raw = a.text.startsWith("/"), env = { ...process.env };
  if (raw) delete env.HC_TERMINAL_ID; // without it hc cannot tag the sender
  const r = spawnSync("hc", ["send", a.name, a.text], { encoding: "utf8", env });
  if (r.status !== 0) throw new Fail(`hc send failed: ${(r.stderr || r.stdout || "").trim()}`);
  log(`Sent to ${a.name}${raw ? " untagged" : ""}.`);
}

// A lead whose context is filling up restarts itself; its workers keep running.
function cmdHandoff() {
  need("lead");
  const p = myProject();
  const md = path.join(projDir(p.name), "prd.md");
  if (Date.now() - fs.statSync(md).mtimeMs > 10 * 60 * 1000)
    throw new Fail("update Now in prd.md first (it is the new lead's resume point), then run this again", 2);
  deliver("fyi", p.lead, p.name, `${p.lead} handed off: it restarts with a fresh context and resumes from prd.md.`);
  forgetLead(p.lead);
  // In a terminal of its own with no parent, so killing this lead does not take the restart with it.
  const restart = `sleep 3; hc kill ${p.lead}; hc rm ${p.lead}; ` +
    `env -u FLEET_ROLE -u FLEET_PROJECT_DIR FLEET_HOME="${HOME}" "${SELF}" project start ${p.name}`;
  hc(["run", "--bg", "--no-parent", "--no-notify", "--name", `handoff-${p.name}`.slice(0, 32), "--", "sh", "-c", restart]);
  log(`Restarting ${p.lead} in a few seconds. Stop working now.`);
}

function cmdAsk(a) {
  need("you", "cos", "lead");
  ensureHome();
  if (a.project !== "hq") project(a.project);
  const id = stamp("%m%d-%H%M") + "-" + hex2();
  const attDir = path.join(HOME, "queue", id);
  const atts = [];
  for (const src of a.attach) {
    if (/^https?:\/\//.test(src)) {
      atts.push({ kind: "link", url: src });
      continue;
    }
    const s = expand(src);
    if (!exists(s) || !fs.statSync(s).isFile()) throw new Fail(`attachment ${src} is not a file`, 2);
    fs.mkdirSync(attDir, { recursive: true });
    const dest = path.join(attDir, path.basename(s));
    fs.copyFileSync(s, dest);
    const st = fs.statSync(s);
    fs.utimesSync(dest, st.atime, st.mtime);
    const ext = path.extname(s).toLowerCase();
    const kind = [".png", ".jpg", ".jpeg", ".gif", ".webp"].includes(ext) ? "image"
      : [".mp4", ".mov", ".webm"].includes(ext) ? "video" : "file";
    atts.push({ kind, path: dest });
  }
  // A lead's item is a draft until the CoS forwards it.
  const status = ROLE === "lead" ? "draft" : "open";
  const item = {
    id, project: a.project, from: a.sender || process.env.HC_TERMINAL_ID || "cos",
    kind: a.kind, priority: a.priority, title: a.title, body: a.body || "",
    recommendation: a.recommend || "", options: a.option, attachments: atts,
    status, answer: null, history: [], created: now(), updated: now(),
  };
  writeJson(path.join(HOME, "queue", `${id}.json`), item);
  if (status === "draft")
    deliver("draft", item.from, a.project, `Draft queue item ${id} (${a.priority}, ${a.kind}): "${a.title}". ` +
      `Recommend: ${item.recommendation || "(none)"}. Forward it with \`fleet forward ${id}\`, or answer the lead yourself ` +
      `when playbook.md settles it and \`fleet close ${id}\`.`, { item: id });
  out(id);
}

function cmdForward(a) {
  need("cos");
  const p = itemPath(a.id), it = readJson(p);
  if (it.status !== "draft") throw new Fail(`${a.id} is ${it.status}, not a draft`, 2);
  Object.assign(it, { status: "open", updated: now() });
  writeJson(p, it);
  out(it.id);
}

function cmdQueue(a) {
  let its = items({ closed: a.all, drafts: a.all || a.drafts });
  if (a.project) its = its.filter((i) => i.project === a.project);
  if (a.json) return out(JSON.stringify(its, null, 2));
  for (const i of its) out(`${i.id}  ${pad(i.status, 8)} ${i.priority} ${pad(i.kind, 8)} ${pad(i.project, 12)} ${i.title}`);
}

function cmdShow(a) {
  process.stdout.write(fs.readFileSync(itemPath(a.id), "utf8"));
}

// You answered an item in the panel. Record it and hand it to the CoS (only the CoS).
function cmdAnswer(a) {
  need("you", "cos");
  const p = itemPath(a.id), it = readJson(p);
  const answer = { verdict: a.verdict, text: a.text || "", choice: a.choice ?? null, at: now() };
  if (it.answer) (it.history ||= []).push(it.answer);
  Object.assign(it, { answer, status: "answered", updated: now() });
  writeJson(p, it);
  const msg = `[queue answer] ${it.id} (${it.project}, ${it.kind}): "${it.title}" -> ${a.verdict}` +
    (a.choice ? ` [${a.choice}]` : "") + (a.text ? `: ${a.text}` : "") +
    `. Asked by ${it.from}. Pass it on word for word, propose a playbook.md rule if it holds across projects, ` +
    `and \`fleet close ${it.id}\` once it is addressed.`;
  if (!a.no_send) {
    deliver("answer", "ceo", it.project, msg, { item: it.id });
    if (!live(COS)) log("The CoS is not running; the answer is in its inbox for its next shift.");
  }
  out(it.id);
}

// ---- inbox: messages for the CoS that never type into its pane ---------------

// Put one message in the CoS's inbox; returns its id.
function deliver(kind, sender, project, text, extra = {}) {
  const d = path.join(HOME, "inbox");
  fs.mkdirSync(d, { recursive: true });
  const id = stamp("%Y%m%d-%H%M%S") + "-" + hex2();
  writeJson(path.join(d, `${id}.json`), { id, kind, from: sender, project, text, at: now(), ...extra });
  return id;
}

function unread() {
  const d = path.join(HOME, "inbox");
  if (!isDir(d)) return [];
  return fs.readdirSync(d).filter((f) => f.endsWith(".json")).sort().map((f) => readJson(path.join(d, f)));
}

const seenFile = () => path.join(HOME, "inbox", "leads.state");
const readSeen = () => (exists(seenFile()) ? readJson(seenFile()) : {});

// Inbox messages for leads that turned blocked or stopped since the last look.
function watchLeads() {
  const seen = readSeen(), nowSeen = {};
  for (const p of projects()) {
    if (["closed", "parked"].includes(p.status)) continue;
    const st = word(live(p.lead));
    nowSeen[p.lead] = st;
    const before = seen[p.lead]; // undefined on the first look: nothing to compare with
    if (before === undefined || before === st) continue;
    if (st === "blocked")
      deliver("blocked", p.lead, p.name, `${p.lead} is blocked: it needs a person. Read it with \`hc read ${p.lead} --lines 60\`.`);
    else if (st === "stopped")
      deliver("stopped", p.lead, p.name, `${p.lead} has stopped. Restart it with \`fleet project start ${p.name}\` if its plan has open work.`);
  }
  fs.mkdirSync(path.join(HOME, "inbox"), { recursive: true });
  fs.writeFileSync(seenFile(), JSON.stringify({ ...seen, ...nowSeen }));
}

// A lead stopped on purpose: no `stopped` message for it.
function forgetLead(lead) {
  const seen = readSeen();
  seen[lead] = "stopped";
  fs.mkdirSync(path.join(HOME, "inbox"), { recursive: true });
  fs.writeFileSync(seenFile(), JSON.stringify(seen));
}

// A lead (or a bridge such as cos-slack) reports to the CoS without typing into its pane.
function cmdReport(a) {
  need("you", "lead");
  const me = process.env.HC_TERMINAL_ID;
  const t = me ? hcJson("get", me) : null;
  const sender = a.sender || (t && t.name) || me || "unknown";
  const dir = process.env.FLEET_PROJECT_DIR;
  const project = a.project || (dir ? path.basename(dir) : "hq");
  const text = a.file ? fs.readFileSync(a.file, "utf8") : a.text;
  if (!text) throw new Fail("give the report as text or with --file", 2);
  const id = deliver(a.kind, sender, project, text, a.file ? { file: path.resolve(a.file) } : {});
  if (!live(COS)) log("The CoS is not running; your report waits in its inbox for its next shift.");
  out(id);
}

function showMessages(msgs, asJson) {
  if (asJson) return out(JSON.stringify(msgs, null, 2));
  for (const m of msgs) {
    out(`--- ${m.id}  ${m.kind}  from ${m.from}  (${m.project}, ${m.at})`);
    out(m.text.trimEnd());
  }
}

// For the panel's Inbox tab: unread messages, then the last n handled ones, newest first.
function inboxHistory(n) {
  const d = path.join(HOME, "inbox", "done");
  const done = isDir(d) ? fs.readdirSync(d).filter((f) => f.endsWith(".json")).sort().reverse().slice(0, n) : [];
  return [...unread().map((m) => ({ ...m, status: "unread" })),
    ...done.map((f) => ({ ...readJson(path.join(d, f)), status: "handled" }))];
}

async function cmdInbox(a) {
  if (a.done.length || a.wait) need("cos");
  if (a.done.length) {
    const dest = path.join(HOME, "inbox", "done");
    fs.mkdirSync(dest, { recursive: true });
    for (const id of a.done) {
      const f = path.join(HOME, "inbox", `${id}.json`);
      if (!exists(f)) throw new Fail(`no unread message ${id}`, 2);
      writeJson(path.join(dest, path.basename(f)), { ...readJson(f), handled: now() });
      fs.unlinkSync(f);
    }
    return;
  }
  if (a.history != null) return out(JSON.stringify(inboxHistory(Number(a.history) || 0), null, 2));
  let msgs;
  if (a.wait) {
    for (;;) {
      watchLeads();
      msgs = unread();
      if (msgs.length) break;
      await sleep(3000);
    }
  } else {
    msgs = unread();
    if (!msgs.length && !a.json) log("Inbox is empty.");
  }
  showMessages(msgs, a.json);
}

function cmdClose(a) {
  need("you", "cos");
  const p = itemPath(a.id), it = readJson(p);
  Object.assign(it, { status: "closed", closed_note: a.note || "", updated: now() });
  writeJson(p, it);
  out(it.id);
}

function cmdReopen(a) {
  need("you", "cos");
  const p = itemPath(a.id), it = readJson(p);
  Object.assign(it, { status: "open", updated: now() });
  if (a.note) it.body = ((it.body || "") + `\n\nUpdate ${now()}: ${a.note}`).trim();
  writeJson(p, it);
  out(it.id);
}

// Claude API list prices per model ($/MTok), kept in the skill's prices.json so they
// can be updated as Anthropic changes them. Seats aren't billed per token, so
// `fleet stats` reports what the same tokens would cost on the API.
const PRICES_FILE = path.join(SKILL_DIR, "prices.json");

function prices() {
  try { return readJson(PRICES_FILE).models || {}; } catch { return {}; }
}

// Model, context in use and API-rate cost of one Claude Code transcript.
// Each assistant message is logged once per content block with the same usage, so
// messages are counted once by id. Context is the last message's whole prompt.
function transcriptUsage(file, table) {
  let text;
  try { text = fs.readFileSync(file, "utf8"); } catch { return null; }
  const seen = new Set();
  let cost = 0, last = null, model = null;
  for (const line of text.split("\n")) {
    if (!line.includes('"usage"')) continue;
    let m;
    try { m = JSON.parse(line).message || {}; } catch { continue; }
    const u = m.usage, mid = m.id;
    if (!u || seen.has(mid)) continue;
    seen.add(mid);
    model = m.model || model;
    const p = table[model];
    if (p == null) cost = null; // one unpriced message makes the total unknown
    else if (cost !== null) {
      const w1h = (u.cache_creation || {}).ephemeral_1h_input_tokens || 0;
      const w5m = (u.cache_creation_input_tokens || 0) - w1h;
      cost += ((u.input_tokens || 0) * p.input + w5m * p.cache_write_5m + w1h * p.cache_write_1h
        + (u.cache_read_input_tokens || 0) * p.cache_read + (u.output_tokens || 0) * p.output) / 1e6;
    }
    last = u;
  }
  const window = (table[model] || {}).context ?? null;
  if (last === null) return { model, context: 0, window, cost: 0, messages: 0 };
  const context = (last.input_tokens || 0) + (last.cache_creation_input_tokens || 0) + (last.cache_read_input_tokens || 0);
  return { model, context, window, cost: cost === null ? null : round4(cost), messages: seen.size };
}

// One terminal for `fleet stats`: hc's status plus, for Claude, its transcript's usage.
function agentRow(t, role, depth, table) {
  const full = hcJson("get", t.address) || {};
  const labels = full.labels || {};
  const row = { address: t.address, name: t.name || t.address, agent: t.agent ?? null,
    role, depth, status: word(t), where: t.where ?? null };
  const file = labels["claude.transcript"];
  if (file) Object.assign(row, transcriptUsage(file, table) || {});
  return row;
}

// The PRD's goal, for the panel and `fleet status`.
function goalOf(name) {
  const g = readPrd(name).fields.Goal;
  return g && !/\bTBD\b/.test(g) ? g.split("\n")[0] : "";
}

// The fleet for the panel's Fleet tab: the CoS, then each project's lead and its workers.
function cmdStats() {
  const ls = (hcJson("ls") || {}).terminals || [];
  const table = prices();
  const byName = Object.fromEntries(ls.filter((t) => t.name).map((t) => [t.name, t]));
  const cosT = byName[COS];
  const res = { cos: cosT ? agentRow(cosT, "cos", 0, table) : { name: COS, status: "stopped", role: "cos" },
    projects: [], queue: { open: 0, answered: 0 } };
  const its = items();
  for (const i of its) if (i.status in res.queue) res.queue[i.status]++;
  for (const p of projects()) {
    if (["closed", "parked"].includes(p.status)) continue;
    const lead = byName[p.lead];
    // Workers outlive their lead, so they are found by name rather than as its children.
    const agents = [...(lead ? [agentRow(lead, "lead", 0, table)] : []),
      ...workers(p).map((w) => agentRow(w, "worker", 1, table))];
    res.projects.push({ name: p.name, status: p.status, goal: goalOf(p.name), lead_status: word(lead), agents,
      queue_open: its.filter((i) => i.project === p.name && i.status === "open").length,
      cost: round4(agents.reduce((s, r) => s + (r.cost || 0), 0)) });
  }
  res.cost = round4((res.cos.cost || 0) + res.projects.reduce((s, p) => s + p.cost, 0));
  res.prices_file = PRICES_FILE;
  out(JSON.stringify(res, null, 2));
}

function cmdStatus(a) {
  ensureHome();
  const its = items({ closed: true, drafts: true });
  const rows = projects().filter((p) => a.all || p.status !== "closed").map((p) => ({
    project: p.name, status: p.status, lead: p.lead, lead_status: word(live(p.lead)),
    workers: workers(p).map((w) => ({ name: w.name, status: word(w) })),
    open_items: its.filter((i) => i.project === p.name && i.status === "open").length,
    drafts: its.filter((i) => i.project === p.name && i.status === "draft").length,
  }));
  const res = { cos: word(live(COS)), home: HOME, projects: rows,
    queue: { open: its.filter((i) => i.status === "open").length, answered: its.filter((i) => i.status === "answered").length,
      drafts: its.filter((i) => i.status === "draft").length } };
  if (a.json) return out(JSON.stringify(res, null, 2));
  out(`CoS: ${res.cos}   queue: ${res.queue.open} open, ${res.queue.answered} answered, ${res.queue.drafts} drafts   state: ${HOME}`);
  for (const r of rows) {
    const ws = r.workers.map((w) => `${w.name} ${w.status}`).join(", ") || "no workers";
    out(`  ${pad(r.project, 26)} ${pad(r.status, 9)} lead ${pad(r.lead_status, 8)} ${r.open_items} open  [${ws}]`);
  }
}

// ---- arguments ----------------------------------------------------------------

// Each command: its positionals ("name", "name?" optional, "name..." the rest verbatim) and
// options (flag -> {key, help, bool, many: repeatable, list: one or more values, choices, required, def}).
// `who` lists the roles that may run it, for --help ("you" is a person, the panel or a bridge).
const json = { "--json": { bool: true } };
const COMMANDS = {
  init: { fn: cmdInit, home: false, help: "make a fleet in a work root: <dir>/.fleet with playbook.md (dir: here); fills in what an existing one lacks; prints its path",
    pos: ["dir?"] },
  home: { fn: cmdHome, help: "print this fleet's state folder" },
  config: { fn: cmdConfig, help: "print this fleet's settings, or set one: fleet config FLEET_CLAUDE_CONFIG_DIR ~/.claude-alt", pos: ["name?", "value?"] },
  exec: { fn: cmdExec, help: "run a role in this terminal: its program, model and system prompt from roles.json, then the rest of the arguments (the last one is its first prompt)",
    pos: ["role", "extra..."] },
  roles: { fn: cmdRoles, home: false, help: "each role's program, model and system prompt files (roles.json)", opts: json },
  up: { fn: cmdUp, who: "you", help: "open HQ: start the CoS and the Fleet panel (safe to rerun)" },
  status: { fn: cmdStatus, help: "the CoS, projects, leads, their workers and queue counts",
    opts: { "--all": { bool: true, help: "include closed projects" }, ...json } },
  "project new": { fn: cmdProjectNew, who: "you, cos", help: "create a project from your words and start its lead to write the PRD (needs `fleet up`)",
    pos: ["name"], opts: { "--brief": { required: true, help: "the request, word for word" } } },
  "project approve": { fn: cmdProjectApprove, who: "you, cos", help: "sign the PRD: refuses while a field is empty or TBD; status active", pos: ["name"] },
  "project goal": { fn: cmdProjectGoal, who: "you, cos", help: "add work to brief.md; status back to aligning", pos: ["name", "text"] },
  "project start": { fn: cmdProjectStart, who: "you, cos", help: "start a stopped lead; it resumes from its files", pos: ["name"] },
  "project park": { fn: cmdProjectPark, who: "you, cos", help: "stop a project that waits on people, not work; `project start` resumes it",
    pos: ["name"], opts: { "--reason": { required: true, help: "what it waits on" } } },
  "project close": { fn: cmdProjectClose, who: "you, cos", help: "stop the lead and its workers; status closed; files stay", pos: ["name"] },
  "project ls": { fn: cmdProjectLs, help: "list projects with their status and lead", opts: json },
  run: { fn: cmdRun, who: "lead", help: "start a worker <key>-<role>-<slug> (<key>: the project name, or its initials past 12 characters): fleet run <role> <slug> --cwd <dir> \"<brief>\"; prints its name",
    pos: ["role", "slug", "task"], opts: { "--cwd": { help: "the folder it works in (default: here)" } } },
  ls: { fn: cmdLs, who: "lead", help: "this project's running workers", opts: json },
  send: { fn: cmdSend, who: "you, cos (to a lead), lead (to its own workers)", help: "a message to a lead, or a lead's to its worker; one that starts with \"/\" goes untagged, so its /command runs",
    pos: ["name", "text"] },
  stop: { fn: cmdStop, who: "lead", help: "kill one of this project's workers", pos: ["name"] },
  handoff: { fn: cmdHandoff, who: "lead", help: "restart this lead with a fresh context once Now in prd.md is current; workers keep running" },
  report: { fn: cmdReport, who: "lead, you", help: "a report to the CoS, into its inbox (never `hc send cos`); prints its id", pos: ["text?"], opts: {
    "--kind": { choices: REPORT_KINDS, def: "fyi" },
    "--file": { help: "a file holding the report (for anything longer than ten lines)" },
    "--project": { help: "default: your project" },
    "--from": { key: "sender", help: "default: your hc name" } } },
  ask: { fn: cmdAsk, who: "lead (a draft), cos, you", help: "put an item in your queue; a lead's waits as a draft until the CoS forwards it; prints its id", opts: {
    "--project": { required: true, help: "project name, or hq for fleet-wide items" },
    "--title": { required: true, help: "one line the CEO can decide from" },
    "--kind": { choices: KINDS, def: "decision" },
    "--priority": { choices: PRIORITIES, def: "p2", help: "p0 blocks work now ... p3 whenever" },
    "--body": { help: "context: what, why now, what happens on each answer (markdown)" },
