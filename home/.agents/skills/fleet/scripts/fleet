const keyOf = (flag, o) => o.key || flag.slice(2).replace(/-/g, "_");

function usage(name, c) {
  const pos = (c.pos || []).map((p) => (p.endsWith("?") ? `[${p.slice(0, -1)}]` : p.endsWith("...") ? `[${p}]` : p));
  const opts = Object.entries(c.opts || {}).map(([f, o]) => {
    const v = o.bool ? f : `${f} ${o.choices ? `{${o.choices.join(",")}}` : keyOf(f, o).toUpperCase()}${o.list ? " ..." : ""}`;
    return o.required ? v : `[${v}]`;
  });
  return ["usage: fleet", name, ...opts, ...pos].join(" ");
}

function help(name, c) {
  const lines = [usage(name, c), "", c.help + (c.who ? ` (who: ${c.who})` : "")];
  const opts = Object.entries(c.opts || {});
  if (opts.length) {
    lines.push("", "options:");
    for (const [f, o] of opts) {
      const extra = [o.help, o.choices && `one of ${o.choices.join(", ")}`, o.def && `default ${o.def}`, o.required && "required"];
      lines.push(`  ${pad(f, 14)} ${extra.filter(Boolean).join("; ")}`);
    }
  }
  return lines.join("\n");
}

function topHelp() {
  const lines = ["usage: fleet <command> [options]   (fleet <command> --help for one)", "", DOC, "", "commands (who may run it, when not everyone):"];
  for (const [name, c] of Object.entries(COMMANDS)) lines.push(`  ${pad(name, 16)} ${c.help}${c.who ? ` [${c.who}]` : ""}`);
  return lines.join("\n");
}

function parse(argv) {
  const bad = (msg, name, c) => {
    log(c ? usage(name, c) : "usage: fleet <command> [options]   (fleet --help lists them)");
    throw new Fail(msg, 2);
  };
  if (!argv.length) bad("a command is required");
  if (argv[0] === "-h" || argv[0] === "--help") return out(topHelp()), null;
  let name = argv[0], rest = argv.slice(1);
  const group = Object.keys(COMMANDS).filter((k) => k.startsWith(name + " "));
  if (group.length) {
    if (!rest.length || rest[0] === "-h" || rest[0] === "--help") {
      out(`usage: fleet ${name} {${group.map((k) => k.split(" ")[1]).join(",")}} ...\n`);
      for (const k of group) out(`  ${pad(k, 16)} ${COMMANDS[k].help}`);
      return rest.length ? null : bad(`${name}: a subcommand is required`);
    }
    name += " " + rest[0];
    rest = rest.slice(1);
  }
  const c = COMMANDS[name];
  if (!c) bad(`unknown command '${name}'`);
  const a = { cmd: name };
  const opts = c.opts || {};
  for (const [f, o] of Object.entries(opts)) a[keyOf(f, o)] = o.bool ? false : o.many || o.list ? [] : o.def ?? null;
  const pos = [];
  for (let i = 0; i < rest.length; i++) {
    const arg = rest[i];
    if ((c.pos || []).at(-1)?.endsWith("...") && pos.length === c.pos.length - 1) {
      a.extra = rest.slice(i); // the rest goes to the program untouched, flags included
      break;
    }
    if (arg === "-h" || arg === "--help") return out(help(name, c)), null;
    if (!arg.startsWith("--") || arg === "--") {
      pos.push(arg);
      continue;
    }
    let [flag, val] = arg.includes("=") ? [arg.slice(0, arg.indexOf("=")), arg.slice(arg.indexOf("=") + 1)] : [arg, undefined];
    const o = opts[flag];
    if (!o) bad(`unrecognized argument ${flag}`, name, c);
    const k = keyOf(flag, o);
    if (o.bool) {
      a[k] = true;
      continue;
    }
    if (o.list) {
      if (val !== undefined) a[k].push(val);
      while (i + 1 < rest.length && !rest[i + 1].startsWith("--")) a[k].push(rest[++i]);
      if (!a[k].length) bad(`${flag} expects at least one value`, name, c);
      continue;
    }
    if (val === undefined) {
      if (i + 1 >= rest.length) bad(`${flag} expects a value`, name, c);
      val = rest[++i];
    }
    if (o.choices && !o.choices.includes(val)) bad(`${flag}: '${val}' is not one of ${o.choices.join(", ")}`, name, c);
    if (o.many) a[k].push(val);
    else a[k] = val;
  }
  const spec = c.pos || [];
  for (const [n, p] of spec.entries()) {
    const key = p.replace(/[?.]+$/, "");
    if (p.endsWith("...")) a[key] ??= [];
    else if (n < pos.length) a[key] = pos[n];
    else if (p.endsWith("?")) a[key] = null;
    else bad(`missing ${key}`, name, c);
  }
  if (pos.length > spec.filter((p) => !p.endsWith("...")).length) bad(`unexpected argument ${pos.at(-1)}`, name, c);
  for (const [f, o] of Object.entries(opts)) if (o.required && a[keyOf(f, o)] == null) bad(`${f} is required`, name, c);
  return a;
}

async function main() {
  try {
    const a = parse(process.argv.slice(2));
    if (a && COMMANDS[a.cmd].home !== false && !HOME)
      throw new Fail("no fleet here: run `fleet init` in your work root (the folder your repos sit under) to make one", 2);
    if (a) await COMMANDS[a.cmd].fn(a);
  } catch (e) {
    if (!(e instanceof Fail)) throw e;
    log(`fleet: ${e.message}`);
    process.exit(e.code);
  }
}

main();
