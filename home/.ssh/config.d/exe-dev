# exe.dev VMs declared in the private iac repo (infra/exe-dev), reached over the tailnet:
#   ssh exe-dev-<name>
# Tailscale SSH authenticates by tailnet identity (no SSH key), and the host key
# comes from the tailnet, so a rebuilt VM needs no setup here.
# <name>.exe.xyz goes through exe.dev instead and keeps exe.dev's own host key.
Host exe-dev-* !*.exe.xyz
  User exedev
  PubkeyAuthentication no
  StrictHostKeyChecking yes
  UserKnownHostsFile /dev/null
  GlobalKnownHostsFile /dev/null
  # ssh needs an absolute path here and does not expand %d or ~ in it, so go through sh for $HOME.
  KnownHostsCommand /bin/sh -c "exec \"$HOME/.local/bin/tailnet-ssh-known-hosts\" \"$0\"" %H
