# Example of config.env, this machine's fleet settings. `fleet init` asks for each
# value and writes config.env beside this file; `fleet config <NAME> <value>` changes one.

# the folder your repos live under (one folder per company or group)
FLEET_WORK_ROOT=~/work
# the Claude Code config folder agents start with (CLAUDE_CONFIG_DIR); "default" leaves it
# unset, so Claude uses ~/.claude and ~/.claude.json
FLEET_CLAUDE_CONFIG_DIR=default
