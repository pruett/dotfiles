#!/usr/bin/env bash
set -euo pipefail

script_path="$(realpath "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script_path")/../../.." && pwd)"
managed_home="$repo_root/home"
real_home="$HOME"
npm_cache="${npm_config_cache:-$real_home/.npm}"

run_skills_cli() {
  # The skills CLI stores its global lock at $XDG_STATE_HOME/skills/.skill-lock.json
  # when that variable is set. Clear it so the lock resolves to
  # $managed_home/.agents/.skill-lock.json and stays tracked in this repo.
  npm_config_cache="$npm_cache" HOME="$managed_home" \
    command env -u XDG_STATE_HOME npx --yes skills "$@"
}

# The upstream CLI auto-detects Pi from $managed_home/.pi/agent and links updated
# skills into .pi/agent/skills. Pi already discovers ~/.agents/skills directly,
# so drop those redundant links to keep them out of the repo.
prune_pi_links() {
  local pi_dir="$managed_home/.pi/agent/skills" link
  [[ -d "$pi_dir" ]] || return 0
  for link in "$pi_dir"/*; do
    [[ -L "$link" ]] || continue
    case "$(readlink "$link")" in
      */.agents/skills/*) rm "$link" ;;
    esac
  done
  rmdir "$pi_dir" 2>/dev/null || true
}

list_skills() {
  local skill_file name description found=false

  for skill_file in "$managed_home/.agents/skills"/*/SKILL.md; do
    [[ -f "$skill_file" ]] || continue
    found=true
    name="$(basename "$(dirname "$skill_file")")"
    description="$(awk '
      function clean(value) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) {
          value = substr(value, 2, length(value) - 2)
        }
        return value
      }
      NR == 1 && $0 == "---" { frontmatter = 1; next }
      frontmatter && collecting && /^[[:space:]]+/ {
        line = clean($0)
        description = description (description ? " " : "") line
        next
      }
      frontmatter && collecting { collecting = 0; print description; exit }
      frontmatter && $0 == "---" { exit }
      frontmatter && /^description:[[:space:]]*/ {
        sub(/^description:[[:space:]]*/, "")
        if ($0 ~ /^[>|][-+]?[[:space:]]*$/) {
          collecting = 1
          next
        }
        print clean($0)
        exit
      }
      END { if (collecting) print description }
    ' "$skill_file")"

    description="${description//$'\n'/ }"
    if [[ ${#description} -gt 80 ]]; then
      description="${description:0:77}..."
    elif [[ -z "$description" ]]; then
      description="(no description)"
    fi
    printf '%-24s %s\n' "$name" "$description"
  done

  if [[ "$found" == false ]]; then
    printf 'No skills installed.\n'
  fi
}

# Plugins under .plugins/<plugin>/skills own their skill files so each plugin
# is self-contained when cloned on its own. Link them back into
# home/.agents/skills so every agent sees them like any other skill.
link_plugin_skills() {
  local agents_dir="$managed_home/.agents/skills"
  local source plugin name link expected current

  mkdir -p "$agents_dir"

  for source in "$repo_root"/.plugins/*/skills/*; do
    [[ -d "$source" && ! -L "$source" ]] || continue
    name="${source##*/}"
    plugin="${source%/skills/*}"
    plugin="${plugin##*/}"
    link="$agents_dir/$name"
    expected="../../../.plugins/$plugin/skills/$name"

    if [[ -L "$link" ]]; then
      current="$(readlink "$link")"
      [[ "$current" == "$expected" ]] && continue
      printf 'Updating %s -> %s\n' "$link" "$expected"
      ln -sfn "$expected" "$link"
    elif [[ -e "$link" ]]; then
      printf 'Refusing to replace non-symlink: %s (also in .plugins/%s)\n' "$link" "$plugin" >&2
      return 1
    else
      printf 'Linking %s -> %s\n' "$link" "$expected"
      ln -s "$expected" "$link"
    fi
  done

  # Remove links into .plugins whose skill was deleted or moved.
  for link in "$agents_dir"/*; do
    [[ -L "$link" && ! -e "$link" ]] || continue
    case "$(readlink "$link")" in
      ../../../.plugins/*)
        printf 'Removing stale link %s\n' "$link"
        rm "$link"
        ;;
    esac
  done
}

sync_agent() {
  local agent="$1"
  local target_dir

  case "$agent" in
    claude|claude-code)
      agent="claude-code"
      target_dir="$real_home/.claude/skills"
      ;;
    claude-work|work)
      agent="claude-work"
      target_dir="$real_home/.claude-work/skills"
      ;;
    *)
      printf 'Unknown agent: %s (expected claude-code or claude-work; Codex and Pi read ~/.agents/skills directly)\n' "$agent" >&2
      return 2
      ;;
  esac

  mkdir -p "$target_dir"

  local source name link expected current
  for source in "$managed_home/.agents/skills"/*; do
    [[ -d "$source" ]] || continue
    name="${source##*/}"
    link="$target_dir/$name"
    expected="../../.agents/skills/$name"

    if [[ -L "$link" ]]; then
      current="$(readlink "$link")"
      if [[ "$current" == "$expected" ]]; then
        continue
      fi
      printf 'Updating %s -> %s\n' "$link" "$expected"
      ln -sfn "$expected" "$link"
    elif [[ -e "$link" ]]; then
      printf 'Refusing to replace non-symlink: %s\n' "$link" >&2
      return 1
    else
      printf 'Linking %s -> %s\n' "$link" "$expected"
      ln -s "$expected" "$link"
    fi
  done

  # Remove links created by this command when their central skill is gone.
  for link in "$target_dir"/*; do
    [[ -L "$link" ]] || continue
    name="${link##*/}"
    current="$(readlink "$link")"
    if [[ "$current" == "../../.agents/skills/$name" && ! -e "$managed_home/.agents/skills/$name" ]]; then
      printf 'Removing stale link %s\n' "$link"
      rm "$link"
    fi
  done

  printf 'Synced skills for %s.\n' "$agent"
}

usage() {
  cat <<'EOF'
Usage: skills <command> [arguments]

Commands:
  add <source> [options] Add skills from a path, URL, or GitHub repository
  list, ls               List centrally managed global skills
  update [skills...]     Update all skills, or only the named skills
  sync <agent> [...]     Link skills for claude-code or claude-work
  help                   Show this help
EOF
}

case "${1:-help}" in
  help|-h|--help) ;;
  *) link_plugin_skills ;;
esac

case "${1:-help}" in
  add)
    shift
    if [[ $# -eq 0 ]]; then
      printf 'Usage: skills add <source> [options]\n' >&2
      exit 2
    fi
    run_skills_cli add "$@" --global --agent zed --yes
    prune_pi_links
    ;;
  list|ls)
    shift
    if [[ $# -ne 0 ]]; then
      printf 'Usage: skills list\n' >&2
      exit 2
    fi
    list_skills
    ;;
  update|upgrade)
    shift
    run_skills_cli update --global --yes "$@"
    prune_pi_links
    ;;
  sync)
    shift
    if [[ $# -eq 0 ]]; then
      printf 'Usage: skills sync <claude-code|claude-work> [...]\n' >&2
      exit 2
    fi
    for agent in "$@"; do
      sync_agent "$agent"
    done
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
