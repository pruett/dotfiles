#!/usr/bin/env bash
set -euo pipefail

script_path="$(realpath "${BASH_SOURCE[0]}")"
repo_root="$(cd "$(dirname "$script_path")/../../.." && pwd)"
managed_home="$repo_root/home"
real_home="$HOME"
npm_cache="${npm_config_cache:-$real_home/.npm}"

run_skills_cli() {
  # The skills CLI stores its global lock at $XDG_STATE_HOME/skills/.skill-lock.json
  # when that variable is set. Clear it so the lock resolves to
  # $managed_home/.agents/.skill-lock.json and stays tracked in this repo.
  npm_config_cache="$npm_cache" HOME="$managed_home" \
    command env -u XDG_STATE_HOME npx --yes skills "$@"
}

# The upstream CLI auto-detects Pi and Claude Code under $managed_home and links
# updated skills into .pi/agent/skills and .claude/skills inside this repo. Pi
# reads ~/.agents/skills directly and `skills sync` owns ~/.claude/skills, so
# drop those links to keep them out of the repo.
prune_agent_links() {
  local dir link
  for dir in "$managed_home/.pi/agent/skills" "$managed_home/.claude/skills"; do
    [[ -d "$dir" && ! -L "$dir" ]] || continue
    for link in "$dir"/*; do
      [[ -L "$link" ]] || continue
      case "$(readlink "$link")" in
        */.agents/skills/*) rm "$link" ;;
      esac
    done
    rmdir "$dir" 2>/dev/null || true
  done
}

# pstack skills come from the Claude Code copy in cursor/plugins. The skills CLI
# installs only skill folders, so after add or update copy the rest of what
# they expect from the commit in the lockfile:
#   - docs/harness/claude-code.md, which the skills link to as ../../docs/...
#     and Claude reads at run time to map Cursor names to Claude Code.
#   - agents/*.md into ~/.claude/agents, so `poteto-agent` exists.
# The plugin install prefixes names with `pstack:`; this install does not, so
# drop that prefix. Agent `model:` lines hold Cursor slugs; map them to a
# Claude Code alias. Changes to claude-code.md are printed for review, since a
# new kind of setup step there is not applied here.
pstack_path="harness/pstack/claude-code"

sync_pstack() {
  local lock="$managed_home/.agents/.skill-lock.json"
  local commit url src up doc new name file missing=()

  commit="$(jq -r --arg p "$pstack_path/skills/" '
    [.skills[] | select(.skillPath | startswith($p))] | max_by(.updatedAt) | .commit // empty
  ' "$lock")"
  [[ -n "$commit" ]] || return 0
  url="$(jq -r --arg c "$commit" '[.skills[] | select(.commit == $c)][0].sourceUrl' "$lock")"

  src="$(mktemp -d)"
  trap 'rm -rf "$src"' RETURN
  git -C "$src" init -q
  git -C "$src" remote add origin "$url"
  git -C "$src" sparse-checkout set "$pstack_path"
  git -C "$src" fetch -q --depth 1 --filter=blob:none origin "$commit"
  git -C "$src" checkout -q FETCH_HEAD
  up="$src/$pstack_path"

  doc="$managed_home/.agents/docs/harness/claude-code.md"
  new="$src/claude-code.md"
  {
    printf '<!-- Copied by `skills` from %s/blob/%s/%s/docs/harness/claude-code.md, with the `pstack:` prefix dropped. pstack skills link here as ../../docs/harness/claude-code.md; ~/.claude/docs links to this folder so that path resolves. -->\n\n' \
      "${url%.git}" "$commit" "$pstack_path"
    sed -E 's/pstack:([<a-z])/\1/g' "$up/docs/harness/claude-code.md"
  } >"$new"
  mkdir -p "$(dirname "$doc")"
  if [[ ! -f "$doc" ]] || ! diff -q <(tail -n +3 "$doc") <(tail -n +3 "$new") >/dev/null; then
    printf 'pstack claude-code.md changed. Review for setup steps this command does not apply:\n'
    diff -u --label old --label new <(tail -n +3 "$doc" 2>/dev/null) <(tail -n +3 "$new") || true
  fi
  cp "$new" "$doc"

  mkdir -p "$managed_home/.claude/agents"
  for file in "$up"/agents/*.md; do
    sed -E \
      -e 's/^model: claude-([a-z]+)-.*/model: \1/' \
      -e '/^model: (opus|sonnet|haiku|fable|inherit)$/b' \
      -e 's/^model: .*/model: inherit/' \
      -e 's#~/\.cursor/plugins/#~/.agents/skills/#g' \
      -e 's/pstack:([<a-z])/\1/g' \
      "$file" >"$managed_home/.claude/agents/${file##*/}"
  done
  if [[ ! -e "$real_home/.claude/agents" ]]; then
    printf 'Run `dot link` so ~/.claude/agents picks up the pstack agents.\n'
  fi

  for file in "$up"/skills/*; do
    name="${file##*/}"
    [[ -e "$managed_home/.agents/skills/$name" ]] || missing+=("$name")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'pstack skills upstream but not installed: %s\n' "${missing[*]}"
    printf 'Add with: skills add %s/tree/main/%s --skill %s\n' "${url%.git}" "$pstack_path" "${missing[*]}"
  fi
}

list_skills() {
  local skill_file name description found=false

  for skill_file in "$managed_home/.agents/skills"/*/SKILL.md; do
    [[ -f "$skill_file" ]] || continue
    found=true
    name="$(basename "$(dirname "$skill_file")")"
    description="$(awk '
      function clean(value) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        if (value ~ /^".*"$/ || value ~ /^\047.*\047$/) {
          value = substr(value, 2, length(value) - 2)
        }
        return value
      }
      NR == 1 && $0 == "---" { frontmatter = 1; next }
      frontmatter && collecting && /^[[:space:]]+/ {
        line = clean($0)
        description = description (description ? " " : "") line
        next
      }
      frontmatter && collecting { collecting = 0; print description; exit }
      frontmatter && $0 == "---" { exit }
      frontmatter && /^description:[[:space:]]*/ {
        sub(/^description:[[:space:]]*/, "")
        if ($0 ~ /^[>|][-+]?[[:space:]]*$/) {
          collecting = 1
          next
        }
        print clean($0)
        exit
      }
      END { if (collecting) print description }
    ' "$skill_file")"

    description="${description//$'\n'/ }"
    if [[ ${#description} -gt 80 ]]; then
      description="${description:0:77}..."
    elif [[ -z "$description" ]]; then
      description="(no description)"
    fi
    printf '%-24s %s\n' "$name" "$description"
  done

  if [[ "$found" == false ]]; then
    printf 'No skills installed.\n'
  fi
}

# Plugins under .plugins/<plugin>/skills own their skill files so each plugin
# is self-contained when cloned on its own. Link them back into
# home/.agents/skills so every agent sees them like any other skill.
link_plugin_skills() {
  local agents_dir="$managed_home/.agents/skills"
  local source plugin name link expected current

  mkdir -p "$agents_dir"

  for source in "$repo_root"/.plugins/*/skills/*; do
    [[ -d "$source" && ! -L "$source" ]] || continue
    name="${source##*/}"
    plugin="${source%/skills/*}"
    plugin="${plugin##*/}"
    link="$agents_dir/$name"
    expected="../../../.plugins/$plugin/skills/$name"

    if [[ -L "$link" ]]; then
      current="$(readlink "$link")"
      [[ "$current" == "$expected" ]] && continue
      printf 'Updating %s -> %s\n' "$link" "$expected"
      ln -sfn "$expected" "$link"
    elif [[ -e "$link" ]]; then
      printf 'Refusing to replace non-symlink: %s (also in .plugins/%s)\n' "$link" "$plugin" >&2
      return 1
    else
      printf 'Linking %s -> %s\n' "$link" "$expected"
      ln -s "$expected" "$link"
    fi
  done

  # Remove links into .plugins whose skill was deleted or moved.
  for link in "$agents_dir"/*; do
    [[ -L "$link" && ! -e "$link" ]] || continue
    case "$(readlink "$link")" in
      ../../../.plugins/*)
        printf 'Removing stale link %s\n' "$link"
        rm "$link"
        ;;
    esac
  done
}

# Codex and Pi read ~/.agents/skills directly; only Claude Code needs links.
sync_claude() {
  local target_dir="$real_home/.claude/skills"

  mkdir -p "$target_dir"

  local source name link expected current
  for source in "$managed_home/.agents/skills"/*; do
    [[ -d "$source" ]] || continue
    name="${source##*/}"
    link="$target_dir/$name"
    expected="../../.agents/skills/$name"

    if [[ -L "$link" ]]; then
      current="$(readlink "$link")"
      if [[ "$current" == "$expected" ]]; then
        continue
      fi
      printf 'Updating %s -> %s\n' "$link" "$expected"
      ln -sfn "$expected" "$link"
    elif [[ -e "$link" ]]; then
      printf 'Refusing to replace non-symlink: %s\n' "$link" >&2
      return 1
    else
      printf 'Linking %s -> %s\n' "$link" "$expected"
      ln -s "$expected" "$link"
    fi
  done

  # Remove links created by this command when their central skill is gone.
  for link in "$target_dir"/*; do
    [[ -L "$link" ]] || continue
    name="${link##*/}"
    current="$(readlink "$link")"
    if [[ "$current" == "../../.agents/skills/$name" && ! -e "$managed_home/.agents/skills/$name" ]]; then
      printf 'Removing stale link %s\n' "$link"
      rm "$link"
    fi
  done

  printf 'Synced skills for Claude Code.\n'
}

usage() {
  cat <<'EOF'
Usage: skills <command> [arguments]

Commands:
  add <source> [options] Add skills from a path, URL, or GitHub repository
  list, ls               List centrally managed global skills
  update [skills...]     Update all skills, or only the named skills
  sync                   Link every skill into ~/.claude/skills
  help                   Show this help
EOF
}

case "${1:-help}" in
  help|-h|--help) ;;
  *) link_plugin_skills ;;
esac

case "${1:-help}" in
  add)
    shift
    if [[ $# -eq 0 ]]; then
      printf 'Usage: skills add <source> [options]\n' >&2
      exit 2
    fi
    run_skills_cli add "$@" --global --agent zed --yes
    prune_agent_links
    sync_pstack
    ;;
  list|ls)
    shift
    if [[ $# -ne 0 ]]; then
      printf 'Usage: skills list\n' >&2
      exit 2
    fi
    list_skills
    ;;
  update|upgrade)
    shift
    run_skills_cli update --global --yes "$@"
    prune_agent_links
    sync_pstack
    ;;
  sync)
    shift
    if [[ $# -ne 0 ]]; then
      printf 'Usage: skills sync\n' >&2
      exit 2
    fi
    sync_claude
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac
