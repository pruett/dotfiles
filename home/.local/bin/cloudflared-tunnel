#!/usr/bin/env bash
#
# cloudflared-tunnel — manage this machine's Cloudflare Tunnel connector.
#
# Config lives in ~/.config/cloudflared (dotfiles home/.config/cloudflared):
#   tunnel.conf                      tunnel id, expected ingress, system paths
#   com.cloudflare.cloudflared.plist LaunchDaemon definition
#   token.local                      connector token (gitignored, chmod 600)
#
# Usage: cloudflared-tunnel <status|install|restart|logs|export-token|uninstall> [--dry-run]

set -euo pipefail

info()    { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
success() { printf '\033[1;32m ok\033[0m %s\n' "$*"; }
warn()    { printf '\033[1;33m !!\033[0m %s\n' "$*"; }
fail()    { printf '\033[1;31mERR\033[0m %s\n' "$*" >&2; exit 1; }

[[ "$(uname -s)" == "Darwin" ]] || fail "This script only supports macOS."

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cloudflared"
CONF="$CONF_DIR/tunnel.conf"
PLIST_SRC="$CONF_DIR/com.cloudflare.cloudflared.plist"
TOKEN_LOCAL="$CONF_DIR/token.local"

[[ -f "$CONF" ]] || fail "Missing $CONF (is the dotfiles 'home' package stowed?)"
# shellcheck source=/dev/null
source "$CONF"

DRY_RUN=false
cmd="${1:-status}"; shift || true
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=true ;;
    *) fail "Unknown option: $arg" ;;
  esac
done

# Run a privileged command, or print it under --dry-run.
run_sudo() {
  if $DRY_RUN; then printf '  sudo'; printf ' %q' "$@"; echo; return 0; fi
  sudo "$@"
}

# ------------------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------------------

daemon_pid() { pgrep -f "cloudflared tunnel run" 2>/dev/null | head -1 || true; }

metrics_addr() {
  [[ -r "$LOG_ERR" ]] || return 1
  grep -o 'Starting metrics server on [0-9.:]*' "$LOG_ERR" | tail -1 | awk '{print $NF}'
}

# Latest ingress JSON pushed by the dashboard, as logged by the connector.
live_ingress_json() {
  [[ -r "$LOG_ERR" ]] || return 1
  grep 'Updated to new configuration' "$LOG_ERR" | tail -1 \
    | sed -n 's/.*config="\(.*\)" version=.*/\1/p' | sed 's/\\"/"/g'
}

resolve_token() {
  if [[ -n "${CLOUDFLARE_TUNNEL_TOKEN:-}" ]]; then
    printf '%s' "$CLOUDFLARE_TUNNEL_TOKEN"
  elif [[ -f "$TOKEN_LOCAL" ]]; then
    tr -d '[:space:]' < "$TOKEN_LOCAL"
  else
    return 1
  fi
}

http_code() { curl -sk -m "${2:-10}" -o /dev/null -w '%{http_code}' "$1" 2>/dev/null || echo 000; }

# ------------------------------------------------------------------------------
# Subcommands
# ------------------------------------------------------------------------------

cmd_status() {
  local rc=0
  info "Tunnel ${TUNNEL_NAME} (${TUNNEL_ID})"

  # Service
  if [[ -f "$LAUNCHD_PLIST" ]]; then success "LaunchDaemon installed: $LAUNCHD_PLIST"
  else warn "LaunchDaemon not installed (run: cloudflared-tunnel install)"; rc=1; fi
  # cloudflared's own installer omits the trailing newline; compare content only.
  if [[ -f "$LAUNCHD_PLIST" ]] && ! diff -q <(awk 1 "$PLIST_SRC") <(awk 1 "$LAUNCHD_PLIST") >/dev/null 2>&1; then
    warn "Installed plist differs from $PLIST_SRC (run install to sync)"
  fi
  local pid; pid="$(daemon_pid)"
  if [[ -n "$pid" ]]; then success "cloudflared running (pid $pid, $(cloudflared --version 2>/dev/null | awk '{print $3}'))"
  else warn "cloudflared is not running"; rc=1; fi

  # Edge connections
  local addr ready
  if addr="$(metrics_addr)" && [[ -n "$addr" ]]; then
    if ready="$(curl -s -m 3 "http://$addr/ready" 2>/dev/null)"; then
      local n; n="$(sed -n 's/.*"readyConnections":\([0-9]*\).*/\1/p' <<<"$ready")"
      if [[ "${n:-0}" -ge 1 ]]; then success "Edge connections: ${n}/4 (metrics http://$addr/metrics)"
      else warn "No edge connections ready: $ready"; rc=1; fi
      local errs; errs="$(curl -s -m 3 "http://$addr/metrics" 2>/dev/null | awk '/^cloudflared_tunnel_request_errors /{print $2}')"
      [[ -n "${errs:-}" && "$errs" != "0" ]] && warn "Request errors since start: $errs"
    else warn "Metrics endpoint $addr not answering"; rc=1; fi
  else warn "Metrics address not found in $LOG_ERR"; fi

  # Live ingress vs tunnel.conf
  local live; live="$(live_ingress_json || true)"
  if [[ -n "$live" ]]; then
    info "Live ingress (from dashboard):"
    grep -o '{"hostname":"[^"]*", *"service":"[^"]*"' <<<"$live" \
      | sed 's/{"hostname":"\([^"]*\)", *"service":"\([^"]*\)"/  \1 -> \2/'
    local live_count conf_count
    live_count="$(grep -o '"hostname"' <<<"$live" | wc -l | tr -d ' ')"
    conf_count="${#INGRESS[@]}"
    [[ "$live_count" == "$conf_count" ]] || warn "Dashboard has $live_count hostname(s), tunnel.conf lists $conf_count — update INGRESS"
  else
    warn "No ingress config seen in log yet"
  fi

  # Probes
  info "Probing ingress from tunnel.conf:"
  local entry host origin oc pc
  for entry in "${INGRESS[@]}"; do
    host="${entry%%=*}"; origin="${entry#*=}"
    if [[ -n "$live" ]] && ! grep -q "\"hostname\":\"$host\"" <<<"$live"; then
      warn "$host is in tunnel.conf but not in the live dashboard config"
    fi
    oc="$(http_code "$origin" 5)"
    pc="$(http_code "https://$host" 15)"
    printf '  %-28s origin %-22s %s   public %s\n' "$host" "$origin" "$oc" "$pc"
    case "$oc" in 2*|3*|401|403) ;; *) warn "origin $origin not answering — start the dev server"; rc=1 ;; esac
    case "$pc" in
      2*|3*|401|403) ;;
      530|502|503) warn "https://$host -> $pc (tunnel up, origin unreachable from connector)"; rc=1 ;;
      000) warn "https://$host unreachable (DNS/network?)"; rc=1 ;;
      *) warn "https://$host -> $pc"; rc=1 ;;
    esac
  done

  # Recent trouble
  if [[ -r "$LOG_ERR" ]]; then
    local recent; recent="$(grep -cE ' (ERR|WRN) ' "$LOG_ERR" || true)"
    [[ "${recent:-0}" -gt 0 ]] && info "$recent WRN/ERR lines in $LOG_ERR (cloudflared-tunnel logs)"
  fi
  return $rc
}

cmd_install() {
  command -v cloudflared >/dev/null || fail "cloudflared not installed (brew bundle)"
  local token
  token="$(resolve_token)" || fail "No token. Put it in $TOKEN_LOCAL (chmod 600) or export CLOUDFLARE_TUNNEL_TOKEN. See $CONF_DIR/README.md."
  [[ ${#token} -gt 50 ]] || fail "Token looks too short — copy the full connector token from the dashboard."

  local tmp; tmp="$(mktemp)"; printf '%s' "$token" > "$tmp"; chmod 600 "$tmp"
  info "Installing LaunchDaemon $LAUNCHD_LABEL (sudo)"
  run_sudo mkdir -p "$(dirname "$SYSTEM_TOKEN")"
  run_sudo install -m 600 -o root -g wheel "$tmp" "$SYSTEM_TOKEN"
  run_sudo install -m 644 -o root -g wheel "$PLIST_SRC" "$LAUNCHD_PLIST"
  rm -f "$tmp"
  # bootout is a no-op error if not loaded; ignore it so re-runs are idempotent.
  run_sudo launchctl bootout "system/$LAUNCHD_LABEL" 2>/dev/null || true
  run_sudo launchctl bootstrap system "$LAUNCHD_PLIST"
  run_sudo launchctl kickstart -k "system/$LAUNCHD_LABEL"
  $DRY_RUN && return 0
  success "Installed. Waiting for edge connections..."
  sleep 4
  cmd_status
}

cmd_restart() {
  info "Restarting $LAUNCHD_LABEL (sudo)"
  run_sudo launchctl kickstart -k "system/$LAUNCHD_LABEL"
  $DRY_RUN || { sleep 4; cmd_status; }
}

cmd_uninstall() {
  info "Removing LaunchDaemon $LAUNCHD_LABEL (sudo)"
  run_sudo launchctl bootout "system/$LAUNCHD_LABEL" 2>/dev/null || true
  run_sudo rm -f "$LAUNCHD_PLIST" "$SYSTEM_TOKEN"
  $DRY_RUN || success "Removed. Logs left in /Library/Logs. Dashboard tunnel untouched."
}

cmd_export_token() {
  [[ -f "$SYSTEM_TOKEN" ]] || { sudo test -f "$SYSTEM_TOKEN" 2>/dev/null; } || fail "No installed token at $SYSTEM_TOKEN"
  info "Copying installed token to $TOKEN_LOCAL (sudo)"
  if $DRY_RUN; then echo "  sudo cat $SYSTEM_TOKEN > $TOKEN_LOCAL"; return 0; fi
  ( umask 077; sudo cat "$SYSTEM_TOKEN" > "$TOKEN_LOCAL" )
  chmod 600 "$TOKEN_LOCAL"
  success "Wrote $TOKEN_LOCAL ($(wc -c < "$TOKEN_LOCAL" | tr -d ' ') bytes, gitignored)"
}

cmd_logs() { tail -n 40 -f "$LOG_ERR"; }

case "$cmd" in
  status)        cmd_status ;;
  install)       cmd_install ;;
  restart)       cmd_restart ;;
  uninstall)     cmd_uninstall ;;
  export-token)  cmd_export_token ;;
  logs)          cmd_logs ;;
  -h|--help|help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) fail "Unknown command: $cmd (status|install|restart|logs|export-token|uninstall)" ;;
esac
