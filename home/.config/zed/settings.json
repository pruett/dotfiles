    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "show_wrap_guides": true,
  "gutter": {
    "breakpoints": true
  },
  "disable_ai": false,
