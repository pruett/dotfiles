# verify-suppco: optional dotenv fallback, read only for variables the shell does not export.
# On this machine the real values live in ~/.config/zsh/extras/.zshrc.local.zsh. `verify-suppco doctor` checks them.
VERIFY_SUPPCO_ROOT=~/work/suppco          # directory holding backend/ and web/
#VERIFY_SUPPCO_STATE=              # state dir; default $VERIFY_SUPPCO_ROOT/.verify-suppco
VERIFY_SUPPCO_EMAIL=                  # account to act as; *test@monsterinbox.com logs in headlessly
VERIFY_SUPPCO_CODE=                   # its fixed login code; empty = headed login
VERIFY_SUPPCO_OAUTH_SECRET_PROD=          # for `up --api prod`
VERIFY_SUPPCO_OAUTH_SECRET_STAGING=       # for `up --api staging`
#VERIFY_SUPPCO_OAUTH_SECRET=              # for `--api <url>`
#VERIFY_SUPPCO_AUTH_SECRET=                      # local web Auth.js secret; random per `up` when unset
# internal: VERIFY_SUPPCO_ENV (this file's path), VERIFY_SUPPCO_CWD, NODE_EXTRA_CA_CERTS (set by bin/verify-suppco)
