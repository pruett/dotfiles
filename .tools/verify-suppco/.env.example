# verify-suppco: optional dotenv fallback, read only for variables the shell does not export.
# On this machine the real values live in ~/.config/zsh/extras/.zshrc.local.zsh. `verify-suppco doctor` checks them.
SUPPCO_ROOT=~/work/suppco          # directory holding backend/ and web/
#VERIFY_SUPPCO_STATE=              # state dir; default $SUPPCO_ROOT/.verify-suppco
PLAYWRIGHT_EMAIL=                  # account to act as; *test@monsterinbox.com logs in headlessly
PLAYWRIGHT_CODE=                   # its fixed login code; empty = headed login
OAUTH_CLIENT_SECRET_PROD=          # for `up --api prod`
OAUTH_CLIENT_SECRET_STAGING=       # for `up --api staging`
#OAUTH_CLIENT_SECRET=              # for `--api <url>`
#AUTH_SECRET=                      # local web Auth.js secret; random per `up` when unset
# internal: VERIFY_SUPPCO_ENV (this file's path), VERIFY_SUPPCO_CWD, NODE_EXTRA_CA_CERTS (set by bin/verify-suppco)
